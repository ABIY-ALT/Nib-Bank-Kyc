# NIB Bank KYC - environment template
#
# Copy to .env and fill in the REQUIRED section:
#   cp .env.example .env
#
# The app refuses to start if a REQUIRED value is missing or invalid (see
# src/lib/env-validation.ts). Everything else is commented out and shows its
# default. Uncomment a line only to change it: some settings behave differently
# when set to an empty value than when left unset.

# ==============================================================================
# REQUIRED
# ==============================================================================

# PostgreSQL connection string. Must start with postgresql:// (postgres:// is
# rejected). URL-encode special characters in the password, e.g. $ becomes %24.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/nib_kyc?schema=public

# Signs session tokens. At least 64 characters. Generate with:
#   openssl rand -base64 48
JWT_SECRET=

# Public URL of this app, used for links in emails. `npm run dev` serves on port
# 3000 and `npm start` on port 4000.
APP_BASE_URL=http://localhost:3000

# CORS preflight cache in seconds. Has no default in the startup validator, so
# it must be present even though CORS itself is off until ALLOWED_ORIGINS is set.
CORS_MAX_AGE=7200

# ==============================================================================
# APPLICATION
# ==============================================================================

# Next.js sets this from the command (dev or build/start), so leave it unset
# unless you have a reason. Accepted: development, staging, production.
# NODE_ENV=development

# Accepted by the validator: debug, info, warn, error.
# LOG_LEVEL=info

# Used to build the Content-Security-Policy domain.
# NEXT_PUBLIC_APP_URL=https://kyc.example.com
# NEXT_PUBLIC_STAGING_URL=https://kyc-staging.example.com

# ==============================================================================
# SECURITY AND CORS
# ==============================================================================

# Comma-separated origins allowed to call the API.
# ALLOWED_ORIGINS=http://localhost:3000

# Response headers exposed to cross-origin callers.
# CORS_EXPOSED_HEADERS=Content-Type,Authorization

# Must stay false: the app will not start if this is true.
# CREDENTIAL_SHARING=false

# Log CORS decisions. Keep off in production.
# ENABLE_CORS_LOGGING=false

# Case-sensitive: Strict, Lax or None. Startup checks flag anything other than
# Strict in production.
# SECURE_COOKIE_SAME_SITE=Strict

# Force Secure cookies outside production, e.g. HTTPS dev or staging. Always on
# in production.
# COOKIE_SECURE=false

# Comma-separated IPs or CIDR ranges allowed to run sensitive operations.
# Unset means any authenticated IP is allowed.
# SENSITIVE_OPERATIONS_IP_WHITELIST=10.0.0.5,192.168.1.0/24

# Block file transfers when SMB signing is not confirmed secure.
# ENFORCE_SMB_SIGNING=false

# Shared secret for scheduled calls to /api/admin/retention/purge and
# /api/admin/archive/auto, sent as x-cron-secret or a Bearer token.
# Unset means those routes accept admin sessions only.
# CRON_SECRET=

# ==============================================================================
# EMAIL (SMTP)
# ==============================================================================

# Email is disabled when no host is set.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# true for implicit TLS (usually port 465), false for STARTTLS (usually port 587).
# SMTP_SECURE=false
# Set to false only for internal servers with self-signed certificates.
# SMTP_TLS_REJECT_UNAUTHORIZED=true
# EMAIL_FROM_ADDRESS=noreply@nibbank.com.et
# EMAIL_FROM_NAME=NIB Bank KYC

# Legacy names, read only when the matching SMTP_* or EMAIL_FROM_ADDRESS value
# is unset. Prefer the names above for new deployments.
# EMAIL_HOST=
# EMAIL_PORT=
# EMAIL_USER=
# EMAIL_PASS=
# EMAIL_SECURE=
# EMAIL_ALLOW_SELF_SIGNED=
# EMAIL_FROM=

# ==============================================================================
# FILE STORAGE
# ==============================================================================

# Absolute path for uploaded documents. Set this on servers: the default is a
# secure_uploads folder beside the working directory, so it changes with how the
# app is started. Forward slashes also work on Windows.
# UPLOAD_DIR_PATH=D:/nib_kyc/secure_uploads

# Folder name used when UPLOAD_DIR_PATH is unset.
# UPLOAD_DIR=secure_uploads

# Archive (cold) tier. Defaults to a folder beside the upload root.
# ARCHIVE_DIR_PATH=E:/nib_kyc_archive

# ==============================================================================
# AUTOMATIC STORAGE CLEANUP - PERMANENTLY DELETES DOCUMENT FILES
# ==============================================================================
# In production this runs by default: documents older than 6 days are deleted
# unless the case is APPROVED. The policy is managed in Settings > Automatic
# Storage Cleanup; the *_ENABLED, *_DAYS, *_DRY_RUN and *_KEEP_STATUSES values
# below override that screen.

# Set to false to stop the timer. Outside production, set to true to start it.
# AUTO_PURGE_SCHEDULER=true
# Emergency off switch, or use dry-run to report without deleting.
# AUTO_PURGE_ENABLED=true
# AUTO_PURGE_DRY_RUN=false
# AUTO_PURGE_DAYS=6
# Do not leave this blank: an empty value protects no status, APPROVED included.
# AUTO_PURGE_KEEP_STATUSES=APPROVED
# Minimum 5.
# AUTO_PURGE_INTERVAL_MINUTES=60
# Minimum 5. Gap between runs while a backlog drains.
# AUTO_PURGE_CATCHUP_SECONDS=30
# Minimum 10, maximum 5000.
# AUTO_PURGE_MAX_CASES=250
# Minimum 5. Time budget for one run.
# AUTO_PURGE_MAX_SECONDS=20

# ==============================================================================
# AUTOMATIC ARCHIVING - MOVES DOCUMENTS TO THE ARCHIVE TIER
# ==============================================================================
# Off until switched on in Settings or with AUTO_ARCHIVE_ENABLED. The *_ENABLED,
# *_DAYS and *_DRY_RUN values below override the Settings screen.

# Set to false to stop the timer. Outside production, set to true to start it.
# AUTO_ARCHIVE_SCHEDULER=true
# AUTO_ARCHIVE_ENABLED=false
# AUTO_ARCHIVE_DRY_RUN=false
# Minimum 1, maximum 3650.
# AUTO_ARCHIVE_DAYS=7
# Minimum 5.
# AUTO_ARCHIVE_INTERVAL_MINUTES=360

# ==============================================================================
# AWS SECRETS MANAGER (OPTIONAL)
# ==============================================================================
# Read only in production when SECRET_NAME is set. DATABASE_URL and JWT_SECRET
# above are still required, because startup validation reads the environment.

# SECRET_NAME=
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ==============================================================================
# ONE-OFF SCRIPTS AND TESTS
# ==============================================================================

# Initial admin password. Required by `npx prisma db seed`; remove it afterwards.
# ADMIN_PASSWORD=

# New password for scripts/reset-admin-password.ts. Always set this when running
# that script: without it, the script falls back to a password stored in the code.
# ADMIN_RESET_PASSWORD=

# Target IP used by src/lib/session-manager.test.ts.
# TEST_TARGET_IP=10.0.0.1
