
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }
    
    function isFollowUp() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Follow-up Team';
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    match /submissions/{submissionId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      
      match /documents/{docId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && !isFollowUp();
      }
    }

    match /follow_up_verifications/{verifyId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (isFollowUp() || isAdmin());
    }

    match /branches/{branchId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /districts/{distId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /roleDefinitions/{roleId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /kyc_findings/{findingId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
