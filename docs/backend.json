
{
  "entities": {
    "KYCSubmission": {
      "title": "KYC Submission",
      "description": "A customer identity verification request.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "branch": { "type": "string" },
        "district": { "type": "string" },
        "submittedBy": { "type": "string" },
        "submittedAt": { "type": "string", "format": "date-time" },
        "status": { 
          "type": "string", 
          "enum": ["Pending", "In Review", "Amended", "Approved", "Escalated", "Rejected"] 
        },
        "isExceptional": { "type": "boolean" },
        "exceptionalStatus": {
          "type": "string",
          "enum": ["None", "Awaiting District", "Awaiting Director", "Awaiting Supervisor", "Completed", "Rejected", "Clarification Required", "Awaiting Chief", "Awaiting Division"]
        },
        "exceptionalData": {
          "type": "object",
          "properties": {
            "reason": { "type": "string" },
            "justification": { "type": "string" },
            "memoUrl": { "type": "string" },
            "initiatedBy": { "type": "string" },
            "initiatedAt": { "type": "string" },
            "approvalHistory": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "role": { "type": "string" },
                  "action": { "type": "string" },
                  "performedBy": { "type": "string" },
                  "timestamp": { "type": "string" },
                  "remarks": { "type": "string" },
                  "memoAttached": { "type": "boolean" }
                }
              }
            }
          }
        },
        "remarks": { "type": "string" },
        "entityType": { "type": "string" },
        "amendmentCycles": { "type": "integer" },
        "isResubmitted": { "type": "boolean" },
        "checklistState": { "type": "object" }
      },
      "required": ["customerName", "branch", "status", "submittedBy"]
    },
    "FollowUpVerification": {
      "title": "Follow-up Verification",
      "description": "Head Office audit record for an approved KYC case.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "submissionId": { "type": "string" },
        "customerName": { "type": "string" },
        "branch": { "type": "string" },
        "officer": { "type": "string" },
        "accountType": { "type": "string" },
        "verifiedBy": { "type": "string" },
        "verifiedAt": { "type": "string", "format": "date-time" },
        "result": { "type": "string", "enum": ["Correct", "Discrepancy"] },
        "remarks": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Completed"] }
      }
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "System user profile with role and organizational mapping.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { 
          "type": "string", 
          "enum": ["Branch Officer", "KYC Officer", "Supervisor", "Director", "Admin", "Branch Manager", "District Director", "Division Manager", "Chief Retail & SME Banking Officer", "Follow-up Team", "Chief"] 
        },
        "branch": { "type": "string" },
        "district": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/submissions/{submissionId}": {
      "schema": "#/entities/KYCSubmission",
      "description": "Top-level collection of all KYC submissions."
    },
    "/follow_up_verifications/{verifyId}": {
      "schema": "#/entities/FollowUpVerification",
      "description": "Head Office audit records."
    },
    "/users/{userId}": {
      "schema": "#/entities/UserProfile",
      "description": "System user profiles and permissions."
    }
  }
}
