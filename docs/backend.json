
{
  "entities": {
    "KYCSubmission": {
      "title": "KYC Submission",
      "description": "A customer identity verification request.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "branch": { "type": "string" },
        "district": { "type": "string" },
        "submittedBy": { "type": "string" },
        "submittedAt": { "type": "string", "format": "date-time" },
        "status": { 
          "type": "string", 
          "enum": ["Pending", "In Review", "Amended", "Approved", "Escalated", "Rejected"] 
        },
        "isExceptional": { "type": "boolean" },
        "exceptionalStatus": {
          "type": "string",
          "enum": ["None", "Awaiting District", "Awaiting Director", "Awaiting Chief", "Awaiting Division", "Awaiting Supervisor", "Completed", "Rejected", "Clarification Required"]
        },
        "exceptionalData": {
          "type": "object",
          "properties": {
            "reason": { "type": "string" },
            "justification": { "type": "string" },
            "memoUrl": { "type": "string" },
            "initiatedBy": { "type": "string" },
            "initiatedAt": { "type": "string" },
            "approvalHistory": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "role": { "type": "string" },
                  "action": { "type": "string" },
                  "performedBy": { "type": "string" },
                  "timestamp": { "type": "string" },
                  "remarks": { "type": "string" },
                  "memoAttached": { "type": "boolean" }
                }
              }
            }
          }
        },
        "commentHistory": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": { "type": "string" },
              "performedBy": { "type": "string" },
              "timestamp": { "type": "string" },
              "comment": { "type": "string" },
              "action": { "type": "string" }
            }
          }
        },
        "remarks": { "type": "string" },
        "entityType": { "type": "string" },
        "amendmentCycles": { "type": "integer" },
        "isResubmitted": { "type": "boolean" },
        "checklistState": { "type": "object" }
      },
      "required": ["customerName", "branch", "status", "submittedBy"]
    },
    "BundleDownload": {
      "title": "Bundle Download Log",
      "description": "Audit record of a case bundle export.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "performedBy": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "bundleName": { "type": "string" },
        "sourceDistrict": { "type": "string" },
        "sourceBranch": { "type": "string" }
      }
    },
    "FollowUpVerification": {
      "title": "Follow-up Verification",
      "description": "Head Office audit record for an approved KYC case.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "submissionId": { "type": "string" },
        "customerName": { "type": "string" },
        "branch": { "type": "string" },
        "officer": { "type": "string" },
        "accountType": { "type": "string" },
        "verifiedBy": { "type": "string" },
        "verifiedAt": { "type": "string", "format": "date-time" },
        "result": { "type": "string", "enum": ["Correct", "Discrepancy"] },
        "remarks": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Completed"] }
      }
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "System user profile with role and organizational mapping.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { 
          "type": "string", 
          "enum": ["Branch Officer", "KYC Officer", "Supervisor", "Branch Banking Director", "Admin", "Branch Manager", "District Director", "Division Manager", "Chief Retail & SME Banking Officer", "Follow-up Team", "Chief"] 
        },
        "branch": { "type": "string" },
        "district": { "type": "string" },
        "status": { "type": "string", "enum": ["Active", "Inactive", "Suspended"] },
        "needsPasswordChange": { "type": "boolean" }
      }
    },
    "AuditLog": {
      "title": "Audit Log",
      "description": "System security and activity log.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "action": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "ipAddress": { "type": "string" },
        "details": { "type": "string" }
      }
    },
    "Branch": {
      "title": "Branch Office",
      "description": "An institutional branch node.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "district": { "type": "string" },
        "code": { "type": "string" }
      }
    },
    "District": {
      "title": "Regional District",
      "description": "A geographical administrative hub.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/submissions/{submissionId}": {
      "schema": "#/entities/KYCSubmission",
      "description": "Top-level collection of all KYC submissions."
    },
    "/submissions/{submissionId}/bundle_downloads/{logId}": {
      "schema": "#/entities/BundleDownload",
      "description": "Logs of when case bundles were downloaded."
    },
    "/follow_up_verifications/{verifyId}": {
      "schema": "#/entities/FollowUpVerification",
      "description": "Head Office audit records."
    },
    "/users/{userId}": {
      "schema": "#/entities/UserProfile",
      "description": "System user profiles and permissions."
    },
    "/audit_logs/{logId}": {
      "schema": "#/entities/AuditLog",
      "description": "System-wide security audit logs."
    },
    "/branches/{branchId}": {
      "schema": "#/entities/Branch",
      "description": "Directory of all bank branches."
    },
    "/districts/{distId}": {
      "schema": "#/entities/District",
      "description": "Directory of regional districts."
    }
  }
}
