
{
  "entities": {
    "KYCSubmission": {
      "title": "KYC Submission",
      "description": "A customer identity verification request.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "branch": { "type": "string" },
        "district": { "type": "string" },
        "submittedBy": { "type": "string" },
        "submittedAt": { "type": "string", "format": "date-time" },
        "status": { 
          "type": "string", 
          "enum": ["Pending", "In Review", "Amended", "Approved", "Escalated", "Rejected"] 
        },
        "remarks": { "type": "string" },
        "entityType": { 
          "type": "string",
          "enum": ["individual", "corporate", "sme", "ngo"]
        },
        "amendmentCycles": { "type": "integer", "description": "Count of times the case was sent back for amendments." }
      },
      "required": ["customerName", "branch", "status", "submittedBy"]
    },
    "Document": {
      "title": "Document",
      "description": "A document associated with a KYC submission.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "url": { "type": "string" },
        "uploadedAt": { "type": "string", "format": "date-time" }
      }
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "System user profile with role and organizational mapping.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { 
          "type": "string", 
          "enum": ["Branch Officer", "KYC Officer", "Supervisor", "Director", "Admin", "Branch Manager", "District Director"] 
        },
        "branch": { "type": "string" },
        "district": { "type": "string" },
        "status": { "type": "string", "enum": ["Active", "Inactive"] }
      }
    },
    "Branch": {
      "title": "Branch",
      "description": "A physical bank branch location.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "district": { "type": "string" },
        "code": { "type": "string" }
      },
      "required": ["name", "district"]
    },
    "District": {
      "title": "District",
      "description": "A regional banking district.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["name"]
    },
    "SystemSettings": {
      "title": "System Settings",
      "description": "Global configuration for the Nib Kyc system.",
      "type": "object",
      "properties": {
        "autoEscalation": { "type": "boolean" },
        "strictSla": { "type": "boolean" },
        "lastUpdated": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" },
        "documentTypes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/submissions/{submissionId}": {
      "schema": "#/entities/KYCSubmission",
      "description": "Top-level collection of all KYC submissions."
    },
    "/submissions/{submissionId}/documents/{documentId}": {
      "schema": "#/entities/Document",
      "description": "Documents uploaded for a specific submission."
    },
    "/users/{userId}": {
      "schema": "#/entities/UserProfile",
      "description": "System user profiles and permissions."
    },
    "/branches/{branchId}": {
      "schema": "#/entities/Branch",
      "description": "Institutional branch directory."
    },
    "/districts/{districtId}": {
      "schema": "#/entities/District",
      "description": "Regional district directory."
    },
    "/settings/{settingId}": {
      "schema": "#/entities/SystemSettings",
      "description": "Global system configurations."
    }
  }
}
