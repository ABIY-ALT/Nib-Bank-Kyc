
{
  "entities": {
    "KYCSubmission": {
      "title": "KYC Submission",
      "description": "A customer identity verification request.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "branch": { "type": "string" },
        "district": { "type": "string" },
        "submittedBy": { "type": "string" },
        "submittedAt": { "type": "string", "format": "date-time" },
        "status": { 
          "type": "string", 
          "enum": ["Pending", "In Review", "Amended", "Approved", "Escalated", "Rejected"] 
        },
        "isExceptional": { "type": "boolean" },
        "exceptionalStatus": {
          "type": "string",
          "enum": ["None", "Awaiting District", "Awaiting Director", "Awaiting Supervisor", "Completed", "Rejected", "Clarification Required"]
        },
        "exceptionalData": {
          "type": "object",
          "properties": {
            "reason": { "type": "string" },
            "justification": { "type": "string" },
            "memoUrl": { "type": "string" },
            "initiatedBy": { "type": "string" },
            "initiatedAt": { "type": "string" },
            "approvalHistory": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "role": { "type": "string" },
                  "action": { "type": "string" },
                  "performedBy": { "type": "string" },
                  "timestamp": { "type": "string" },
                  "remarks": { "type": "string" }
                }
              }
            }
          }
        },
        "remarks": { "type": "string" },
        "entityType": { "type": "string" },
        "amendmentCycles": { "type": "integer" },
        "isResubmitted": { "type": "boolean" },
        "checklistState": { "type": "object" }
      },
      "required": ["customerName", "branch", "status", "submittedBy"]
    },
    "KYCFinding": {
      "title": "KYC Finding",
      "description": "Standardized KYC comment or query for reference.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { 
          "type": "string", 
          "enum": ["Identity", "Documentation", "Compliance", "Account Validation"] 
        },
        "severity": { 
          "type": "string", 
          "enum": ["Low", "Medium", "High", "Critical"] 
        },
        "applicableTo": { 
          "type": "array", 
          "items": { "type": "string" } 
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "active": { "type": "boolean" },
        "source": { "type": "string", "enum": ["manual", "auto"] }
      },
      "required": ["code", "title", "category", "severity"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "System user profile with role and organizational mapping.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { 
          "type": "string", 
          "enum": ["Branch Officer", "KYC Officer", "Supervisor", "Director", "Admin", "Branch Manager", "District Director"] 
        },
        "branch": { "type": "string" },
        "district": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/submissions/{submissionId}": {
      "schema": "#/entities/KYCSubmission",
      "description": "Top-level collection of all KYC submissions."
    },
    "/users/{userId}": {
      "schema": "#/entities/UserProfile",
      "description": "System user profiles and permissions."
    },
    "/kyc_findings/{findingId}": {
      "schema": "#/entities/KYCFinding",
      "description": "Knowledge base of standardized findings and queries."
    }
  }
}
