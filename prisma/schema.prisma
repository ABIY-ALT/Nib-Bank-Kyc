
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String     @id @default(uuid())
  email               String     @unique
  password            String
  firstName           String
  lastName            String
  phoneNumber         String?
  status              UserStatus @default(ACTIVE)
  branchId            String?
  branchName          String?    // Denormalized for fast filtering
  districtName        String?    // Denormalized for fast filtering
  assignedBranches    String?    @db.Text // Comma-separated for specialists
  needsPasswordChange Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  branch              Branch?    @relation(fields: [branchId], references: [id])
  roles               UserRole[]
  submissions         KYC[]      @relation("CreatedBy")
  assignments         KYC[]      @relation("AssignedTo")
  memos               Memo[]     @relation("UploadedBy")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id        String           @id @default(uuid())
  slug      String           @unique
  name      String
  group     String
  roles     RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model District {
  id        String   @id @default(uuid())
  name      String   @unique
  branches  Branch[]
  createdAt DateTime @default(now())
}

model Branch {
  id         String   @id @default(uuid())
  name       String   @unique
  code       String?  @unique
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  users      User[]
  kyc        KYC[]
}

model KYC {
  id                String   @id // Formatted ID: BRANCH-KYC-XXXX
  customerName      String
  entityType        String
  status            String   // Using string for absolute cross-layer compatibility
  branchId          String
  branchName        String
  isExceptional     Boolean  @default(false)
  exceptionalStatus String   @default("None")
  remarks           String?  @db.Text
  checklistState    String?  @db.Text // JSON blob
  commentHistory    String?  @db.Text // JSON blob
  isResubmitted     Boolean  @default(false)
  amendCycles       Int      @default(0)
  active            Boolean  @default(true)
  createdById       String
  assignedToId      String?
  submittedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt

  branch            Branch   @relation(fields: [branchId], references: [id])
  createdBy         User     @relation("CreatedBy", fields: [createdById], references: [id])
  assignedTo        User?    @relation("AssignedTo", fields: [assignedToId], references: [id])
  memos             Memo[]
}

model Memo {
  id           String   @id @default(uuid())
  kycId        String
  name         String
  type         String   // IDENTITY, GOVERNANCE_MEMO, etc.
  fileUrl      String
  uploadedById String
  createdAt    DateTime @default(now())

  kyc          KYC      @relation(fields: [kycId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation("UploadedBy", fields: [uploadedById], references: [id])
}

model GlobalSetting {
  id              String   @id @default("global")
  entityTypes     Json     // [{id, label}]
  documentTypes   Json     // [{id, label}]
  guidelines      Json     // [{id, title, desc, type}]
  autoEscalation  Boolean  @default(true)
  escalationHours Int      @default(72)
  lastUpdated     DateTime @updatedAt
}

model FollowUpVerification {
  id           String   @id @default(uuid())
  submissionId String
  customerName String
  branch       String
  officer      String
  accountType  String
  verifiedBy   String?
  verifiedAt   DateTime @default(now())
  result       String?  // Correct, Discrepancy
  remarks      String?  @db.Text
  status       String   @default("PENDING") // PENDING, COMPLETED
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  userEmail String
  userName  String?
  kycId     String?
  action    String
  details   String   @db.Text
  ipAddress String?
  timestamp DateTime @default(now())
}
