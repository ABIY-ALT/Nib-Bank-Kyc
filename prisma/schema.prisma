// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BRANCH_OFFICER
  KYC_OFFICER
  SUPERVISOR
  BRANCH_BANKING_DIRECTOR
  ADMIN
  BRANCH_MANAGER
  DISTRICT_DIRECTOR
  DIVISION_MANAGER
  CHIEF_RETAIL_SME_OFFICER
  FOLLOW_UP_TEAM
  CHIEF
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SubmissionStatus {
  PENDING
  IN_REVIEW
  AMENDED
  APPROVED
  ESCALATED
  REJECTED
}

enum ExceptionalStatus {
  NONE
  AWAITING_DISTRICT
  AWAITING_DIRECTOR
  AWAITING_CHIEF
  AWAITING_DIVISION
  AWAITING_SUPERVISOR
  COMPLETED
  REJECTED
  CLARIFICATION_REQUIRED
}

enum FindingCategory {
  IDENTITY
  DOCUMENTATION
  COMPLIANCE
  ACCOUNT_VALIDATION
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id                  String       @id
  email               String       @unique
  name                String
  role                UserRole     @default(BRANCH_OFFICER)
  status              UserStatus   @default(ACTIVE)
  branchName          String?
  districtName        String?
  assignedBranches    String[]     @default([])
  needsPasswordChange Boolean      @default(false)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  submissionsSubmitted Submission[] @relation("SubmittedBy")
  submissionsReviewed  Submission[] @relation("ReviewedBy")
}

model District {
  id        String   @id @default(cuid())
  name      String   @unique
  branches  Branch[]
}

model Branch {
  id           String   @id @default(cuid())
  name         String   @unique
  code         String?  @unique
  districtName String
  district     District @relation(fields: [districtName], references: [name])
}

model Submission {
  id                String            @id
  customerName      String
  entityType        String
  branchName        String
  districtName      String
  status            SubmissionStatus  @default(PENDING)
  isExceptional     Boolean           @default(false)
  exceptionalStatus ExceptionalStatus @default(NONE)
  exceptionalData   Json?             // Stores justification, history, etc.
  checklistState    Json?             @default("{}")
  commentHistory    Json?             @default("[]")
  remarks           String?
  isResubmitted     Boolean           @default(false)
  amendmentCycles   Int               @default(0)
  submittedAt       DateTime          @default(now())
  reviewedAt        DateTime?
  
  submittedById     String
  submittedBy       User              @relation("SubmittedBy", fields: [submittedById], references: [id])
  reviewedById      String?
  reviewedBy        User?             @relation("ReviewedBy", fields: [reviewedById], references: [id])

  documents         Document[]
  bundleDownloads   BundleDownload[]
}

model Document {
  id           String     @id @default(cuid())
  name         String
  type         String
  url          String
  status       String     @default("Current")
  uploadedAt   DateTime   @default(now())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model BundleDownload {
  id             String     @id @default(cuid())
  performedBy    String
  timestamp      DateTime   @default(now())
  bundleName     String
  sourceDistrict String
  sourceBranch   String
  submissionId   String
  submission     Submission @relation(fields: [submissionId], references: [id])
}

model FollowUpVerification {
  id           String   @id
  submissionId String   @unique
  customerName String
  branch       String
  officer      String
  accountType  String
  verifiedBy   String?
  verifiedAt   DateTime @default(now())
  result       String?  // "Correct" | "Discrepancy"
  remarks      String?
  status       String   @default("PENDING") // "PENDING" | "COMPLETED"
}

model Finding {
  id           String          @id @default(cuid())
  code         String          @unique
  title        String
  description  String
  category     FindingCategory
  severity     FindingSeverity
  applicableTo String[]
  createdAt    DateTime        @default(now())
  active       Boolean         @default(true)
  source       String          @default("manual")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  userEmail String
  userName  String?
  action    String
  timestamp DateTime @default(now())
  ipAddress String
  details   String
}

model GlobalSetting {
  id              String   @id @default("global")
  autoEscalation  Boolean  @default(true)
  escalationHours Int      @default(72)
  strictSla       Boolean  @default(true)
  slaHours        Int      @default(24)
  documentTypes   Json?    @default("[]")
  entityTypes     Json?    @default("[]")
  guidelines      Json?    @default("[]")
  lastUpdated     DateTime @default(now())
  updatedBy       String?
}
