
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Institutional Roles are now managed via RoleDefinition table strings
// but these are the standard baseline values for logic reference.
enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SubmissionStatus {
  PENDING
  IN_REVIEW
  AMENDED
  APPROVED
  ESCALATED
  REJECTED
}

enum ExceptionalStatus {
  NONE
  AWAITING_DISTRICT
  AWAITING_DIRECTOR
  AWAITING_CHIEF
  AWAITING_DIVISION
  AWAITING_SUPERVISOR
  COMPLETED
  REJECTED
  CLARIFICATION_REQUIRED
}

enum FindingCategory {
  IDENTITY
  DOCUMENTATION
  COMPLIANCE
  ACCOUNT_VALIDATION
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id               String       @id
  email            String       @unique
  name             String
  phoneNumber      String?
  role             String       @default("BRANCH_OFFICER")
  status           UserStatus   @default(ACTIVE)
  branchName       String?
  districtName     String?
  assignedBranches String[]     @default([]) // For KYC Officers covering multiple nodes
  needsPasswordChange Boolean   @default(false)
  
  submissions      Submission[] @relation("SubmittedBy")
  reviews          Submission[] @relation("ReviewedBy")
}

model RoleDefinition {
  id                   String   @id @default(cuid())
  name                 String   @unique // The role identifier (e.g. "KYC_OFFICER")
  canSubmit            Boolean  @default(false)
  canReview            Boolean  @default(false)
  canEscalate          Boolean  @default(false)
  canViewReports       Boolean  @default(false)
  canManageUsers       Boolean  @default(false)
  canManageSystem      Boolean  @default(false)
  canAccessPerformance Boolean  @default(false)
  canAccessFollowUp    Boolean  @default(false)
  canAccessArchive     Boolean  @default(false)
}

model Submission {
  id                String           @id
  customerId        String?
  customerName      String
  entityType        String?
  branchName        String
  districtName      String
  status            SubmissionStatus @default(PENDING)
  submittedAt       DateTime         @default(now())
  submittedById     String
  submittedBy       User             @relation("SubmittedBy", fields: [submittedById], references: [id])
  
  reviewedAt        DateTime?
  reviewedById      String?
  reviewedBy        User?            @relation("ReviewedBy", fields: [reviewedById], references: [id])
  
  isExceptional     Boolean          @default(false)
  exceptionalStatus ExceptionalStatus @default(NONE)
  exceptionalData   Json?            // Reason, justification, approvalHistory
  
  commentHistory    Json?            // Array of role, name, time, comment, action
  remarks           String?          @db.Text
  checklistState    Json?            // Record of document verifications
  
  isResubmitted     Boolean          @default(false)
  amendmentCycles   Int              @default(0)
  
  documents         Document[]
  bundleDownloads   BundleDownload[]
}

model Document {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  name         String
  type         String     // National ID, Trade License, etc.
  url          String     // Relative path in /uploads
  status       String     @default("Current") // Current, Replaced
  uploadedAt   DateTime   @default(now())
}

model BundleDownload {
  id             String     @id @default(cuid())
  submissionId   String
  submission     Submission @relation(fields: [submissionId], references: [id])
  performedBy    String
  timestamp      DateTime   @default(now())
  bundleName     String
  sourceDistrict String
  sourceBranch   String
}

model FollowUpVerification {
  id           String   @id @default(cuid())
  submissionId String   @unique
  customerName String
  branch       String
  officer      String
  accountType  String
  verifiedBy   String?
  verifiedAt   DateTime?
  result       String?  // Correct, Discrepancy
  remarks      String?  @db.Text
  status       String   @default("PENDING") // PENDING, COMPLETED
}

model District {
  id       String   @id @default(cuid())
  name     String   @unique
  branches Branch[]
}

model Branch {
  id           String   @id @default(cuid())
  name         String   @unique
  code         String?
  districtName String
  district     District @relation(fields: [districtName], references: [name])
}

model Finding {
  id           String          @id @default(cuid())
  code         String          @unique
  title        String
  description  String          @db.Text
  category     FindingCategory
  severity     FindingSeverity
  applicableTo String[]        // List of account types
  active       Boolean         @default(true)
  source       String          @default("manual") // manual, ai
  createdAt    DateTime        @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  userEmail String
  userName  String?
  action    String
  details   String   @db.Text
  ipAddress String
  timestamp DateTime @default(now())
}

model GlobalSetting {
  id               String   @id @default("global")
  autoEscalation   Boolean  @default(true)
  escalationHours  Int      @default(72)
  strictSla        Boolean  @default(true)
  slaHours         Int      @default(24)
  documentTypes    Json?    // Array of {id, label}
  entityTypes      Json?    // Array of {id, label}
  guidelines       Json?    // Array of {id, title, description, type}
  lastUpdated      DateTime @default(now())
  updatedBy        String?
}
