
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  password            String
  firstName           String
  lastName            String
  phoneNumber         String?    @unique
  status              UserStatus @default(ACTIVE)
  branchId            String?
  branchName          String?
  districtName        String?
  assignedBranches    String?    // CSV of branch names
  needsPasswordChange Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  // Relations
  roles               UserRole[]
  submissions         KYC[]      @relation("CreatedBy")
  assignedCases       KYC[]      @relation("AssignedTo")
  uploadedMemos       Memo[]
  branch              Branch?    @relation(fields: [branchId], references: [id])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id        String           @id @default(cuid())
  slug      String           @unique
  name      String
  group     String
  roles     RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model District {
  id        String   @id @default(cuid())
  name      String   @unique
  branches  Branch[]
  createdAt DateTime @default(now())
}

model Branch {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String?  @unique
  districtId  String
  district    District @relation(fields: [districtId], references: [id])
  submissions KYC[]
  users       User[]
  createdAt   DateTime @default(now())
}

model KYC {
  id                String   @id
  customerName      String
  branchId          String
  branch            Branch   @relation(fields: [branchId], references: [id])
  branchName        String
  districtName      String
  createdById       String
  createdBy         User     @relation("CreatedBy", fields: [createdById], references: [id])
  assignedToId      String?
  assignedTo        User?    @relation("AssignedTo", fields: [assignedToId], references: [id])
  status            String
  isExceptional     Boolean  @default(false)
  exceptionalStatus String   @default("None")
  entityType        String?
  remarks           String?
  isResubmitted     Boolean  @default(false)
  amendCycles       Int      @default(0)
  checklistState    Json?    @default("{}")
  commentHistory    Json?    @default("[]")
  active            Boolean  @default(true)
  submittedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt
  memos             Memo[]
}

model Memo {
  id           String   @id @default(cuid())
  name         String
  type         String
  fileUrl      String
  kycId        String
  kyc          KYC      @relation(fields: [kycId], references: [id])
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

model GlobalSetting {
  id               String   @id @default("global")
  entityTypes      Json
  documentTypes    Json
  guidelines       Json
  autoEscalation   Boolean  @default(true)
  escalationHours  Int      @default(72)
  lastUpdated      DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String
  userName  String?
  action    String
  details   String
  ipAddress String
  timestamp DateTime @default(now())
  kycId     String?
}

model Finding {
  id           String   @id @default(cuid())
  code         String   @unique
  title        String
  description  String
  category     String
  severity     String
  applicableTo String[] // Account types
  active       Boolean  @default(true)
  source       String   @default("manual")
  createdAt    DateTime @default(now())
}

model FollowUpVerification {
  id           String   @id @default(cuid())
  submissionId String
  customerName String
  branch       String
  officer      String
  accountType  String
  verifiedBy   String?
  verifiedAt   DateTime @default(now())
  result       String?
  remarks      String?
  status       String   @default("PENDING")
}
