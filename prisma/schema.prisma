generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum KYCStatus {
  SUBMITTED
  IN_REVIEW
  ACTION_REQUIRED
  APPROVED
  REJECTED
  ESCALATED
}

enum AuditAction {
  CREATE
  UPDATE
  STATUS_CHANGE
  DELETE
  LOGIN
  LOGOUT
  BRANCH_TRANSFER
  ROLE_TRANSITION
  BUNDLE_DOWNLOAD
}

enum FindingCategory {
  IDENTITY
  DOCUMENTATION
  COMPLIANCE
  ACCOUNT_VALIDATION
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id                  String     @id @default(uuid())
  email               String     @unique
  password            String
  firstName           String
  lastName            String
  phoneNumber         String?
  status              UserStatus @default(ACTIVE)
  needsPasswordChange Boolean    @default(true)
  assignedBranches    String[]   @default([])
  
  branchId            String?
  branch              Branch?    @relation(fields: [branchId], references: [id])
  
  roles               UserRole[]
  createdKYCs         KYC[]      @relation("CreatedBy")
  assignedKYCs        KYC[]      @relation("AssignedTo")
  memos               Memo[]
  auditLogs           AuditLog[]
  
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  active      Boolean          @default(true)
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id    String           @id @default(uuid())
  slug  String           @unique
  name  String
  group String
  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model District {
  id       String   @id @default(uuid())
  name     String   @unique
  branches Branch[]
}

model Branch {
  id         String   @id @default(uuid())
  name       String   @unique
  code       String?  @unique
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  users      User[]
  kycs       KYC[]
}

model KYC {
  id                String      @id
  customerName      String
  status            KYCStatus   @default(SUBMITTED)
  entityType        String?
  branchName        String?
  active            Boolean     @default(true)
  isResubmitted     Boolean     @default(false)
  amendCycles       Int         @default(0)
  checklistState    Json?
  
  isExceptional     Boolean     @default(false)
  exceptionalStatus String      @default("None")
  
  commentHistory    Json?       @default("[]")
  
  createdById       String
  createdBy         User        @relation("CreatedBy", fields: [createdById], references: [id])
  
  assignedToId      String?
  assignedTo        User?       @relation("AssignedTo", fields: [assignedToId], references: [id])
  
  branchId          String
  branch            Branch      @relation(fields: [branchId], references: [id])
  
  memos             Memo[]
  auditLogs         AuditLog[]
  
  submittedAt       DateTime    @default(now())
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model Memo {
  id           String   @id @default(uuid())
  name         String?
  type         String?
  fileUrl      String
  kycId        String
  kyc          KYC      @relation(fields: [kycId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

model Finding {
  id           String          @id @default(uuid())
  code         String          @unique
  title        String
  description  String
  category     FindingCategory
  severity     FindingSeverity
  applicableTo String[]
  active       Boolean         @default(true)
  source       String          @default("manual")
  createdAt    DateTime        @default(now())
}

model FollowUpVerification {
  id           String   @id @default(uuid())
  submissionId String
  customerName String
  branch       String
  officer      String
  accountType  String
  verifiedBy   String?
  verifiedAt   DateTime @default(now())
  result       String?
  remarks      String?
  status       String   @default("PENDING")
}

model GlobalSetting {
  id              String   @id @default("global")
  autoEscalation  Boolean  @default(true)
  escalationHours Int      @default(72)
  strictSla       Boolean  @default(true)
  slaHours        Int      @default(24)
  documentTypes   Json?    @default("[]")
  entityTypes     Json?    @default("[]")
  guidelines      Json?    @default("[]")
  lastUpdated     DateTime @default(now())
}

model AuditLog {
  id        String      @id @default(uuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id])
  userEmail String?
  userName  String?
  kycId     String?
  kyc       KYC?        @relation(fields: [kycId], references: [id])
  action    String
  details   String
  ipAddress String?
  metadata  Json?
  timestamp DateTime    @default(now())
}
