generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum FindingCategory {
  IDENTITY
  DOCUMENTATION
  COMPLIANCE
  ACCOUNT_VALIDATION
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id                  String       @id @default(uuid())
  email               String       @unique
  password            String
  firstName           String
  lastName            String
  phoneNumber         String?
  status              UserStatus   @default(ACTIVE)
  branchId            String?
  branch              Branch?      @relation(fields: [branchId], references: [id])
  branchName          String?
  districtName        String?
  assignedBranches    String?      
  needsPasswordChange Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  roles               UserRole[]
  submissionsCreated  KYC[]        @relation("CreatedBy")
  submissionsAssigned KYC[]        @relation("AssignedTo")
  memos               Memo[]
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id        String           @id @default(uuid())
  slug      String           @unique
  name      String
  group     String
  roles     RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model District {
  id        String   @id @default(uuid())
  name      String   @unique
  branches  Branch[]
}

model Branch {
  id         String   @id @default(uuid())
  name       String   @unique
  code       String?  @unique
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  users      User[]
  kyc        KYC[]
}

model KYC {
  id                String    @id
  customerName      String
  branchId          String
  branch            Branch    @relation(fields: [branchId], references: [id])
  branchName        String
  districtName      String
  createdById       String
  createdBy         User      @relation("CreatedBy", fields: [createdById], references: [id])
  assignedToId      String?
  assignedTo        User?     @relation("AssignedTo", fields: [assignedToId], references: [id])
  status            String
  entityType        String?
  remarks           String?
  isResubmitted     Boolean   @default(false)
  isExceptional     Boolean   @default(false)
  exceptionalStatus String    @default("None")
  amendCycles       Int       @default(0)
  checklistState    Json?
  commentHistory    Json?
  active            Boolean   @default(true)
  submittedAt       DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  memos             Memo[]
}

model Memo {
  id           String   @id @default(uuid())
  name         String
  type         String
  fileUrl      String
  kycId        String
  kyc          KYC      @relation(fields: [kycId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  userEmail String?
  userName  String?
  action    String
  details   String
  ipAddress String?
  kycId     String?
  timestamp DateTime @default(now())
}

model FollowUpVerification {
  id           String   @id @default(uuid())
  submissionId String
  customerName String
  branch       String
  officer      String
  accountType  String
  verifiedBy   String?
  verifiedAt   DateTime @default(now())
  result       String?
  remarks      String?
  status       String   @default("PENDING")
}

model GlobalSetting {
  id              String   @id @default("global")
  entityTypes     Json?
  documentTypes   Json?
  guidelines      Json?
  autoEscalation  Boolean  @default(true)
  escalationHours Int      @default(72)
  lastUpdated     DateTime @default(now())
}

model Finding {
  id           String          @id @default(uuid())
  code         String          @unique
  title        String
  description  String
  category     FindingCategory
  severity     FindingSeverity
  applicableTo String[]        
  active       Boolean         @default(true)
  source       String          @default("manual")
}