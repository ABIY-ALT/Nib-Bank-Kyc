generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  password            String
  firstName           String
  lastName            String
  phoneNumber         String?
  status              UserStatus @default(ACTIVE)
  branchId            String?
  branchName          String?
  districtName        String?
  assignedBranches    String?    // CSV format for portfolio
  needsPasswordChange Boolean    @default(false)
  
  roles               UserRole[]
  createdSubmissions  KYC[]      @relation("CreatedBy")
  assignedSubmissions KYC[]      @relation("AssignedTo")
  memos               Memo[]
  
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  active      Boolean          @default(true)
  permissions RolePermission[]
  users       UserRole[]
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id    String           @id @default(cuid())
  slug  String           @unique
  name  String
  group String
  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])
  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  @@id([roleId, permissionId])
}

model District {
  id       String   @id @default(cuid())
  name     String   @unique
  branches Branch[]
}

model Branch {
  id         String   @id @default(cuid())
  name       String   @unique
  code       String?  @unique
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  submissions KYC[]
  users      User[]
}

model KYC {
  id                String   @id
  customerName      String
  entityType        String
  branchId          String
  branchName        String
  districtName      String
  createdById       String
  assignedToId      String?
  status            String   @default("SUBMITTED")
  isExceptional     Boolean  @default(false)
  exceptionalStatus String   @default("None")
  remarks           String?
  checklistState    Json?
  commentHistory    Json?
  isResubmitted     Boolean  @default(false)
  amendCycles       Int      @default(0)
  active            Boolean  @default(true)
  
  branch            Branch   @relation(fields: [branchId], references: [id])
  createdBy         User     @relation("CreatedBy", fields: [createdById], references: [id])
  assignedTo        User?    @relation("AssignedTo", fields: [assignedToId], references: [id])
  memos             Memo[]
  
  submittedAt       DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Memo {
  id           String   @id @default(cuid())
  name         String
  type         String
  fileUrl      String
  uploadedById String
  kycId        String
  
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  kyc          KYC      @relation(fields: [kycId], references: [id], onDelete: Cascade)
  
  createdAt    DateTime @default(now())
}

enum FindingCategory {
  IDENTITY
  DOCUMENTATION
  COMPLIANCE
  ACCOUNT_VALIDATION
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Finding {
  id           String          @id @default(cuid())
  code         String          @unique
  title        String
  description  String
  category     FindingCategory
  severity     FindingSeverity
  applicableTo String[]        // String array for account types
  active       Boolean         @default(true)
  source       String          @default("manual")
  createdAt    DateTime        @default(now())
}

model GlobalSetting {
  id               String   @id @default("global")
  entityTypes      Json?
  documentTypes    Json?
  guidelines       Json?
  autoEscalation   Boolean  @default(true)
  escalationHours  Int      @default(72)
  lastUpdated      DateTime @default(now())
}

model FollowUpVerification {
  id           String   @id @default(cuid())
  submissionId String
  customerName String
  branch       String
  officer      String
  accountType  String
  verifiedBy   String?
  verifiedAt   DateTime @default(now())
  result       String?  // 'Correct' or 'Discrepancy'
  remarks      String?
  status       String   @default("PENDING")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String
  userName  String?
  action    String
  details   String
  ipAddress String
  kycId     String?
  timestamp DateTime @default(now())
}
