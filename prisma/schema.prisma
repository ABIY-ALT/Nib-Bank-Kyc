// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum KYCStatus {
  SUBMITTED
  IN_REVIEW
  ACTION_REQUIRED
  APPROVED
  ESCALATED
  REJECTED
}

enum FindingCategory {
  IDENTITY
  DOCUMENTATION
  COMPLIANCE
  ACCOUNT_VALIDATION
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AuditAction {
  CREATE
  UPDATE
  STATUS_CHANGE
  COMMENT
  BUNDLE_DOWNLOAD
  LOGIN
  LOGOUT
  BRANCH_TRANSFER
  ROLE_TRANSITION
  MANAGEMENT_REPORT_EXPORT
}

model User {
  id                String     @id @default(cuid())
  firebaseUid       String     @unique
  email             String     @unique
  firstName         String
  lastName          String
  phoneNumber       String?
  passwordHash      String?
  status            UserStatus @default(ACTIVE)
  needsPasswordChange Boolean  @default(false)
  
  // Jurisdictional Mapping
  branchId          String?
  branch            Branch?    @relation(fields: [branchId], references: [id])
  assignedBranches  String[]   @default([]) // For KYC Specialists covering multiple nodes
  
  roles             UserRole[]
  
  // Workflows
  submissions       KYC[]      @relation("CreatedBy")
  assignments       KYC[]      @relation("AssignedTo")
  memos             Memo[]
  auditLogs         AuditLog[]
  
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  active      Boolean          @default(true)
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id    String           @id @default(cuid())
  slug  String           @unique
  name  String
  group String           // DASHBOARD, WORKFLOWS, REPORTING, SYSTEM
  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model District {
  id       String   @id @default(cuid())
  name     String   @unique
  branches Branch[]
}

model Branch {
  id         String   @id @default(cuid())
  name       String   @unique
  code       String   @unique
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  users      User[]
  kycCases   KYC[]
}

model KYC {
  id                String    @id
  customerName      String
  status            KYCStatus @default(SUBMITTED)
  entityType        String?   // Individual, Company, etc.
  branchId          String
  branch            Branch    @relation(fields: [branchId], references: [id])
  branchName        String?   // Denormalized for rapid reporting
  
  // Lifecycle tracking
  createdById       String
  createdBy         User      @relation("CreatedBy", fields: [createdById], references: [id])
  assignedToId      String?
  assignedTo        User?     @relation("AssignedTo", fields: [assignedToId], references: [id])
  
  isResubmitted     Boolean   @default(false)
  amendCycles       Int       @default(0)
  active            Boolean   @default(true)
  
  // Exceptional Flow
  isExceptional     Boolean   @default(false)
  exceptionalStatus String    @default("None") // AWAITING_DISTRICT, AWAITING_DIRECTOR, etc.
  
  // Data State
  checklistState    Json?     @default("{}")
  commentHistory    Json?     @default("[]")
  
  memos             Memo[]
  auditLogs         AuditLog[]
  
  submittedAt       DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([branchId])
  @@index([status])
  @@index([createdById])
}

model Memo {
  id           String   @id @default(cuid())
  name         String?
  type         String?
  fileUrl      String
  kycId        String
  kyc          KYC      @relation(fields: [kycId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id])
  userEmail String?
  userName  String?
  kycId     String?
  kyc       KYC?        @relation(fields: [kycId], references: [id])
  action    String      // Uses AuditAction values
  details   String
  metadata  Json?       @default("{}")
  ipAddress String?
  timestamp DateTime    @default(now())
}

model Finding {
  id           String          @id @default(cuid())
  code         String          @unique
  title        String
  description  String
  category     FindingCategory
  severity     FindingSeverity
  applicableTo String[]        // Array of entity types
  active       Boolean         @default(true)
  source       String          @default("manual") // manual, auto
  createdAt    DateTime        @default(now())
}

model GlobalSetting {
  id              String   @id @default("global")
  autoEscalation  Boolean  @default(true)
  escalationHours Int      @default(72)
  strictSla       Boolean  @default(true)
  slaHours        Int      @default(24)
  documentTypes   Json?    @default("[]")
  entityTypes     Json?    @default("[]")
  guidelines      Json?    @default("[]")
  lastUpdated     DateTime @default(now())
  updatedBy       String?
}

model FollowUpVerification {
  id           String   @id @default(cuid())
  submissionId String   @unique
  customerName String
  branch       String
  officer      String
  accountType  String
  verifiedBy   String?
  verifiedAt   DateTime?
  result       String?  // Correct, Discrepancy
  remarks      String?
  status       String   @default("PENDING") // PENDING, COMPLETED
}
