
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum KYCStatus {
  SUBMITTED
  IN_REVIEW
  ACTION_REQUIRED
  APPROVED
  REJECTED
  ESCALATED
}

model User {
  id                  String     @id @default(cuid())
  firstName           String
  lastName            String
  email               String     @unique
  password            String
  phoneNumber         String?
  status              UserStatus @default(ACTIVE)
  branchId            String?
  branch              Branch?    @relation(fields: [branchId], references: [id])
  branchName          String?
  districtName        String?
  assignedBranches    String?    // CSV string of authorized branch names for KYC specialists
  needsPasswordChange Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  roles               UserRole[]
  createdKYCs         KYC[]      @relation("CreatedBy")
  assignedKYCs        KYC[]      @relation("AssignedTo")
  memos               Memo[]
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model Permission {
  id        String           @id @default(cuid())
  slug      String           @unique
  name      String
  group     String
  roles     RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model District {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  branches  Branch[]
}

model Branch {
  id         String   @id @default(cuid())
  name       String   @unique
  code       String   @unique
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  createdAt  DateTime @default(now())
  users      User[]
  kycs       KYC[]
}

model KYC {
  id                String   @id // Formatted as [BRANCH]-KYC-[RANDOM]
  customerName      String
  entityType        String
  branchId          String
  branch            Branch   @relation(fields: [branchId], references: [id])
  branchName        String
  districtName      String
  status            String   @default("SUBMITTED")
  createdById       String
  createdBy         User     @relation("CreatedBy", fields: [createdById], references: [id])
  assignedToId      String?
  assignedTo        User?    @relation("AssignedTo", fields: [assignedToId], references: [id])
  submittedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt
  active            Boolean  @default(true)
  isResubmitted     Boolean  @default(false)
  amendCycles       Int      @default(0)
  remarks           String?
  isExceptional     Boolean  @default(false)
  exceptionalStatus String   @default("None")
  checklistState    Json     @default("{}")
  commentHistory    Json     @default("[]")
  memos             Memo[]
  auditLogs         AuditLog[]
}

model Memo {
  id           String   @id @default(cuid())
  name         String
  type         String   // e.g. ID_CARD, UTILITY_BILL, GOVERNANCE_MEMO
  fileUrl      String
  kycId        String
  kyc          KYC      @relation(fields: [kycId], references: [id])
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String
  userName  String?
  action    String
  details   String
  ipAddress String
  timestamp DateTime @default(now())
  kycId     String?
  kyc       KYC?     @relation(fields: [kycId], references: [id])
}

model Finding {
  id           String   @id @default(cuid())
  code         String   @unique
  title        String
  description  String
  category     String   // IDENTITY, DOCUMENTATION, etc.
  severity     String   // LOW, MEDIUM, HIGH, CRITICAL
  applicableTo String[] // Account types it applies to
  active       Boolean  @default(true)
  source       String   @default("manual") // manual or ai
  createdAt    DateTime @default(now())
}

model GlobalSetting {
  id              String   @id @default("global")
  entityTypes     Json     @default("[]")
  documentTypes   Json     @default("[]")
  guidelines      Json     @default("[]")
  autoEscalation  Boolean  @default(true)
  escalationHours Int      @default(72)
  lastUpdated     DateTime @default(now())
}

model FollowUpVerification {
  id           String   @id @default(cuid())
  submissionId String   @unique
  customerName String
  branch       String
  officer      String
  accountType  String
  verifiedBy   String?
  verifiedAt   DateTime @default(now())
  result       String?  // Correct, Discrepancy
  remarks      String?
  status       String   @default("PENDING") // PENDING, COMPLETED
}
