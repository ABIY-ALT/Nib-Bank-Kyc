generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String      @id @default(cuid())
  firebaseUid      String      @unique
  email            String      @unique
  firstName        String
  lastName         String
  phoneNumber      String?
  status           UserStatus  @default(ACTIVE)
  branchId         String?
  branch           Branch?     @relation(fields: [branchId], references: [id])
  assignedBranches String[]    @default([])
  passwordHash     String?
  roles            UserRole[]
  submissions      KYC[]       @relation("CreatedBy")
  assignments      KYC[]       @relation("AssignedTo")
  auditLogs        AuditLog[]
  memos            Memo[]
  needsPasswordChange Boolean  @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  active      Boolean          @default(true)
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id    String           @id @default(cuid())
  slug  String           @unique
  name  String
  group String
  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model District {
  id       String   @id @default(cuid())
  name     String   @unique
  branches Branch[]
}

model Branch {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String?  @unique
  districtId  String
  district    District @relation(fields: [districtId], references: [id])
  users       User[]
  submissions KYC[]
}

model KYC {
  id               String      @id
  customerName     String
  customerIdNumber String?
  branchId         String
  branch           Branch      @relation(fields: [branchId], references: [id])
  branchName       String
  createdById      String
  createdBy        User        @relation("CreatedBy", fields: [createdById], references: [id])
  assignedToId     String?
  assignedTo       User?       @relation("AssignedTo", fields: [assignedToId], references: [id])
  status           KYCStatus   @default(SUBMITTED)
  entityType       String?
  active           Boolean     @default(true)
  isExceptional    Boolean     @default(false)
  isResubmitted    Boolean     @default(false)
  commentHistory   Json?       @default("[]")
  amendCycles      Int         @default(0)
  memos            Memo[]
  auditLogs        AuditLog[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

enum KYCStatus {
  SUBMITTED
  IN_REVIEW
  ACTION_REQUIRED
  APPROVED
  ESCALATED
  REJECTED
}

model Memo {
  id           String   @id @default(cuid())
  name         String?
  type         String?
  fileUrl      String
  kycId        String
  kyc          KYC      @relation(fields: [kycId], references: [id])
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

model Finding {
  id           String          @id @default(cuid())
  code         String          @unique
  title        String
  description  String
  category     FindingCategory
  severity     FindingSeverity
  applicableTo Json?           @default("[]")
  active       Boolean         @default(true)
  source       String          @default("manual")
  createdAt    DateTime        @default(now())
}

enum FindingCategory {
  IDENTITY
  DOCUMENTATION
  COMPLIANCE
  ACCOUNT_VALIDATION
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model FollowUpVerification {
  id           String   @id @default(cuid())
  submissionId String
  customerName String
  branch       String
  officer      String
  accountType  String
  verifiedBy   String?
  verifiedAt   DateTime?
  result       String?
  remarks      String?
  status       String   @default("PENDING")
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  userEmail String
  userName  String?
  kycId     String?
  kyc       KYC?        @relation(fields: [kycId], references: [id])
  action    AuditAction
  timestamp DateTime    @default(now())
  ipAddress String?
  details   String?
  metadata  Json?
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  PERMISSION_CHANGE
  CONFIG_CHANGE
}

model GlobalSetting {
  id               String   @id @default("global")
  autoEscalation   Boolean  @default(true)
  escalationHours  Int      @default(72)
  strictSla        Boolean  @default(true)
  slaHours         Int      @default(24)
  documentTypes    Json?    @default("[]")
  entityTypes      Json?    @default("[]")
  guidelines       Json?    @default("[]")
  lastUpdated      DateTime @default(now())
  updatedBy        String?
}