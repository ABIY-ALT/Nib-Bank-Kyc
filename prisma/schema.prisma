// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum KYCStatus {
  SUBMITTED
  IN_REVIEW
  ACTION_REQUIRED
  APPROVED
  ESCALATED
  REJECTED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  BRANCH_TRANSFER
  ROLE_TRANSITION
  DOWNLOAD
  LOGIN
  LOGOUT
}

enum FindingCategory {
  IDENTITY
  DOCUMENTATION
  COMPLIANCE
  ACCOUNT_VALIDATION
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id                  String       @id @default(uuid())
  firebaseUid         String       @unique
  firstName           String
  lastName            String
  email               String       @unique
  phoneNumber         String?
  passwordHash        String?
  status              UserStatus   @default(ACTIVE)
  needsPasswordChange Boolean      @default(false)
  
  // Jurisdictional Mapping
  branchId            String?
  branch              Branch?      @relation(fields: [branchId], references: [id])
  assignedBranches    String[]     @default([]) // For KYC Specialists covering multiple nodes
  
  // Authority
  roles               UserRole[]
  
  // Activity
  submissionsCreated  KYC[]        @relation("CreatedBy")
  submissionsAssigned KYC[]        @relation("AssignedTo")
  memosUploaded       Memo[]
  auditLogs           AuditLog[]
  
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  active      Boolean          @default(true)
  users       UserRole[]
  permissions RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Permission {
  id    String           @id @default(uuid())
  slug  String           @unique
  name  String
  group String
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model District {
  id       String   @id @default(uuid())
  name     String   @unique
  branches Branch[]
}

model Branch {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String?  @unique
  districtId  String
  district    District @relation(fields: [districtId], references: [id])
  users       User[]
  submissions KYC[]
}

model KYC {
  id                String    @id
  customerName      String
  customerIdNumber  String?
  status            KYCStatus @default(SUBMITTED)
  entityType        String?   @default("individual")
  
  // Relational context
  branchId          String
  branch            Branch    @relation(fields: [branchId], references: [id])
  branchName        String    // Snapshot at time of submission
  
  createdById       String
  createdBy         User      @relation("CreatedBy", fields: [createdById], references: [id])
  
  assignedToId      String?
  assignedTo        User?     @relation("AssignedTo", fields: [assignedToId], references: [id])
  
  // Lifecycle Metrics
  isExceptional     Boolean   @default(false)
  exceptionalStatus String    @default("NONE")
  isResubmitted     Boolean   @default(false)
  amendCycles       Int       @default(0)
  
  // Data Blobs
  commentHistory    Json?     @default("[]")
  checklistState    Json?     @default("{}")
  
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  submittedAt       DateTime  @default(now())
  
  memos             Memo[]
  auditLogs         AuditLog[]
}

model Memo {
  id           String   @id @default(uuid())
  name         String
  type         String
  fileUrl      String
  kycId        String
  kyc          KYC      @relation(fields: [kycId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

model AuditLog {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  kycId     String?
  kyc       KYC?        @relation(fields: [kycId], references: [id])
  action    AuditAction
  timestamp DateTime    @default(now())
  ipAddress String?
  details   String
  metadata  Json?       @default("{}") // Stores branch/role transition details
}

model Finding {
  id           String          @id @default(uuid())
  code         String          @unique
  title        String
  description  String
  category     FindingCategory
  severity     FindingSeverity
  applicableTo String[]        @default([])
  active       Boolean         @default(true)
  source       String          @default("manual")
  createdAt    DateTime        @default(now())
}

model GlobalSetting {
  id                String   @id @default("global")
  autoEscalation    Boolean  @default(true)
  escalationHours   Int      @default(72)
  strictSla         Boolean  @default(true)
  slaHours          Int      @default(24)
  documentTypes     Json     @default("[]")
  entityTypes       Json     @default("[]")
  guidelines        Json     @default("[]")
  lastUpdated       DateTime @default(now())
  updatedBy         String?
}
