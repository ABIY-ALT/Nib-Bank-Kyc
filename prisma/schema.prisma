generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum FindingCategory {
  IDENTITY
  DOCUMENTATION
  COMPLIANCE
  ACCOUNT_VALIDATION
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  password            String
  firstName           String
  lastName            String
  phoneNumber         String?
  status              UserStatus @default(ACTIVE)
  branchId            String?
  branch              Branch?    @relation(fields: [branchId], references: [id])
  branchName          String?
  districtName        String?
  assignedBranches    String?    // Comma separated list for specialists
  needsPasswordChange Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  roles               UserRole[]
  submissionsCreated  KYC[]      @relation("CreatedBy")
  submissionsAssigned KYC[]      @relation("AssignedTo")
  auditLogs           AuditLog[]
  memos               Memo[]
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  active      Boolean          @default(true)
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id    String           @id @default(cuid())
  slug  String           @unique
  name  String
  group String
  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model District {
  id       String   @id @default(cuid())
  name     String   @unique
  branches Branch[]
}

model Branch {
  id         String   @id @default(cuid())
  name       String   @unique
  code       String?  @unique
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  users      User[]
  submissions KYC[]
}

model KYC {
  id                String            @id
  customerName      String
  branchId          String
  branch            Branch            @relation(fields: [branchId], references: [id])
  branchName        String
  districtName      String
  createdById       String
  createdBy         User              @relation("CreatedBy", fields: [createdById], references: [id])
  assignedToId      String?
  assignedTo        User?             @relation("AssignedTo", fields: [assignedToId], references: [id])
  submittedAt       DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  status            String            @default("SUBMITTED")
  isExceptional     Boolean           @default(false)
  exceptionalStatus String            @default("None")
  entityType        String?
  remarks           String?           @db.Text
  amendCycles       Int               @default(0)
  isResubmitted     Boolean           @default(false)
  checklistState    Json?
  commentHistory    Json?
  active            Boolean           @default(true)
  memos             Memo[]
}

model Memo {
  id           String   @id @default(cuid())
  name         String
  type         String
  fileUrl      String
  kycId        String
  kyc          KYC      @relation(fields: [kycId], references: [id])
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  userEmail String
  userName  String?
  action    String
  details   String   @db.Text
  timestamp DateTime @default(now())
  ipAddress String?
  kycId     String?
  metadata  Json?
}

model GlobalSetting {
  id              String   @id @default("global")
  entityTypes     Json
  documentTypes   Json
  guidelines      Json
  autoEscalation  Boolean  @default(true)
  escalationHours Int      @default(72)
  lastUpdated     DateTime @updatedAt
}

model Finding {
  id           String          @id @default(cuid())
  code         String          @unique
  title        String
  description  String          @db.Text
  category     FindingCategory
  severity     FindingSeverity
  applicableTo String[]
  active       Boolean         @default(true)
  source       String          @default("manual")
}

model FollowUpVerification {
  id           String   @id @default(cuid())
  submissionId String
  customerName String
  branch       String
  officer      String
  accountType  String
  verifiedBy   String?
  verifiedAt   DateTime @default(now())
  result       String?
  remarks      String?  @db.Text
  status       String   @default("PENDING")
}
