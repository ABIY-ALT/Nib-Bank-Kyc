// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BRANCH_OFFICER
  KYC_OFFICER
  SUPERVISOR
  BRANCH_BANKING_DIRECTOR
  ADMIN
  BRANCH_MANAGER
  DISTRICT_DIRECTOR
  DIVISION_MANAGER
  CHIEF_RETAIL_SME_OFFICER
  FOLLOW_UP_TEAM
  CHIEF
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SubmissionStatus {
  PENDING
  IN_REVIEW
  AMENDED
  APPROVED
  ESCALATED
  REJECTED
}

enum ExceptionalStatus {
  NONE
  AWAITING_DISTRICT
  AWAITING_DIRECTOR
  AWAITING_CHIEF
  AWAITING_DIVISION
  AWAITING_SUPERVISOR
  COMPLETED
  REJECTED
  CLARIFICATION_REQUIRED
}

enum FindingCategory {
  IDENTITY
  DOCUMENTATION
  COMPLIANCE
  ACCOUNT_VALIDATION
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model District {
  id          String       @id @default(cuid())
  name        String       @unique
  branches    Branch[]
  users       User[]
  submissions Submission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Branch {
  id          String       @id @default(cuid())
  name        String       @unique
  code        String?      @unique
  districtId  String
  district    District     @relation(fields: [districtId], references: [id])
  users       User[]
  submissions Submission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model User {
  id               String      @id
  name             String
  email            String      @unique
  phoneNumber      String?
  role             UserRole    @default(BRANCH_OFFICER)
  status           UserStatus  @default(ACTIVE)
  branchId         String?
  branch           Branch?     @relation(fields: [branchId], references: [id])
  districtId       String?
  district         District?   @relation(fields: [districtId], references: [id])
  assignedBranches String[]    // Array of branch names for KYC Officers
  submissions      Submission[] @relation("SubmittedBy")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model Submission {
  id                String            @id
  customerId        String?
  customerName      String
  branchId          String
  branch            Branch            @relation(fields: [branchId], references: [id])
  districtId        String
  district          District          @relation(fields: [districtId], references: [id])
  submittedById     String
  submittedBy       User              @relation("SubmittedBy", fields: [submittedById], references: [id])
  submittedAt       DateTime          @default(now())
  status            SubmissionStatus  @default(PENDING)
  isExceptional     Boolean           @default(false)
  exceptionalStatus ExceptionalStatus @default(NONE)
  remarks           String?           @db.Text
  entityType        String?
  amendmentCycles   Int               @default(0)
  isResubmitted     Boolean           @default(false)
  resubmittedAt     DateTime?
  checklistState    Json?             // Stores the verification checklist progress
  documents         Document[]
  comments          Comment[]
  bundleDownloads   BundleDownload[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model Document {
  id           String     @id @default(cuid())
  name         String
  type         String
  url          String
  uploadedAt   DateTime   @default(now())
  status       String     @default("Current")
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id])
}

model Comment {
  id           String     @id @default(cuid())
  role         String
  performedBy  String
  timestamp    DateTime   @default(now())
  comment      String     @db.Text
  action       String
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id])
}

model RoleDefinition {
  id          String   @id @default(cuid())
  name        String   @unique
  permissions Json     // Stores the PermissionSet object
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  userEmail   String
  action      String
  timestamp   DateTime @default(now())
  ipAddress   String?
  details     String?  @db.Text
}

model FollowUpVerification {
  id           String   @id @default(cuid())
  submissionId String
  customerName String
  branch       String
  officer      String
  accountType  String
  verifiedBy   String?
  verifiedAt   DateTime?
  result       String?  // "Correct" or "Discrepancy"
  remarks      String?  @db.Text
  status       String   @default("PENDING") // "PENDING" or "COMPLETED"
}

model BundleDownload {
  id             String     @id @default(cuid())
  performedBy    String
  timestamp      DateTime   @default(now())
  bundleName     String
  sourceDistrict String
  sourceBranch   String
  submissionId   String
  submission     Submission @relation(fields: [submissionId], references: [id])
}

model KYCFinding {
  id           String          @id @default(cuid())
  code         String          @unique
  title        String
  description  String          @db.Text
  category     FindingCategory
  severity     Severity
  applicableTo String[]        // List of entity types
  createdAt    DateTime        @default(now())
  active       Boolean         @default(true)
  source       String          @default("manual") // "manual" or "auto"
}
