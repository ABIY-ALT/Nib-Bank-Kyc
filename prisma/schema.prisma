
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BRANCH_OFFICER
  KYC_OFFICER
  SUPERVISOR
  BRANCH_BANKING_DIRECTOR
  ADMIN
  BRANCH_MANAGER
  DISTRICT_DIRECTOR
  DIVISION_MANAGER
  CHIEF_RETAIL_SME_OFFICER
  FOLLOW_UP_TEAM
  CHIEF
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SubmissionStatus {
  PENDING
  IN_REVIEW
  AMENDED
  APPROVED
  ESCALATED
  REJECTED
}

enum ExceptionalStatus {
  NONE
  AWAITING_DISTRICT
  AWAITING_DIRECTOR
  AWAITING_CHIEF
  AWAITING_DIVISION
  AWAITING_SUPERVISOR
  COMPLETED
  REJECTED
  CLARIFICATION_REQUIRED
}

enum FindingCategory {
  IDENTITY
  DOCUMENTATION
  COMPLIANCE
  ACCOUNT_VALIDATION
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model District {
  id        String   @id @default(cuid())
  name      String   @unique
  branches  Branch[]
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id          String       @id @default(cuid())
  name        String       @unique
  code        String?      @unique
  districtId  String
  district    District     @relation(fields: [districtId], references: [id])
  users       User[]
  submissions Submission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model User {
  id                  String      @id @default(cuid())
  name                String
  email               String      @unique
  phoneNumber         String?
  role                UserRole    @default(BRANCH_OFFICER)
  status              UserStatus  @default(ACTIVE)
  branchId            String?
  branch              Branch?     @relation(fields: [branchId], references: [id])
  districtId          String?
  district            District?   @relation(fields: [districtId], references: [id])
  assignedBranches    String[]    // IDs of additional branches for KYC Officers
  needsPasswordChange Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  submissions         Submission[] @relation("SubmittedBy")
  reviewedSubmissions Submission[] @relation("ReviewedBy")
  auditLogs           AuditLog[]
}

model Submission {
  id                String            @id
  customerName      String
  customerId        String?
  entityType        String?
  status            SubmissionStatus  @default(PENDING)
  branchId          String
  branch            Branch            @relation(fields: [branchId], references: [id])
  submittedById     String
  submittedBy       User              @relation("SubmittedBy", fields: [submittedById], references: [id])
  submittedAt       DateTime          @default(now())
  reviewedById      String?
  reviewedBy        User?             @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt        DateTime?
  isResubmitted     Boolean           @default(false)
  resubmittedAt     DateTime?
  amendmentCycles   Int               @default(0)
  isExceptional     Boolean           @default(false)
  exceptionalStatus ExceptionalStatus @default(NONE)
  exceptionalData   Json?             // Stores details of the hierarchy flow
  checklistState    Json?             // Stores the verification checklist progress
  remarks           String?           @db.Text
  documents         Document[]
  comments          Comment[]
  updatedAt         DateTime          @updatedAt
}

model Document {
  id           String     @id @default(cuid())
  name         String
  type         String
  url          String
  status       String     @default("Current")
  uploadedAt   DateTime   @default(now())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id])
}

model Comment {
  id           String     @id @default(cuid())
  role         String
  performedBy  String
  comment      String     @db.Text
  action       String
  timestamp    DateTime   @default(now())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id])
}

model RoleDefinition {
  id          String @id
  name        String @unique
  permissions Json   // Serialized functional flags
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  details   String?  @db.Text
  ipAddress String?
  timestamp DateTime @default(now())
}

model FollowUpVerification {
  id           String   @id @default(cuid())
  submissionId String
  customerName String
  branch       String
  officer      String
  result       String?  // CORRECT or DISCREPANCY
  remarks      String?  @db.Text
  status       String   @default("PENDING")
  verifiedBy   String?
  verifiedAt   DateTime?
}

model BundleDownload {
  id          String   @id @default(cuid())
  performedBy String
  bundleName  String
  timestamp   DateTime @default(now())
}

model KYCFinding {
  id           String          @id @default(cuid())
  code         String          @unique
  title        String
  description  String          @db.Text
  category     FindingCategory
  severity     Severity
  applicableTo String[]
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
}
