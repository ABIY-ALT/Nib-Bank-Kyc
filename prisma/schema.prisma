// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BRANCH_OFFICER
  KYC_OFFICER
  SUPERVISOR
  BRANCH_BANKING_DIRECTOR
  ADMIN
  BRANCH_MANAGER
  DISTRICT_DIRECTOR
  DIVISION_MANAGER
  CHIEF_RETAIL_SME_BANKING_OFFICER
  FOLLOW_UP_TEAM
  CHIEF
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SubmissionStatus {
  PENDING
  IN_REVIEW
  AMENDED
  APPROVED
  ESCALATED
  REJECTED
}

enum ExceptionalStatus {
  NONE
  AWAITING_DISTRICT
  AWAITING_DIRECTOR
  AWAITING_CHIEF
  AWAITING_DIVISION
  AWAITING_SUPERVISOR
  COMPLETED
  REJECTED
  CLARIFICATION_REQUIRED
}

enum FindingCategory {
  IDENTITY
  DOCUMENTATION
  COMPLIANCE
  ACCOUNT_VALIDATION
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id                String         @id
  email             String         @unique
  name              String
  phoneNumber       String?
  role              UserRole       @default(BRANCH_OFFICER)
  status            UserStatus     @default(ACTIVE)
  branchName        String?
  districtName      String?
  assignedBranches  String[]       @default([])
  needsPasswordChange Boolean      @default(false)
  
  submissions       Submission[]   @relation("SubmittedBy")
  reviews           Submission[]   @relation("ReviewedBy")
  auditLogs         AuditLog[]
}

model Submission {
  id                String            @id
  customerName      String
  entityType        String?
  branchName        String
  districtName      String
  submittedAt       DateTime          @default(now())
  status            SubmissionStatus  @default(PENDING)
  remarks           String?
  
  isExceptional     Boolean           @default(false)
  exceptionalStatus ExceptionalStatus @default(NONE)
  exceptionalData   Json?             // Stores reason, justification, memoUrl, approvalHistory
  
  commentHistory    Json?             // Array of comments
  amendmentCycles   Int               @default(0)
  isResubmitted     Boolean           @default(false)
  checklistState    Json?
  
  submittedBy       User              @relation("SubmittedBy", fields: [submittedById], references: [id])
  submittedById     String
  
  reviewedBy        User?             @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedById      String?
  reviewedAt        DateTime?

  documents         Document[]
  bundleDownloads   BundleDownload[]
}

model Document {
  id           String     @id @default(cuid())
  name         String
  type         String
  url          String
  status       String     @default("Current")
  uploadedAt   DateTime   @default(now())
  
  submission   Submission @relation(fields: [submissionId], references: [id])
  submissionId String
}

model District {
  id       String   @id @default(cuid())
  name     String   @unique
  branches Branch[]
}

model Branch {
  id           String   @id @default(cuid())
  name         String   @unique
  code         String?
  district     District @relation(fields: [districtName], references: [name])
  districtName String
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  userEmail String
  userName  String?
  action    String
  timestamp DateTime @default(now())
  ipAddress String
  details   String
  user      User     @relation(fields: [userId], references: [id])
}

model GlobalSetting {
  id               String   @id @default("global")
  autoEscalation   Boolean  @default(true)
  escalationHours  Int      @default(72)
  strictSla        Boolean  @default(true)
  slaHours         Int      @default(24)
  documentTypes    Json?    // Array of {id, label}
  entityTypes      Json?    // Array of {id, label}
  guidelines       Json?    // Array of {id, title, description, type}
  lastUpdated      DateTime @default(now())
  updatedBy        String?
}

model Finding {
  id           String          @id @default(cuid())
  code         String          @unique
  title        String
  description  String
  category     FindingCategory
  severity     FindingSeverity
  applicableTo String[]        // Array of account types
  active       Boolean         @default(true)
  source       String          @default("manual")
}

model FollowUpVerification {
  id           String   @id @default(cuid())
  submissionId String
  customerName String
  branch       String
  officer      String
  accountType  String
  verifiedBy   String?
  verifiedAt   DateTime?
  result       String?  // "Correct" | "Discrepancy"
  remarks      String?
  status       String   @default("PENDING") // "PENDING" | "COMPLETED"
}

model BundleDownload {
  id             String     @id @default(cuid())
  performedBy    String
  timestamp      DateTime   @default(now())
  bundleName     String
  sourceDistrict String
  sourceBranch   String
  submission     Submission @relation(fields: [submissionId], references: [id])
  submissionId   String
}
