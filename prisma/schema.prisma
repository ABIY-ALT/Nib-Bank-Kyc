generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String     @id @default(uuid())
  email               String     @unique
  password            String
  firstName           String
  lastName            String
  phoneNumber         String?
  status              String     @default("ACTIVE") 
  branchId            String?
  branchName          String?
  districtName        String?
  assignedBranches    String?    // Comma separated list
  needsPasswordChange Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  
  branch              Branch?    @relation(fields: [branchId], references: [id])
  roles               UserRole[]
  kycsCreated         KYC[]      @relation("CreatedBy")
  kycsAssigned        KYC[]      @relation("AssignedTo")
  memos               Memo[]
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  active      Boolean          @default(true)
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id    String           @id @default(uuid())
  slug  String           @unique
  name  String
  group String
  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model District {
  id       String   @id @default(uuid())
  name     String   @unique
  branches Branch[]
}

model Branch {
  id         String   @id @default(uuid())
  name       String   @unique
  code       String?  @unique
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  users      User[]
  kycs       KYC[]
}

model KYC {
  id                String     @id
  customerName      String
  status            String     @default("SUBMITTED") 
  branchId          String
  branchName        String
  createdById       String
  assignedToId      String?
  submittedAt       DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  entityType        String?
  active            Boolean    @default(true)
  isExceptional     Boolean    @default(false)
  exceptionalStatus String     @default("None")
  isResubmitted     Boolean    @default(false)
  amendCycles       Int        @default(0)
  checklistState    String?    // JSON string
  commentHistory    String?    // JSON string
  
  branch            Branch     @relation(fields: [branchId], references: [id])
  createdBy         User       @relation("CreatedBy", fields: [createdById], references: [id])
  assignedTo        User?      @relation("AssignedTo", fields: [assignedToId], references: [id])
  memos             Memo[]
  auditLogs         AuditLog[]
}

model Memo {
  id           String   @id @default(uuid())
  name         String
  type         String
  fileUrl      String
  kycId        String
  uploadedById String
  createdAt    DateTime @default(now())
  
  kyc          KYC      @relation(fields: [kycId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  kycId     String?
  action    String
  details   String?
  ipAddress String?
  metadata  String?  // JSON string
  timestamp DateTime @default(now())
  userEmail String?
  userName  String?
  severity  String   @default("LOW")

  kyc       KYC?     @relation(fields: [kycId], references: [id])
}

model GlobalSetting {
  id              String   @id @default("global")
  autoEscalation  Boolean  @default(true)
  escalationHours Int      @default(72)
  strictSla       Boolean  @default(true)
  slaHours        Int      @default(24)
  documentTypes   String?  // JSON string
  entityTypes     String?  // JSON string
  guidelines      String?  // JSON string
  lastUpdated     DateTime @default(now())
}

model Finding {
  id           String   @id @default(uuid())
  code         String   @unique
  title        String
  description  String
  category     String
  severity     String
  applicableTo String?  // Comma separated
  active       Boolean  @default(true)
  source       String   @default("manual")
  createdAt    DateTime @default(now())
}
