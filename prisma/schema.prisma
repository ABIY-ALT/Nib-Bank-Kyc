
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum FindingCategory {
  IDENTITY
  DOCUMENTATION
  COMPLIANCE
  ACCOUNT_VALIDATION
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  password            String
  firstName           String
  lastName            String
  phoneNumber         String?
  status              UserStatus @default(ACTIVE)
  branchId            String?
  branchName          String?
  districtName        String?
  assignedBranches    String?    // CSV of branch names for specialists
  needsPasswordChange Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  branch              Branch?    @relation(fields: [branchId], references: [id])
  roles               UserRole[]
  submissions         KYC[]      @relation("CreatedBy")
  assignments         KYC[]      @relation("AssignedTo")
  memos               Memo[]
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  group       String           @default("SYSTEM")
  roles       RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model District {
  id        String   @id @default(cuid())
  name      String   @unique
  branches  Branch[]
}

model Branch {
  id         String   @id @default(cuid())
  name       String   @unique
  code       String?
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  users      User[]
  kycs       KYC[]
}

model KYC {
  id                String   @id
  customerName      String
  entityType        String
  branchId          String
  branchName        String
  districtName      String
  status            String
  isExceptional     Boolean  @default(false)
  exceptionalStatus String   @default("None")
  remarks           String?
  checklistState    Json     @default("{}")
  commentHistory    Json     @default("[]")
  isResubmitted     Boolean  @default(false)
  amendCycles       Int      @default(0)
  active            Boolean  @default(true)
  createdById       String
  assignedToId      String?
  submittedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt

  createdBy         User     @relation("CreatedBy", fields: [createdById], references: [id])
  assignedTo        User?    @relation("AssignedTo", fields: [assignedToId], references: [id])
  branch            Branch   @relation(fields: [branchId], references: [id])
  memos             Memo[]
}

model Memo {
  id           String   @id @default(cuid())
  name         String
  type         String
  fileUrl      String
  kycId        String
  uploadedById String
  createdAt    DateTime @default(now())

  kyc          KYC      @relation(fields: [kycId], references: [id])
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
}

model Finding {
  id           String          @id @default(cuid())
  code         String          @unique
  title        String
  description  String
  category     FindingCategory
  severity     FindingSeverity
  applicableTo String[]        // Array of account types
  active       Boolean         @default(true)
  source       String          @default("manual")
  createdAt    DateTime        @default(now())
}

model GlobalSetting {
  id              String   @id @default("global")
  autoEscalation  Boolean  @default(true)
  escalationHours Int      @default(72)
  entityTypes     Json     @default("[]")
  documentTypes   Json     @default("[]")
  guidelines      Json     @default("[]")
  lastUpdated     DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String
  userName  String?
  action    String
  details   String
  ipAddress String?
  kycId     String?
  metadata  Json?
  timestamp DateTime @default(now())
}
