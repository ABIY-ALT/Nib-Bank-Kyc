generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum FindingCategory {
  IDENTITY
  DOCUMENTATION
  COMPLIANCE
  ACCOUNT_VALIDATION
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  password            String
  firstName           String
  lastName            String
  phoneNumber         String?
  status              UserStatus @default(ACTIVE)
  needsPasswordChange Boolean    @default(false)
  
  branchId            String?
  branch              Branch?    @relation(fields: [branchId], references: [id])
  branchName          String?    
  districtName        String?    
  
  assignedBranches    String?    
  
  roles               UserRole[]
  
  submissionsCreated  KYC[]      @relation("CreatedBy")
  submissionsAssigned KYC[]      @relation("AssignedTo")
  
  memosUploaded       Memo[]
  
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  active      Boolean          @default(true)
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model Permission {
  id    String           @id @default(cuid())
  slug  String           @unique
  name  String
  group String
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model District {
  id       String   @id @default(cuid())
  name     String   @unique
  branches Branch[]
}

model Branch {
  id         String   @id @default(cuid())
  name       String   @unique
  code       String?  @unique
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  users      User[]
  kycs       KYC[]
}

model KYC {
  id                String   @id
  customerName      String
  entityType        String
  status            String   @default("SUBMITTED")
  
  branchId          String
  branch            Branch   @relation(fields: [branchId], references: [id])
  branchName        String
  districtName      String
  
  createdById       String
  createdBy         User     @relation("CreatedBy", fields: [createdById], references: [id])
  
  assignedToId      String?
  assignedTo        User?    @relation("AssignedTo", fields: [assignedToId], references: [id])
  
  isExceptional     Boolean  @default(false)
  exceptionalStatus String   @default("None")
  
  remarks           String?
  amendCycles       Int      @default(0)
  isResubmitted     Boolean  @default(false)
  
  checklistState    Json?    @default("{}")
  commentHistory    Json?    @default("[]")
  
  memos             Memo[]
  
  submittedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt
  active            Boolean  @default(true)
}

model Memo {
  id           String   @id @default(cuid())
  name         String
  type         String   
  fileUrl      String
  
  kycId        String
  kyc          KYC      @relation(fields: [kycId], references: [id])
  
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  
  createdAt    DateTime @default(now())
}

model Finding {
  id           String          @id @default(cuid())
  code         String          @unique
  title        String
  description  String
  category     FindingCategory
  severity     FindingSeverity
  applicableTo String[]        
  active       Boolean         @default(true)
  source       String          @default("manual") 
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model FollowUpVerification {
  id           String   @id @default(cuid())
  submissionId String
  customerName String
  branch       String
  officer      String
  accountType  String
  verifiedBy   String?
  verifiedAt   DateTime @default(now())
  result       String?  
  remarks      String?
  status       String   @default("PENDING")
}

model GlobalSetting {
  id              String   @id @default("global")
  entityTypes     Json?    @default("[]")
  documentTypes   Json?    @default("[]")
  guidelines      Json?    @default("[]")
  autoEscalation  Boolean  @default(true)
  escalationHours Int      @default(72)
  lastUpdated     DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String?
  userEmail String
  action    String
  details   String
  ipAddress String?
  kycId     String?
  timestamp DateTime @default(now())
}
