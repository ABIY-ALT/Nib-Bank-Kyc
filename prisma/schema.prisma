// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum FindingCategory {
  IDENTITY
  DOCUMENTATION
  COMPLIANCE
  ACCOUNT_VALIDATION
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id                  String      @id @default(cuid())
  email               String      @unique
  password            String
  firstName           String
  lastName            String
  phoneNumber         String?
  status              UserStatus  @default(ACTIVE)
  branchId            String?
  branch              Branch?     @relation(fields: [branchId], references: [id])
  branchName          String?
  districtName        String?
  assignedBranches    String?     @db.Text // Comma separated list for specialists
  needsPasswordChange Boolean     @default(false)
  
  roles               UserRole[]
  submissions         KYC[]       @relation("CreatedBy")
  assignments         KYC[]       @relation("AssignedTo")
  auditLogs           AuditLog[]
  memos               Memo[]
  
  updatedAt           DateTime    @updatedAt
  createdAt           DateTime    @default(now())
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  active      Boolean          @default(true)
  permissions RolePermission[]
  users       UserRole[]
  
  updatedAt   DateTime         @updatedAt
  createdAt   DateTime         @default(now())
}

model Permission {
  id    String           @id @default(cuid())
  slug  String           @unique
  name  String
  group String
  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model District {
  id       String   @id @default(cuid())
  name     String   @unique
  branches Branch[]
}

model Branch {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String?  @unique
  districtId  String
  district    District @relation(fields: [districtId], references: [id], onDelete: Cascade)
  
  submissions KYC[]
  users       User[]
}

model KYC {
  id                String   @id // Formatted Branch-KYC-ID
  customerName      String
  entityType        String
  status            String
  isResubmitted     Boolean  @default(false)
  amendCycles       Int      @default(0)
  
  isExceptional     Boolean  @default(false)
  exceptionalStatus String   @default("None")
  
  remarks           String?  @db.Text
  checklistState    Json     @default("{}")
  commentHistory    Json     @default("[]")
  
  branchId          String
  branch            Branch   @relation(fields: [branchId], references: [id])
  branchName        String
  districtName      String
  
  createdById       String
  createdBy         User     @relation("CreatedBy", fields: [createdById], references: [id])
  
  assignedToId      String?
  assignedTo        User?    @relation("AssignedTo", fields: [assignedToId], references: [id])
  
  memos             Memo[]
  active            Boolean  @default(true)
  
  updatedAt         DateTime @updatedAt
  submittedAt       DateTime @default(now())
}

model Memo {
  id           String   @id @default(cuid())
  name         String
  type         String
  fileUrl      String
  
  kycId        String
  kyc          KYC      @relation(fields: [kycId], references: [id], onDelete: Cascade)
  
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  
  createdAt    DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  userEmail String
  userName  String?
  action    String
  details   String   @db.Text
  ipAddress String?
  kycId     String?
  metadata  Json?
  timestamp DateTime @default(now())
}

model GlobalSetting {
  id              String   @id @default("global")
  entityTypes     Json     @default("[]")
  documentTypes   Json     @default("[]")
  guidelines      Json     @default("[]")
  autoEscalation  Boolean  @default(true)
  escalationHours Int      @default(72)
  lastUpdated     DateTime @updatedAt
}

model FollowUpVerification {
  id           String   @id @default(cuid())
  submissionId String
  customerName String
  branch       String
  officer      String
  accountType  String
  verifiedBy   String?
  verifiedAt   DateTime @default(now())
  result       String?  // "Correct" | "Discrepancy"
  remarks      String?  @db.Text
  status       String   @default("PENDING")
}

model Finding {
  id           String          @id @default(cuid())
  code         String          @unique
  title        String
  description  String          @db.Text
  category     FindingCategory
  severity     FindingSeverity
  applicableTo String[]        // List of entityTypes
  active       Boolean         @default(true)
  source       String          @default("manual")
  updatedAt    DateTime        @updatedAt
}
