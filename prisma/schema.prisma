generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  password            String
  firstName           String
  lastName            String
  phoneNumber         String?
  status              UserStatus @default(ACTIVE)
  branchId            String?
  branch              Branch?    @relation(fields: [branchId], references: [id])
  needsPasswordChange Boolean    @default(false)
  assignedBranches    String     @default("[]") 
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  roles               UserRole[]
  kycs                KYC[]      @relation("CreatedBy")
  assignedKycs        KYC[]      @relation("AssignedTo")
  memos               Memo[]
  auditLogs           AuditLog[]
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  active      Boolean          @default(true)
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id    String           @id @default(cuid())
  slug  String           @unique
  name  String
  group String
  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model District {
  id       String   @id @default(cuid())
  name     String   @unique
  branches Branch[]
}

model Branch {
  id         String   @id @default(cuid())
  name       String   @unique
  code       String?  @unique
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  users      User[]
  kycs       KYC[]
}

model KYC {
  id                String     @id
  customerName      String
  status            KYCStatus  @default(SUBMITTED)
  branchId          String
  branchName        String
  isExceptional     Boolean    @default(false)
  exceptionalStatus String     @default("None")
  commentHistory    Json       @default("[]") 
  checklistState    Json       @default("{}") 
  active            Boolean    @default(true)
  isResubmitted     Boolean    @default(false)
  amendCycles       Int        @default(0)
  submittedAt       DateTime   @default(now())
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  createdById       String
  assignedToId      String?
  entityType        String?
  
  branch            Branch     @relation(fields: [branchId], references: [id])
  createdBy         User       @relation("CreatedBy", fields: [createdById], references: [id])
  assignedTo        User?      @relation("AssignedTo", fields: [assignedToId], references: [id])
  memos             Memo[]
  auditLogs         AuditLog[]
}

enum KYCStatus {
  SUBMITTED
  IN_REVIEW
  ACTION_REQUIRED
  APPROVED
  REJECTED
  ESCALATED
}

model Memo {
  id           String   @id @default(cuid())
  name         String
  type         String
  fileUrl      String
  kycId        String
  uploadedById String
  createdAt    DateTime @default(now())
  
  kyc          KYC      @relation(fields: [kycId], references: [id])
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String?
  userEmail String?
  userName  String?
  action    String
  details   String
  ipAddress String?
  timestamp DateTime    @default(now())
  kycId     String?
  metadata  Json?       @default("{}")

  user      User?       @relation(fields: [userId], references: [id])
  kyc       KYC?        @relation(fields: [kycId], references: [id])
}

model Finding {
  id           String          @id @default(cuid())
  code         String          @unique
  title        String
  description  String
  category     FindingCategory
  severity     FindingSeverity
  applicableTo Json            @default("[]") 
  active       Boolean         @default(true)
  source       String          @default("manual")
  createdAt    DateTime        @default(now())
}

enum FindingCategory {
  IDENTITY
  DOCUMENTATION
  COMPLIANCE
  ACCOUNT_VALIDATION
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model GlobalSetting {
  id              String   @id @default("global")
  autoEscalation  Boolean  @default(true)
  escalationHours Int      @default(72)
  strictSla       Boolean  @default(true)
  slaHours        Int      @default(24)
  documentTypes   Json     @default("[]") 
  entityTypes     Json     @default("[]") 
  guidelines      Json     @default("[]") 
  lastUpdated     DateTime @default(now())
}
