generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum FindingCategory {
  IDENTITY
  DOCUMENTATION
  COMPLIANCE
  ACCOUNT_VALIDATION
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id                  String     @id @default(cuid())
  firstName           String
  lastName            String
  email               String     @unique
  password            String
  phoneNumber         String?
  status              UserStatus @default(ACTIVE)
  needsPasswordChange Boolean    @default(true)
  branchId            String?
  branchName          String?
  districtName        String?
  assignedBranches    String?    // Stored as comma-separated
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  branch              Branch?    @relation(fields: [branchId], references: [id])
  roles               UserRole[]
  submissionsCreated  KYC[]      @relation("CreatedBy")
  submissionsAssigned KYC[]      @relation("AssignedTo")
  memos               Memo[]
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id    String           @id @default(cuid())
  slug  String           @unique
  name  String
  group String
  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model KYC {
  id                String   @id
  customerName      String
  branchId          String?
  branchName        String
  districtName      String
  status            String
  isExceptional     Boolean  @default(false)
  exceptionalStatus String   @default("None")
  isResubmitted     Boolean  @default(false)
  amendCycles       Int      @default(0)
  checklistState    Json?
  commentHistory    Json?
  createdById       String
  assignedToId      String?
  submittedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt
  active            Boolean  @default(true)

  createdBy         User     @relation("CreatedBy", fields: [createdById], references: [id])
  assignedTo        User?    @relation("AssignedTo", fields: [assignedToId], references: [id])
  branch            Branch?  @relation(fields: [branchId], references: [id])
  memos             Memo[]
}

model Memo {
  id           String   @id @default(cuid())
  name         String
  type         String
  fileUrl      String
  kycId        String
  uploadedById String
  createdAt    DateTime @default(now())

  kyc          KYC      @relation(fields: [kycId], references: [id])
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String
  userName  String?
  action    String
  timestamp DateTime @default(now())
  ipAddress String
  details   String
  kycId     String?
  severity  String?
  metadata  Json?
}

model Finding {
  id           String          @id @default(cuid())
  code         String          @unique
  title        String
  description  String
  category     FindingCategory
  severity     FindingSeverity
  applicableTo String[]
  active       Boolean         @default(true)
  source       String          @default("manual")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model GlobalSetting {
  id               String   @id @default("global")
  entityTypes      Json?
  documentTypes    Json?
  guidelines       Json?
  autoEscalation   Boolean  @default(true)
  escalationHours  Int      @default(72)
  lastUpdated      DateTime @default(now())
}

model FollowUpVerification {
  id           String   @id @default(cuid())
  submissionId String
  customerName String
  branch       String
  officer      String
  accountType  String
  verifiedBy   String?
  verifiedAt   DateTime @default(now())
  result       String?
  status       String   @default("PENDING")
  remarks      String?
}

model District {
  id       String   @id @default(cuid())
  name     String   @unique
  branches Branch[]
}

model Branch {
  id         String   @id @default(cuid())
  name       String   @unique
  code       String?  @unique
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  users      User[]
  submissions KYC[]
}
