generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum RoleType {
  SUPER_ADMIN
  BRANCH_OFFICER
  KYC_SPECIALIST
  SENIOR_ASSESSOR
  DISTRICT_DIRECTOR
  BRANCH_BANKING_DIRECTOR
  CHIEF_OFFICER
  DIVISION_MANAGER
  SUPERVISOR
  COMPLIANCE_OFFICER
  AUDITOR
  SLA_MANAGER
  ADMIN
}

enum KYCStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ACTION_REQUIRED
  RESUBMITTED
  ESCALATED
  GOVERNANCE_PENDING
  GOVERNANCE_APPROVED
  COMPLIANCE_REVIEW
  ACTIVE
  INACTIVE
  REJECTED
  FROZEN
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AuditAction {
  LOGIN
  CREATE
  UPDATE
  SUBMIT
  APPROVE
  REJECT
  ESCALATE
  FREEZE
  EXPORT
  STATUS_CHANGE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum FindingCategory {
  IDENTITY
  DOCUMENTATION
  COMPLIANCE
  ACCOUNT_VALIDATION
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

//////////////////////////////////////////////////////
// INSTITUTIONAL STRUCTURE
//////////////////////////////////////////////////////

model District {
  id        String   @id @default(uuid())
  name      String   @unique
  branches  Branch[]
  createdAt DateTime @default(now())
}

model Branch {
  id         String   @id @default(uuid())
  name       String
  code       String   @unique
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  users      User[]
  kycs       KYC[]
  createdAt  DateTime @default(now())
}

//////////////////////////////////////////////////////
// USER & RBAC
//////////////////////////////////////////////////////

model User {
  id            String   @id @default(uuid())
  firebaseUid   String   @unique
  email         String   @unique
  firstName     String
  lastName      String
  phoneNumber   String?
  role          String   // Transitioned to String to support dynamic RoleDefinitions
  branchId      String?
  branch        Branch?  @relation(fields: [branchId], references: [id])
  status        UserStatus @default(ACTIVE)
  needsPasswordChange Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  auditLogs     AuditLog[]
  assignedKycs  KYC[]    @relation("AssignedTo")
  createdKycs   KYC[]    @relation("CreatedBy")
}

model RoleDefinition {
  id                   String   @id @default(uuid())
  name                 String   @unique
  canSubmit            Boolean  @default(false)
  canReview            Boolean  @default(false)
  canEscalate          Boolean  @default(false)
  canViewReports       Boolean  @default(false)
  canManageUsers       Boolean  @default(false)
  canManageSystem      Boolean  @default(false)
  canAccessPerformance Boolean  @default(false)
  canAccessFollowUp    Boolean  @default(false)
  canAccessArchive     Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

//////////////////////////////////////////////////////
// KYC CORE MODEL
//////////////////////////////////////////////////////

model KYC {
  id               String      @id
  customerName     String
  customerIdNumber String
  branchId         String
  branch           Branch      @relation(fields: [branchId], references: [id])

  status           KYCStatus   @default(DRAFT)
  riskLevel        RiskLevel    @default(LOW)

  createdById      String
  createdBy        User        @relation("CreatedBy", fields: [createdById], references: [id])

  assignedToId     String?
  assignedTo       User?       @relation("AssignedTo", fields: [assignedToId], references: [id])

  governanceFlow   GovernanceFlow?
  amendments       Amendment[]
  memos            Memo[]
  auditLogs        AuditLog[]
  auditSamplings   AuditSampling[]

  slaDueAt         DateTime?
  approvedAt       DateTime?

  amendCycles      Int         @default(0)
  isResubmitted    Boolean     @default(false)
  entityType       String?
  commentHistory   Json?       // For historical tracking

  active           Boolean     @default(true) // Zero deletion policy

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

//////////////////////////////////////////////////////
// AMENDMENT CYCLE
//////////////////////////////////////////////////////

model Amendment {
  id          String   @id @default(uuid())
  kycId       String
  kyc         KYC      @relation(fields: [kycId], references: [id])
  requestedBy String
  resolved    Boolean  @default(false)
  comment     String
  createdAt   DateTime @default(now())
}

//////////////////////////////////////////////////////
// GOVERNANCE FLOW (Exceptional Cases)
//////////////////////////////////////////////////////

model GovernanceFlow {
  id              String   @id @default(uuid())
  kycId           String   @unique
  kyc             KYC      @relation(fields: [kycId], references: [id])

  districtApproved         Boolean @default(false)
  branchBankingApproved    Boolean @default(false)
  chiefOfficerApproved     Boolean @default(false)
  divisionManagerApproved  Boolean @default(false)
  supervisorApproved       Boolean @default(false)

  completed       Boolean   @default(false)
  createdAt       DateTime  @default(now())
}

//////////////////////////////////////////////////////
// AUTHORIZATION MEMOS (PDF UPLOADS)
//////////////////////////////////////////////////////

model Memo {
  id        String   @id @default(uuid())
  kycId     String
  kyc       KYC      @relation(fields: [kycId], references: [id])
  name      String?
  type      String?
  uploadedById String
  fileUrl   String
  createdAt DateTime @default(now())
}

//////////////////////////////////////////////////////
// AUDIT LOG (SECURITY VAULT)
//////////////////////////////////////////////////////

model AuditLog {
  id        String      @id @default(uuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id])
  kycId     String?
  kyc       KYC?        @relation(fields: [kycId], references: [id])
  action    AuditAction
  details   String?
  ipAddress String?
  metadata  Json?
  timestamp DateTime    @default(now())
}

//////////////////////////////////////////////////////
// RANDOM SAMPLING (HEAD OFFICE QC)
//////////////////////////////////////////////////////

model AuditSampling {
  id          String   @id @default(uuid())
  kycId       String
  kyc         KYC      @relation(fields: [kycId], references: [id])
  reviewedBy  String
  discrepancy Boolean  @default(false)
  remarks     String?
  score       Int?
  createdAt   DateTime @default(now())
}

//////////////////////////////////////////////////////
// SYSTEM KNOWLEDGE BASE
//////////////////////////////////////////////////////

model Finding {
  id           String          @id @default(uuid())
  code         String          @unique
  title        String
  description  String
  category     FindingCategory
  severity     FindingSeverity
  applicableTo String[]        // List of account types
  active       Boolean         @default(true)
  source       String          @default("manual") // manual or auto
  createdAt    DateTime        @default(now())
}

model GlobalSetting {
  id              String   @id @default("global")
  autoEscalation  Boolean  @default(true)
  escalationHours Int      @default(72)
  strictSla       Boolean  @default(true)
  slaHours        Int      @default(24)
  documentTypes   Json?    // Array of {id, label}
  entityTypes     Json?    // Array of {id, label}
  guidelines      Json?    // Array of {id, title, description, type}
  updatedBy       String?
  lastUpdated     DateTime @updatedAt
}