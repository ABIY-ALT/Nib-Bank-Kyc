// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  password            String
  firstName           String
  lastName            String
  phoneNumber         String?
  status              UserStatus @default(ACTIVE)
  needsPasswordChange Boolean    @default(false)
  
  branchId            String?
  branch              Branch?    @relation(fields: [branchId], references: [id])
  
  assignedBranches    String?    // Comma separated list for specialists
  
  roles               UserRole[]
  
  submissions         KYC[]      @relation("CreatedBy")
  assignedSubmissions KYC[]      @relation("AssignedTo")
  
  auditLogs           AuditLog[]
  memos               Memo[]     @relation("UploadedBy")
  
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  active      Boolean          @default(true)
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id    String           @id @default(cuid())
  slug  String           @unique // e.g., 'CASE_SUBMIT'
  name  String
  group String           // e.g., 'WORKFLOWS', 'SYSTEM'
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model District {
  id       String   @id @default(cuid())
  name     String   @unique
  branches Branch[]
}

model Branch {
  id         String   @id @default(cuid())
  name       String   @unique
  code       String?  @unique
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  users      User[]
  submissions KYC[]
}

model KYC {
  id                String   @id // Custom format e.g. BR-KYC-1234
  customerName      String
  entityType        String?
  
  branchId          String
  branch            Branch   @relation(fields: [branchId], references: [id])
  branchName        String   // Denormalized for fast filtering
  
  createdById       String
  createdBy         User     @relation("CreatedBy", fields: [createdById], references: [id])
  
  assignedToId      String?
  assignedTo        User?    @relation("AssignedTo", fields: [assignedToId], references: [id])
  
  submittedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  status            String   // From KYC_STATUS constants
  active            Boolean  @default(true)
  
  isExceptional     Boolean  @default(false)
  exceptionalStatus String   @default("None")
  
  checklistState    String?  @db.Text // JSON blob
  commentHistory    String?  @db.Text // JSON blob
  
  amendCycles       Int      @default(0)
  isResubmitted     Boolean  @default(false)
  
  memos             Memo[]
  auditLogs         AuditLog[]
}

model Memo {
  id           String   @id @default(cuid())
  name         String
  type         String
  fileUrl      String
  kycId        String
  kyc          KYC      @relation(fields: [kycId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User     @relation("UploadedBy", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  userEmail String?
  userName  String?
  action    String
  details   String   @db.Text
  ipAddress String?
  severity  String   @default("LOW")
  metadata  String?  @db.Text
  kycId     String?
  kyc       KYC?     @relation(fields: [kycId], references: [id])
  timestamp DateTime @default(now())
}

model GlobalSetting {
  id            String   @id @default("global")
  entityTypes   String?  @db.Text // JSON array
  documentTypes String?  @db.Text // JSON array
  guidelines    String?  @db.Text // JSON array
  lastUpdated   DateTime @default(now())
}

model Finding {
  id           String   @id @default(cuid())
  code         String   @unique
  title        String
  description  String   @db.Text
  category     String
  severity     String
  applicableTo String?  // Comma separated
  active       Boolean  @default(true)
  source       String   @default("manual")
  createdAt    DateTime @default(now())
}
