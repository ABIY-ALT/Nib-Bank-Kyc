generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum FindingCategory {
  IDENTITY
  DOCUMENTATION
  COMPLIANCE
  ACCOUNT_VALIDATION
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  password            String
  firstName           String
  lastName            String
  phoneNumber         String?
  status              UserStatus @default(ACTIVE)
  needsPasswordChange Boolean    @default(true)
  
  branchId            String?
  branchName          String?
  districtName        String?
  assignedBranches    String?    // Comma-separated for portfolio mapping
  
  branch              Branch?    @relation(fields: [branchId], references: [id])
  roles               UserRole[]
  
  submissionsCreated  KYC[]      @relation("CreatedBy")
  submissionsAssigned KYC[]      @relation("AssignedTo")
  memosUploaded       Memo[]
  
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  active      Boolean          @default(true)
  permissions RolePermission[]
  users       UserRole[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id    String           @id @default(cuid())
  slug  String           @unique
  name  String
  group String           // e.g., DASHBOARD, WORKFLOWS, SYSTEM
  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model District {
  id        String   @id @default(cuid())
  name      String   @unique
  branches  Branch[]
  createdAt DateTime @default(now())
}

model Branch {
  id         String   @id @default(cuid())
  name       String   @unique
  code       String   @unique
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  users      User[]
  kycRecords KYC[]
  createdAt  DateTime @default(now())
}

model KYC {
  id                String   @id // Institutional Format: BR-KYC-XXXX
  customerName      String
  status            String   // Uses KYC_STATUS constants
  entityType        String?  // INDIVIDUAL, COMPANY, etc.
  remarks           String?
  
  branchId          String
  branchName        String
  districtName      String?
  branch            Branch   @relation(fields: [branchId], references: [id])
  
  createdById       String
  createdBy         User     @relation("CreatedBy", fields: [createdById], references: [id])
  
  assignedToId      String?
  assignedTo        User?    @relation("AssignedTo", fields: [assignedToId], references: [id])
  
  isExceptional     Boolean  @default(false)
  exceptionalStatus String   @default("None")
  
  isResubmitted     Boolean  @default(false)
  amendCycles       Int      @default(0)
  active            Boolean  @default(true)
  
  checklistState    Json?    // Stores verification progress
  commentHistory    Json?    // Detailed chronological audit trail
  
  memos             Memo[]
  submittedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Memo {
  id           String   @id @default(cuid())
  name         String
  type         String   // DOCUMENT, GOVERNANCE_MEMO
  fileUrl      String   // Path in root/uploads
  kycId        String
  kyc          KYC      @relation(fields: [kycId], references: [id])
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

model Finding {
  id           String          @id @default(cuid())
  code         String          @unique
  title        String
  description  String
  category     FindingCategory
  severity     FindingSeverity
  applicableTo String[]        // Array of entity types
  active       Boolean         @default(true)
  source       String          @default("manual") // manual or ai
  createdAt    DateTime        @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String?
  userName  String?
  action    String
  details   String
  ipAddress String?
  kycId     String?
  timestamp DateTime @default(now())
}

model GlobalSetting {
  id              String   @id @default("global")
  entityTypes     Json?    // Available account categories
  documentTypes   Json?    // Standardized document requirements
  guidelines      Json?    // Published methodology updates
  autoEscalation  Boolean  @default(true)
  escalationHours Int      @default(72)
  lastUpdated     DateTime @default(now())
}

model FollowUpVerification {
  id           String   @id @default(cuid())
  submissionId String
  customerName String
  branch       String
  officer      String
  accountType  String
  verifiedBy   String?
  verifiedAt   DateTime @default(now())
  result       String?  // Correct, Discrepancy
  remarks      String?
  status       String   @default("PENDING") // PENDING, COMPLETED
}
