
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SubmissionStatus {
  PENDING
  IN_REVIEW
  AMENDED
  APPROVED
  ESCALATED
  REJECTED
}

enum ExceptionalStatus {
  NONE
  AWAITING_DISTRICT
  AWAITING_DIRECTOR
  AWAITING_CHIEF
  AWAITING_DIVISION
  AWAITING_SUPERVISOR
  COMPLETED
  REJECTED
  CLARIFICATION_REQUIRED
}

enum FindingCategory {
  IDENTITY
  DOCUMENTATION
  COMPLIANCE
  ACCOUNT_VALIDATION
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id               String     @id
  email            String     @unique
  name             String
  phoneNumber      String?
  role             String     @default("BRANCH_OFFICER")
  status           UserStatus @default(ACTIVE)
  branchName       String?
  districtName     String?
  assignedBranches String[]   @default([])
  
  submissions      Submission[] @relation("SubmittedBy")
  reviews          Submission[] @relation("ReviewedBy")
  
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model RoleDefinition {
  id                   String   @id @default(cuid())
  name                 String   @unique
  canSubmit            Boolean  @default(false)
  canReview            Boolean  @default(false)
  canEscalate          Boolean  @default(false)
  canViewReports       Boolean  @default(false)
  canManageUsers       Boolean  @default(false)
  canManageSystem      Boolean  @default(false)
  canAccessPerformance Boolean  @default(false)
  canAccessFollowUp    Boolean  @default(false)
  canAccessArchive     Boolean  @default(false)
  createdAt            DateTime @default(now())
}

model Submission {
  id                String            @id
  customerName      String
  entityType        String
  branchName        String
  districtName      String
  status            SubmissionStatus  @default(PENDING)
  submittedAt       DateTime          @default(now())
  submittedById     String
  submittedBy       User              @relation("SubmittedBy", fields: [submittedById], references: [id])
  
  reviewedAt        DateTime?
  reviewedById      String?
  reviewedBy        User?             @relation("ReviewedBy", fields: [reviewedById], references: [id])
  
  remarks           String?
  isResubmitted     Boolean           @default(false)
  amendmentCycles   Int               @default(0)
  isExceptional     Boolean           @default(false)
  exceptionalStatus ExceptionalStatus @default(NONE)
  exceptionalData   Json?
  commentHistory    Json?
  checklistState    Json?
  
  documents         Document[]
  bundleDownloads   BundleDownload[]
}

model Document {
  id           String     @id @default(cuid())
  name         String
  type         String
  url          String
  status       String     @default("Current")
  uploadedAt   DateTime   @default(now())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id])
}

model BundleDownload {
  id             String     @id @default(cuid())
  performedBy    String
  timestamp      DateTime   @default(now())
  bundleName     String
  sourceDistrict String
  sourceBranch   String
  submissionId   String
  submission     Submission @relation(fields: [submissionId], references: [id])
}

model FollowUpVerification {
  id           String   @id @default(cuid())
  submissionId String   @unique
  customerName String
  branch       String
  officer      String
  accountType  String
  verifiedBy   String?
  verifiedAt   DateTime?
  result       String?
  remarks      String?
  status       String   @default("PENDING")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  userEmail String
  userName  String?
  action    String
  ipAddress String
  details   String
  timestamp DateTime @default(now())
}

model Finding {
  id           String          @id @default(cuid())
  code         String          @unique
  title        String
  description  String
  category     FindingCategory
  severity     FindingSeverity
  applicableTo String[]
  active       Boolean         @default(true)
  source       String          @default("manual")
  createdAt    DateTime        @default(now())
}

model District {
  id       String   @id @default(cuid())
  name     String   @unique
  branches Branch[]
}

model Branch {
  id           String   @id @default(cuid())
  name         String   @unique
  code         String?
  districtName String
  district     District @relation(fields: [districtName], references: [name])
}

model GlobalSetting {
  id               String   @id @default("global")
  autoEscalation   Boolean  @default(true)
  escalationHours  Int      @default(72)
  strictSla        Boolean  @default(true)
  slaHours         Int      @default(24)
  documentTypes    Json?
  entityTypes      Json?
  guidelines       Json?
  updatedBy        String?
  lastUpdated      DateTime @default(now())
}
