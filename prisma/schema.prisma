
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BRANCH_OFFICER
  KYC_OFFICER
  SUPERVISOR
  BRANCH_BANKING_DIRECTOR
  ADMIN
  BRANCH_MANAGER
  DISTRICT_DIRECTOR
  DIVISION_MANAGER
  CHIEF_RETAIL_SME_OFFICER
  FOLLOW_UP_TEAM
  CHIEF
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SubmissionStatus {
  PENDING
  IN_REVIEW
  AMENDED
  APPROVED
  ESCALATED
  REJECTED
}

enum ExceptionalStatus {
  NONE
  AWAITING_DISTRICT
  AWAITING_DIRECTOR
  AWAITING_CHIEF
  AWAITING_DIVISION
  AWAITING_SUPERVISOR
  COMPLETED
  REJECTED
  CLARIFICATION_REQUIRED
}

enum FindingCategory {
  IDENTITY
  DOCUMENTATION
  COMPLIANCE
  ACCOUNT_VALIDATION
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model District {
  id        String   @id @default(cuid())
  name      @unique String
  branches  Branch[]
  users     User[]
  createdAt DateTime @default(now())
}

model Branch {
  id          String       @id @default(cuid())
  name        @unique String
  code        String?      @unique
  districtId  String
  district    District     @relation(fields: [districtId], references: [id])
  users       User[]
  submissions Submission[]
  createdAt   DateTime     @default(now())
}

model User {
  id                  String      @id
  email               String      @unique
  name                String
  phoneNumber         String?
  role                UserRole    @default(BRANCH_OFFICER)
  status              UserStatus  @default(ACTIVE)
  branchId            String?
  branch              Branch?     @relation(fields: [branchId], references: [id])
  districtId          String?
  district            District?   @relation(fields: [districtId], references: [id])
  assignedBranches    String[]    // Names of branches for KYC Officers
  needsPasswordChange Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  submissions         Submission[] @relation("SubmittedBy")
  reviews             Submission[] @relation("ReviewedBy")
}

model Submission {
  id                String            @id
  customerName      String
  customerId        String?
  entityType        String
  branchId          String
  branch            Branch            @relation(fields: [branchId], references: [id])
  district          String
  submittedById     String
  submittedBy       User              @relation("SubmittedBy", fields: [submittedById], references: [id])
  submittedAt       DateTime          @default(now())
  status            SubmissionStatus  @default(PENDING)
  remarks           String?
  isResubmitted     Boolean           @default(false)
  resubmittedAt     DateTime?
  amendmentCycles   Int               @default(0)
  reviewedById      String?
  reviewedBy        User?             @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt        DateTime?
  
  // Exceptional / Hierarchy Flow
  isExceptional     Boolean           @default(false)
  exceptionalStatus ExceptionalStatus @default(NONE)
  exceptionalData   Json?             // Stores reasoning, justification, etc.
  
  checklistState    Json?             // Verification checklist values
  documents         Document[]
  comments          Comment[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model Document {
  id           String     @id @default(cuid())
  name         String
  type         String
  url          String
  status       String     @default("Current")
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id])
  uploadedAt   DateTime   @default(now())
}

model Comment {
  id           String     @id @default(cuid())
  role         String
  performedBy  String
  comment      String
  action       String
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id])
  timestamp    DateTime   @default(now())
}

model RoleDefinition {
  id          String   @id
  name        String   @unique
  permissions Json     // Stores the PermissionSet object
  createdAt   DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  userEmail String
  action    String
  details   String?
  ipAddress String?
  timestamp DateTime @default(now())
}

model FollowUpVerification {
  id           String   @id @default(cuid())
  submissionId String
  customerName String
  branch       String
  officer      String
  accountType  String
  verifiedBy   String?
  verifiedAt   DateTime?
  result       String?  // "Correct" | "Discrepancy"
  remarks      String?
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
}

model BundleDownload {
  id             String   @id @default(cuid())
  submissionId   String
  performedBy    String
  bundleName     String
  sourceDistrict String
  sourceBranch   String
  timestamp      DateTime @default(now())
}

model KYCFinding {
  id           String          @id @default(cuid())
  code         String          @unique
  title        String
  description  String
  category     FindingCategory
  severity     Severity
  applicableTo String[]        // List of entity types
  active       Boolean         @default(true)
  source       String          @default("manual")
  createdAt    DateTime        @default(now())
}
