generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum KYCStatus {
  SUBMITTED
  IN_REVIEW
  ACTION_REQUIRED
  APPROVED
  ESCALATED
  REJECTED
}

enum AuditAction {
  CREATE
  UPDATE
  STATUS_CHANGE
  DELETE
  LOGIN
  LOGOUT
}

enum FindingCategory {
  IDENTITY
  DOCUMENTATION
  COMPLIANCE
  ACCOUNT_VALIDATION
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model District {
  id       String   @id @default(cuid())
  name     String   @unique
  branches Branch[]
}

model Branch {
  id         String   @id @default(cuid())
  name       String   @unique
  code       String   @unique
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  users      User[]
  kycRecords KYC[]
}

model User {
  id               String     @id @default(cuid())
  firebaseUid      String     @unique
  email            String     @unique
  firstName        String
  lastName         String
  phoneNumber      String?
  status           UserStatus @default(ACTIVE)
  branchId         String?
  branch           Branch?    @relation(fields: [branchId], references: [id])
  assignedBranches String[]   @default([])
  roles            UserRole[]
  kycCreated       KYC[]      @relation("CreatedBy")
  kycAssigned      KYC[]      @relation("AssignedTo")
  auditLogs        AuditLog[]
  memosUploaded    Memo[]
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  active      Boolean          @default(true)
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id    String           @id @default(cuid())
  slug  String           @unique
  name  String
  group String
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model KYC {
  id               String      @id
  customerName     String
  customerIdNumber String
  branchId         String
  branch           Branch      @relation(fields: [branchId], references: [id])
  createdById      String
  createdBy        User        @relation("CreatedBy", fields: [createdById], references: [id])
  assignedToId     String?
  assignedTo       User?       @relation("AssignedTo", fields: [assignedToId], references: [id])
  status           KYCStatus   @default(SUBMITTED)
  entityType       String?
  commentHistory   Json?       @default("[]")
  amendCycles      Int         @default(0)
  isResubmitted    Boolean     @default(false)
  isExceptional    Boolean     @default(false)
  active           Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  memos            Memo[]
  auditLogs        AuditLog[]
}

model Memo {
  id           String   @id @default(cuid())
  name         String
  type         String
  fileUrl      String
  kycId        String
  kyc          KYC      @relation(fields: [kycId], references: [id])
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  kycId     String?
  kyc       KYC?        @relation(fields: [kycId], references: [id])
  action    AuditAction
  details   String
  metadata  Json?
  timestamp DateTime    @default(now())
}

model GlobalSetting {
  id              String   @id @default("global")
  autoEscalation  Boolean  @default(true)
  escalationHours Int      @default(72)
  strictSla       Boolean  @default(true)
  slaHours        Int      @default(24)
  documentTypes   Json?    @default("[]")
  entityTypes     Json?    @default("[]")
  guidelines      Json?    @default("[]")
  updatedBy       String?
  lastUpdated     DateTime @default(now())
}

model Finding {
  id           String          @id @default(cuid())
  code         String          @unique
  title        String
  description  String
  category     FindingCategory
  severity     FindingSeverity
  applicableTo String[]        @default([])
  active       Boolean         @default(true)
  source       String          @default("manual")
  createdAt    DateTime        @default(now())
}

model FollowUpVerification {
  id           String   @id @default(cuid())
  submissionId String   @unique
  customerName String
  branch       String
  officer      String
  accountType  String
  verifiedBy   String?
  verifiedAt   DateTime @default(now())
  result       String?
  remarks      String?
  status       String   @default("PENDING")
}
