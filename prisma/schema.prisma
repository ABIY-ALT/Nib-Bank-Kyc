datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id                  String      @id @default(uuid())
  email               String      @unique
  password            String
  firstName           String
  lastName            String
  phoneNumber         String?
  status              UserStatus  @default(ACTIVE)
  needsPasswordChange Boolean     @default(true)
  
  branchId            String?
  branch              Branch?     @relation(fields: [branchId], references: [id])
  
  // Portfolios for Specialists (Stored as comma-separated string for high-velocity lookups)
  assignedBranches    String?     @db.Text
  
  roles               UserRole[]
  
  createdKycs         KYC[]       @relation("CreatedBy")
  assignedKycs        KYC[]       @relation("AssignedTo")
  memos               Memo[]
  auditLogs           AuditLog[]
  
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?          @db.Text
  active      Boolean          @default(true)
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id    String           @id @default(uuid())
  slug  String           @unique
  name  String
  group String
  roles RolePermission[]
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model District {
  id       String   @id @default(uuid())
  name     String   @unique
  branches Branch[]
}

model Branch {
  id         String   @id @default(uuid())
  name       String   @unique
  code       String?  @unique
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  users      User[]
  kycs       KYC[]
}

model KYC {
  id                String   @id // Form provided or generated ID
  customerName      String
  status            String   // Robust string-based status
  
  entityType        String?
  branchId          String
  branch            Branch   @relation(fields: [branchId], references: [id])
  branchName        String   
  
  createdById       String
  createdBy         User     @relation("CreatedBy", fields: [createdById], references: [id])
  
  assignedToId      String?
  assignedTo        User?    @relation("AssignedTo", fields: [assignedToId], references: [id])
  
  submittedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt
  active            Boolean  @default(true)
  
  // Metadata Blobs
  checklistState    String?  @db.Text 
  commentHistory    String?  @db.Text 
  
  // Operational Metadata
  isExceptional     Boolean  @default(false)
  exceptionalStatus String   @default("None")
  amendCycles       Int      @default(0)
  isResubmitted     Boolean  @default(false)
  
  memos             Memo[]
  auditLogs         AuditLog[]
}

model Memo {
  id           String   @id @default(uuid())
  name         String
  type         String
  fileUrl      String
  
  kycId        String
  kyc          KYC      @relation(fields: [kycId], references: [id], onDelete: Cascade)
  
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  
  createdAt    DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  userEmail String?
  userName  String?
  
  kycId     String?
  kyc       KYC?     @relation(fields: [kycId], references: [id])
  
  action    String
  details   String   @db.Text
  ipAddress String?
  metadata  String?  @db.Text 
  timestamp DateTime @default(now())
}

enum FindingCategory {
  IDENTITY
  DOCUMENTATION
  COMPLIANCE
  ACCOUNT_VALIDATION
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Finding {
  id           String          @id @default(uuid())
  code         String          @unique
  title        String
  description  String          @db.Text
  category     FindingCategory
  severity     FindingSeverity
  applicableTo String?         @db.Text 
  active       Boolean         @default(true)
  source       String          @default("manual")
  createdAt    DateTime        @default(now())
}

model FollowUpVerification {
  id           String   @id @default(uuid())
  submissionId String
  customerName String
  branch       String
  officer      String
  accountType  String
  verifiedBy   String?
  verifiedAt   DateTime @default(now())
  result       String?  
  remarks      String?  @db.Text
  status       String   @default("PENDING")
}

model GlobalSetting {
  id              String   @id @default("global")
  autoEscalation  Boolean  @default(true)
  escalationHours Int      @default(72)
  strictSla       Boolean  @default(true)
  slaHours        Int      @default(24)
  documentTypes   String?  @db.Text 
  entityTypes     String?  @db.Text 
  guidelines      String?  @db.Text 
  lastUpdated     DateTime @default(now())
}
