// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum FindingCategory {
  IDENTITY
  DOCUMENTATION
  COMPLIANCE
  ACCOUNT_VALIDATION
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Permission {
  id    String @id @default(cuid())
  slug  String @unique
  name  String
  group String
  roles RolePermission[]
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       UserRole[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model District {
  id       String   @id @default(cuid())
  name     String   @unique
  branches Branch[]
}

model Branch {
  id         String   @id @default(cuid())
  name       String   @unique
  code       String?  @unique
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  users      User[]
  kycs       KYC[]
}

model User {
  id                  String     @id @default(cuid())
  firstName           String
  lastName            String
  email               String     @unique
  password            String
  phoneNumber         String?
  status              UserStatus @default(ACTIVE)
  needsPasswordChange Boolean    @default(true)
  branchId            String?
  branchName          String?
  districtName        String?
  assignedBranches    String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  branch              Branch?    @relation(fields: [branchId], references: [id])
  roles               UserRole[]
  kycsCreated         KYC[]      @relation("KYCCreator")
  kycsAssigned        KYC[]      @relation("KYCAssignee")
  memos               Memo[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model KYC {
  id                String   @id
  customerName      String
  status            String
  isExceptional     Boolean  @default(false)
  exceptionalStatus String   @default("None")
  entityType        String?
  remarks           String?
  amendCycles       Int      @default(0)
  isResubmitted     Boolean  @default(false)
  checklistState    Json?
  commentHistory    Json?
  active            Boolean  @default(true)
  submittedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdById       String
  assignedToId      String?
  branchId          String
  branchName        String
  districtName      String?
  
  createdBy  User    @relation("KYCCreator", fields: [createdById], references: [id])
  assignedTo User?   @relation("KYCAssignee", fields: [assignedToId], references: [id])
  branch     Branch  @relation(fields: [branchId], references: [id])
  memos      Memo[]
  audits     AuditLog[]
}

model Memo {
  id           String   @id @default(cuid())
  name         String
  type         String
  fileUrl      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  kycId        String
  uploadedById String
  
  kyc        KYC  @relation(fields: [kycId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedById], references: [id])
}

model FollowUpVerification {
  id           String   @id @default(cuid())
  submissionId String
  customerName String
  branch       String
  officer      String
  accountType  String
  verifiedBy   String?
  verifiedAt   DateTime @default(now())
  result       String?
  remarks      String?
  status       String   @default("PENDING")
}

model GlobalSetting {
  id              String   @id @default("global")
  entityTypes     Json?
  documentTypes   Json?
  guidelines      Json?
  autoEscalation  Boolean  @default(true)
  escalationHours Int      @default(72)
  lastUpdated     DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String?
  userName  String?
  action    String
  details   String
  ipAddress String?
  timestamp DateTime @default(now())
  kycId     String?
  
  kyc       KYC? @relation(fields: [kycId], references: [id])
}

model Finding {
  id           String          @id @default(cuid())
  code         String          @unique
  title        String
  description  String
  category     FindingCategory
  severity     FindingSeverity
  applicableTo String[]
  active       Boolean         @default(true)
  source       String          @default("manual")
}
