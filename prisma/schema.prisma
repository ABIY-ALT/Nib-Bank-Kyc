generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////////
// ENUMS (Used for fixed lifecycle states)
//////////////////////////////////////////////////////

enum KYCStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ACTION_REQUIRED
  RESUBMITTED
  ESCALATED
  GOVERNANCE_PENDING
  GOVERNANCE_APPROVED
  COMPLIANCE_REVIEW
  ACTIVE
  INACTIVE
  REJECTED
  FROZEN
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AuditAction {
  LOGIN
  CREATE
  UPDATE
  SUBMIT
  APPROVE
  REJECT
  ESCALATE
  FREEZE
  EXPORT
  STATUS_CHANGE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum FindingCategory {
  IDENTITY
  DOCUMENTATION
  COMPLIANCE
  ACCOUNT_VALIDATION
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

//////////////////////////////////////////////////////
// DYNAMIC RBAC TABLES
//////////////////////////////////////////////////////

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  active      Boolean          @default(true)
  permissions RolePermission[]
  users       UserRole[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id    String           @id @default(uuid())
  slug  String           @unique // e.g. CASE_SUBMIT
  name  String
  group String           // e.g. WORKFLOWS
  roles RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
}

//////////////////////////////////////////////////////
// INSTITUTIONAL STRUCTURE
//////////////////////////////////////////////////////

model District {
  id        String   @id @default(uuid())
  name      String   @unique
  branches  Branch[]
  createdAt DateTime @default(now())
}

model Branch {
  id         String   @id @default(uuid())
  name       String
  code       String   @unique
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  users      User[]
  kycs       KYC[]
  createdAt  DateTime @default(now())
}

//////////////////////////////////////////////////////
// USER MODEL
//////////////////////////////////////////////////////

model User {
  id            String     @id @default(uuid())
  firebaseUid   String     @unique
  email         String     @unique
  firstName     String
  lastName      String
  phoneNumber   String?
  status        UserStatus @default(ACTIVE)
  branchId      String?
  branch        Branch?    @relation(fields: [branchId], references: [id])
  active        Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  roles         UserRole[]
  auditLogs     AuditLog[]
  kycsCreated   KYC[]      @relation("CreatedBy")
  kycsAssigned  KYC[]      @relation("AssignedTo")
}

//////////////////////////////////////////////////////
// KYC CORE MODEL
//////////////////////////////////////////////////////

model KYC {
  id               String      @id @default(uuid())
  customerName     String
  customerIdNumber String
  branchId         String
  branch           Branch      @relation(fields: [branchId], references: [id])

  status           KYCStatus   @default(SUBMITTED)
  riskLevel        RiskLevel   @default(LOW)
  entityType       String?     @default("individual")
  
  createdById      String
  createdBy        User        @relation("CreatedBy", fields: [createdById], references: [id])

  assignedToId     String?
  assignedTo       User?       @relation("AssignedTo", fields: [assignedToId], references: [id])

  governanceFlow   GovernanceFlow?
  amendments       Amendment[]
  memos            Memo[]
  auditLogs        AuditLog[]
  auditSamplings   AuditSampling[]

  amendCycles      Int         @default(0)
  isResubmitted    Boolean     @default(false)
  slaDueAt         DateTime?
  approvedAt       DateTime?

  active           Boolean     @default(true)

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model Amendment {
  id          String   @id @default(uuid())
  kycId       String
  kyc         KYC      @relation(fields: [kycId], references: [id])
  requestedBy String
  resolved    Boolean  @default(false)
  comment     String
  createdAt   DateTime @default(now())
}

model GovernanceFlow {
  id              String   @id @default(uuid())
  kycId           String   @unique
  kyc             KYC      @relation(fields: [kycId], references: [id])

  districtApproved         Boolean @default(false)
  branchBankingApproved    Boolean @default(false)
  chiefOfficerApproved     Boolean @default(false)
  divisionManagerApproved  Boolean @default(false)
  supervisorApproved       Boolean @default(false)

  completed       Boolean   @default(false)
  createdAt       DateTime  @default(now())
}

model Memo {
  id           String   @id @default(uuid())
  kycId        String
  kyc          KYC      @relation(fields: [kycId], references: [id])
  name         String?
  type         String?
  uploadedById String
  fileUrl      String
  createdAt    DateTime @default(now())
}

model AuditLog {
  id        String      @id @default(uuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id])
  kycId     String?
  kyc       KYC?        @relation(fields: [kycId], references: [id])
  action    AuditAction
  details   String?
  ipAddress String?
  metadata  Json?
  timestamp DateTime    @default(now())
}

model AuditSampling {
  id          String   @id @default(uuid())
  kycId       String
  kyc         KYC      @relation(fields: [kycId], references: [id])
  reviewedBy  String
  discrepancy Boolean  @default(false)
  remarks     String?
  score       Int?
  createdAt   DateTime @default(now())
}

model Finding {
  id           String          @id @default(uuid())
  code         String          @unique
  title        String
  description  String
  category     FindingCategory @default(DOCUMENTATION)
  severity     FindingSeverity @default(LOW)
  applicableTo String[]        // Array of entity types
  active       Boolean         @default(true)
  source       String?         @default("manual")
  createdAt    DateTime        @default(now())
}

model GlobalSetting {
  id               String   @id @default("global")
  autoEscalation   Boolean  @default(true)
  escalationHours  Int      @default(72)
  strictSla        Boolean  @default(true)
  slaHours         Int      @default(24)
  documentTypes    Json?    @default("[]")
  entityTypes      Json?    @default("[]")
  guidelines       Json?    @default("[]")
  lastUpdated      DateTime @default(now())
  updatedBy        String?
}
