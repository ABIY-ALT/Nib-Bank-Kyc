// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum KYCStatus {
  SUBMITTED
  IN_REVIEW
  ACTION_REQUIRED
  APPROVED
  REJECTED
  ESCALATED
}

enum AuditAction {
  CREATE
  UPDATE
  STATUS_CHANGE
  DOWNLOAD
  DELETE
}

model District {
  id       String   @id @default(cuid())
  name     String   @unique
  branches Branch[]
}

model Branch {
  id         String   @id @default(cuid())
  name       String   @unique
  code       String?  @unique
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  users      User[]
  kycCases   KYC[]
}

model User {
  id               String     @id
  firebaseUid      String     @unique
  email            String     @unique
  firstName        String
  lastName         String
  phoneNumber      String?
  status           UserStatus @default(ACTIVE)
  branchId         String?
  branch           Branch?    @relation(fields: [branchId], references: [id])
  assignedBranches String[]   @default([])
  roles            UserRole[]
  submissions      KYC[]      @relation("CreatedBy")
  assignments      KYC[]      @relation("AssignedTo")
  auditLogs        AuditLog[]
  memos            Memo[]
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  active      Boolean          @default(true)
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id    String           @id @default(cuid())
  slug  String           @unique
  name  String
  group String
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model KYC {
  id               String      @id
  customerName     String
  customerIdNumber String
  branchId         String
  branchName       String
  status           KYCStatus   @default(SUBMITTED)
  entityType       String?
  active           Boolean     @default(true)
  isExceptional    Boolean     @default(false)
  isResubmitted    Boolean     @default(false)
  amendCycles      Int         @default(0)
  commentHistory   Json?       @default("[]")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  submittedAt      DateTime    @default(now())
  createdById      String
  assignedToId     String?
  branch           Branch      @relation(fields: [branchId], references: [id])
  createdBy        User        @relation("CreatedBy", fields: [createdById], references: [id])
  assignedTo       User?       @relation("AssignedTo", fields: [assignedToId], references: [id])
  memos            Memo[]
  auditLogs        AuditLog[]
}

model Memo {
  id           String   @id @default(cuid())
  name         String
  type         String
  fileUrl      String
  kycId        String
  uploadedById String
  createdAt    DateTime @default(now())
  kyc          KYC      @relation(fields: [kycId], references: [id])
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String
  kycId     String?
  action    AuditAction
  details   String
  metadata  Json?
  timestamp DateTime    @default(now())
  ipAddress String?
  user      User        @relation(fields: [userId], references: [id])
  kyc       KYC?        @relation(fields: [kycId], references: [id])
}

model GlobalSetting {
  id               String   @id @default("global")
  autoEscalation   Boolean  @default(true)
  escalationHours  Int      @default(72)
  strictSla        Boolean  @default(true)
  slaHours         Int      @default(24)
  documentTypes    Json?    @default("[]")
  entityTypes      Json?    @default("[]")
  guidelines       Json?    @default("[]")
  lastUpdated      DateTime @default(now())
  updatedBy        String?
}

model Finding {
  id           String          @id @default(cuid())
  code         String          @unique
  title        String
  description  String
  category     FindingCategory
  severity     FindingSeverity
  applicableTo String[]        @default([])
  active       Boolean         @default(true)
  source       String          @default("manual")
  createdAt    DateTime        @default(now())
}

enum FindingCategory {
  IDENTITY
  DOCUMENTATION
  COMPLIANCE
  ACCOUNT_VALIDATION
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model FollowUpVerification {
  id           String   @id @default(cuid())
  submissionId String
  customerName String
  branch       String
  officer      String
  accountType  String
  verifiedBy   String?
  verifiedAt   DateTime @default(now())
  result       String?
  remarks      String?
  status       String   @default("PENDING")
}
