// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum KYCStatus {
  SUBMITTED
  IN_REVIEW
  ACTION_REQUIRED
  APPROVED
  ESCALATED
  REJECTED
}

enum AuditAction {
  CREATE
  STATUS_CHANGE
  BRANCH_TRANSFER
  ROLE_TRANSITION
  CONFIG_CHANGE
}

enum FindingCategory {
  IDENTITY
  DOCUMENTATION
  COMPLIANCE
  ACCOUNT_VALIDATION
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id               String     @id @default(uuid())
  firebaseUid      String     @unique
  email            String     @unique
  firstName        String
  lastName         String
  phoneNumber      String?
  status           UserStatus @default(ACTIVE)
  passwordHash     String?
  branchId         String?
  branch           Branch?    @relation(fields: [branchId], references: [id])
  assignedBranches String[]   @default([])
  roles            UserRole[]
  
  submissionsCreated  KYC[] @relation("CreatedBy")
  submissionsAssigned KYC[] @relation("AssignedTo")
  auditLogs           AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  active      Boolean          @default(true)
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id    String           @id @default(uuid())
  slug  String           @unique
  name  String
  group String
  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model District {
  id       String   @id @default(uuid())
  name     String   @unique
  branches Branch[]
}

model Branch {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String?  @unique
  districtId  String
  district    District @relation(fields: [districtId], references: [id])
  users       User[]
  submissions KYC[]
}

model KYC {
  id               String    @id
  customerIdNumber String?
  customerName     String
  status           KYCStatus @default(SUBMITTED)
  entityType       String
  branchId         String
  branchName       String
  branch           Branch    @relation(fields: [branchId], references: [id])
  
  createdById      String
  createdBy        User      @relation("CreatedBy", fields: [createdById], references: [id])
  
  assignedToId     String?
  assignedTo       User?     @relation("AssignedTo", fields: [assignedToId], references: [id])
  
  isExceptional    Boolean   @default(false)
  isResubmitted    Boolean   @default(false)
  amendCycles      Int       @default(0)
  active           Boolean   @default(true)
  
  checklistState   Json      @default("{}")
  commentHistory   Json      @default("[]")
  
  memos            KYCMemo[]
  auditLogs        AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model KYCMemo {
  id           String   @id @default(uuid())
  kycId        String
  kyc          KYC      @relation(fields: [kycId], references: [id])
  name         String
  type         String
  fileUrl      String
  uploadedById String
  createdAt    DateTime @default(now())
}

model AuditLog {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  userEmail String?
  userName  String?
  kycId     String?
  kyc       KYC?        @relation(fields: [kycId], references: [id])
  action    AuditAction
  details   String
  metadata  Json        @default("{}")
  ipAddress String?
  timestamp DateTime    @default(now())
}

model Finding {
  id           String          @id @default(uuid())
  code         String          @unique
  title        String
  description  String
  category     FindingCategory
  severity     FindingSeverity
  applicableTo String[]        @default([])
  active       Boolean         @default(true)
  source       String          @default("manual")
  createdAt    DateTime        @default(now())
}

model FollowUpVerification {
  id           String   @id @default(uuid())
  submissionId String
  customerName String
  branch       String
  officer      String
  accountType  String
  verifiedBy   String?
  verifiedAt   DateTime @default(now())
  result       String?
  remarks      String?
  status       String   @default("PENDING")
}

model GlobalSetting {
  id               String   @id @default("global")
  autoEscalation   Boolean  @default(true)
  escalationHours  Int      @default(72)
  strictSla        Boolean  @default(true)
  slaHours         Int      @default(24)
  documentTypes    Json     @default("[]")
  entityTypes      Json     @default("[]")
  guidelines       Json     @default("[]")
  lastUpdated      DateTime @default(now())
  updatedBy        String?
}
