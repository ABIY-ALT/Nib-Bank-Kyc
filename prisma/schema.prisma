
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BRANCH_OFFICER
  KYC_OFFICER
  SUPERVISOR
  BRANCH_BANKING_DIRECTOR
  ADMIN
  BRANCH_MANAGER
  DISTRICT_DIRECTOR
  DIVISION_MANAGER
  CHIEF_RETAIL_SME_OFFICER
  FOLLOW_UP_TEAM
  CHIEF
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SubmissionStatus {
  PENDING
  IN_REVIEW
  AMENDED
  APPROVED
  ESCALATED
  REJECTED
}

enum ExceptionalStatus {
  NONE
  AWAITING_DISTRICT
  AWAITING_DIRECTOR
  AWAITING_CHIEF
  AWAITING_DIVISION
  AWAITING_SUPERVISOR
  COMPLETED
  REJECTED
  CLARIFICATION_REQUIRED
}

enum FindingCategory {
  IDENTITY
  DOCUMENTATION
  COMPLIANCE
  ACCOUNT_VALIDATION
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model District {
  id        String   @id @default(cuid())
  name      String   @unique
  branches  Branch[]
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id          String       @id @default(cuid())
  name        String       @unique
  code        String?      @unique
  district    District     @relation(fields: [districtId], references: [id])
  districtId  String
  users       User[]
  submissions Submission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model User {
  id                  String       @id
  email               String       @unique
  name                String
  phoneNumber         String?
  role                UserRole     @default(BRANCH_OFFICER)
  status              UserStatus   @default(ACTIVE)
  branch              Branch?      @relation(fields: [branchId], references: [id])
  branchId            String?
  district            District?    @relation(fields: [districtId], references: [id])
  districtId          String?
  assignedBranches    String[]     @default([])
  needsPasswordChange Boolean      @default(false)
  submissions         Submission[] @relation("SubmittedBy")
  reviews             Submission[] @relation("ReviewedBy")
  auditLogs           AuditLog[]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

model Submission {
  id                String            @id
  customerName      String
  customerId        String?
  entityType        String?
  status            SubmissionStatus  @default(PENDING)
  branch            Branch            @relation(fields: [branchId], references: [id])
  branchId          String
  district          String
  submittedBy       User              @relation("SubmittedBy", fields: [submittedById], references: [id])
  submittedById     String
  submittedAt       DateTime          @default(now())
  reviewedBy        User?             @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedById      String?
  reviewedAt        DateTime?
  remarks           String?           @db.Text
  amendmentCycles   Int               @default(0)
  isResubmitted     Boolean           @default(false)
  resubmittedAt     DateTime?
  isExceptional     Boolean           @default(false)
  exceptionalStatus ExceptionalStatus @default(NONE)
  checklistState    Json?
  documents         Document[]
  comments          Comment[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model Document {
  id           String     @id @default(cuid())
  name         String
  type         String
  url          String
  status       String     @default("Current")
  submission   Submission @relation(fields: [submissionId], references: [id])
  submissionId String
  uploadedAt   DateTime   @default(now())
}

model Comment {
  id           String     @id @default(cuid())
  role         String
  performedBy  String
  comment      String     @db.Text
  action       String
  submission   Submission @relation(fields: [submissionId], references: [id])
  submissionId String
  timestamp    DateTime   @default(now())
}

model RoleDefinition {
  id                String  @id
  name              String  @unique
  canSubmit         Boolean @default(false)
  canReview         Boolean @default(false)
  canEscalate       Boolean @default(false)
  canViewReports    Boolean @default(false)
  canManageUsers    Boolean @default(false)
  canManageSystem   Boolean @default(false)
}

model AuditLog {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  action    String
  details   String?  @db.Text
  ipAddress String?
  timestamp DateTime @default(now())
}

model KYCFinding {
  id           String          @id @default(cuid())
  code         String          @unique
  title        String
  description  String          @db.Text
  category     FindingCategory
  severity     Severity
  applicableTo String[]
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
}
