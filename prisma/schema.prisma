
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BRANCH_OFFICER
  KYC_OFFICER
  SUPERVISOR
  BRANCH_BANKING_DIRECTOR
  ADMIN
  BRANCH_MANAGER
  DISTRICT_DIRECTOR
  DIVISION_MANAGER
  CHIEF_RETAIL_SME_OFFICER
  FOLLOW_UP_TEAM
  CHIEF
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SubmissionStatus {
  PENDING
  IN_REVIEW
  AMENDED
  APPROVED
  ESCALATED
  REJECTED
}

enum ExceptionalStatus {
  NONE
  AWAITING_DISTRICT
  AWAITING_DIRECTOR
  AWAITING_CHIEF
  AWAITING_DIVISION
  AWAITING_SUPERVISOR
  COMPLETED
  REJECTED
  CLARIFICATION_REQUIRED
}

enum FindingCategory {
  IDENTITY
  DOCUMENTATION
  COMPLIANCE
  ACCOUNT_VALIDATION
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model District {
  id        String   @id @default(cuid())
  name      String   @unique
  branches  Branch[]
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id          String       @id @default(cuid())
  name        String       @unique
  code        String?      @unique
  district    District     @relation(fields: [districtId], references: [id])
  districtId  String
  users       User[]
  submissions Submission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model User {
  id                  String      @id @default(cuid())
  name                String
  email               String      @unique
  phoneNumber         String?
  role                UserRole    @default(BRANCH_OFFICER)
  status              UserStatus  @default(ACTIVE)
  branch              Branch?     @relation(fields: [branchId], references: [id])
  branchId            String?
  district            District?   @relation(fields: [districtId], references: [id])
  districtId          String?
  assignedBranches    String[]
  needsPasswordChange Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  auditLogs           AuditLog[]
}

model Submission {
  id                String            @id @default(cuid())
  customerId        String?
  customerName      String
  branch            Branch            @relation(fields: [branchId], references: [id])
  branchId          String
  districtName      String
  submittedBy       String
  submittedAt       DateTime          @default(now())
  status            SubmissionStatus  @default(PENDING)
  isExceptional     Boolean           @default(false)
  exceptionalStatus ExceptionalStatus @default(NONE)
  
  exceptionReason   String?
  justification     String?
  memoUrl           String?
  initiatedBy       String?
  initiatedAt       DateTime?
  
  remarks           String?
  entityType        String?
  amendmentCycles   Int               @default(0)
  isResubmitted     Boolean           @default(false)
  resubmittedAt     DateTime?
  checklistState    Json?
  
  documents         Document[]
  comments          Comment[]
  updatedAt         DateTime          @updatedAt
}

model Document {
  id           String     @id @default(cuid())
  name         String
  type         String
  url          String
  status       String     @default("Current")
  submission   Submission @relation(fields: [submissionId], references: [id])
  submissionId String
  uploadedAt   DateTime   @default(now())
}

model Comment {
  id           String     @id @default(cuid())
  role         String
  performedBy  String
  timestamp    DateTime   @default(now())
  comment      String
  action       String
  submission   Submission @relation(fields: [submissionId], references: [id])
  submissionId String
}

model RoleDefinition {
  id               String  @id @default(cuid())
  name             String  @unique
  canSubmit        Boolean @default(false)
  canReview        Boolean @default(false)
  canEscalate      Boolean @default(false)
  canViewReports   Boolean @default(false)
  canManageUsers   Boolean @default(false)
  canManageSystem  Boolean @default(false)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  ipAddress String?
  details   String?
  timestamp DateTime @default(now())
}

model FollowUpVerification {
  id           String   @id @default(cuid())
  submissionId String
  customerName String
  branch       String
  officer      String
  accountType  String
  verifiedBy   String?
  verifiedAt   DateTime?
  result       String?
  remarks      String?
  status       String   @default("Pending")
}

model BundleDownload {
  id             String   @id @default(cuid())
  submissionId   String
  performedBy    String
  timestamp      DateTime @default(now())
  bundleName     String
  sourceDistrict String
  sourceBranch   String
}

model KYCFinding {
  id           String          @id @default(cuid())
  code         String          @unique
  title        String
  description  String
  category     FindingCategory
  severity     Severity
  applicableTo String[]
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  source       String          @default("manual")
}
