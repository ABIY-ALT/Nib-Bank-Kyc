// Prisma schema for Nib Bank KYC Flow
// Standardized for PostgreSQL with institutional enums

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BRANCH_OFFICER
  KYC_OFFICER
  SUPERVISOR
  BRANCH_BANKING_DIRECTOR
  ADMIN
  BRANCH_MANAGER
  DISTRICT_DIRECTOR
  DIVISION_MANAGER
  CHIEF_RETAIL_SME_OFFICER
  FOLLOW_UP_TEAM
  CHIEF
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SubmissionStatus {
  PENDING
  IN_REVIEW
  AMENDED
  APPROVED
  ESCALATED
  REJECTED
}

enum ExceptionalStatus {
  NONE
  AWAITING_DISTRICT
  AWAITING_DIRECTOR
  AWAITING_CHIEF
  AWAITING_DIVISION
  AWAITING_SUPERVISOR
  COMPLETED
  REJECTED
  CLARIFICATION_REQUIRED
}

model User {
  id                  String     @id
  email               String     @unique
  name                String
  role                UserRole   @default(BRANCH_OFFICER)
  status              UserStatus @default(ACTIVE)
  branchName          String?
  districtName        String?
  phoneNumber         String?
  needsPasswordChange Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  submissions         Submission[] @relation("SubmittedBy")
}

model District {
  id        String   @id @default(cuid())
  name      String   @unique
  branches  Branch[]
}

model Branch {
  id          String       @id @default(cuid())
  name        String       @unique
  code        String?      @unique
  district    District     @relation(fields: [districtId], references: [id])
  districtId  String
  submissions Submission[]
}

model Submission {
  id                String            @id
  customerName      String
  entityType        String
  status            SubmissionStatus  @default(PENDING)
  submittedAt       DateTime          @default(now())
  
  submittedBy       User              @relation("SubmittedBy", fields: [submittedById], references: [id])
  submittedById     String
  
  branch            Branch            @relation(fields: [branchId], references: [id])
  branchId          String
  
  districtName      String
  isExceptional     Boolean           @default(false)
  exceptionalStatus ExceptionalStatus @default(NONE)
  amendmentCycles   Int               @default(0)
  isResubmitted     Boolean           @default(false)
  resubmittedAt     DateTime?
}
