// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BRANCH_OFFICER
  KYC_OFFICER
  SUPERVISOR
  BRANCH_BANKING_DIRECTOR
  ADMIN
  BRANCH_MANAGER
  DISTRICT_DIRECTOR
  DIVISION_MANAGER
  CHIEF_RETAIL_SME_OFFICER
  FOLLOW_UP_TEAM
  CHIEF
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SubmissionStatus {
  PENDING
  IN_REVIEW
  AMENDED
  APPROVED
  ESCALATED
  REJECTED
}

enum ExceptionalStatus {
  NONE
  AWAITING_DISTRICT
  AWAITING_DIRECTOR
  AWAITING_CHIEF
  AWAITING_DIVISION
  AWAITING_SUPERVISOR
  COMPLETED
  REJECTED
  CLARIFICATION_REQUIRED
}

model User {
  id               String       @id
  email            String       @unique
  name             String
  role             UserRole     @default(BRANCH_OFFICER)
  status           UserStatus   @default(ACTIVE)
  branchName       String?
  districtName     String?
  assignedBranches String[]     @default([])
  needsPasswordChange Boolean   @default(false)
  
  submissions      Submission[] @relation("SubmittedBy")
  reviews          Submission[] @relation("ReviewedBy")
}

model District {
  id       String   @id @default(cuid())
  name     String   @unique
  branches Branch[]
}

model Branch {
  id           String   @id @default(cuid())
  name         String   @unique
  code         String?  @unique
  districtName String
  district     District @relation(fields: [districtName], references: [name])
}

model Submission {
  id                String           @id
  customerName      String
  entityType        String?
  branchName        String
  districtName      String
  status            SubmissionStatus @default(PENDING)
  
  submittedAt       DateTime         @default(now())
  submittedById     String
  submittedBy       User             @relation("SubmittedBy", fields: [submittedById], references: [id])
  
  reviewedAt        DateTime?
  reviewedById      String?
  reviewedBy        User?            @relation("ReviewedBy", fields: [reviewedById], references: [id])
  
  isResubmitted     Boolean          @default(false)
  resubmittedAt     DateTime?
  amendmentCycles   Int              @default(0)
  
  isExceptional     Boolean          @default(false)
  exceptionalStatus ExceptionalStatus @default(NONE)
  exceptionalData   Json?            // Store ExceptionalData structure
  
  remarks           String?
  commentHistory    Json?            // Store CommentHistoryEntry[]
  checklistState    Json?            // Store Record<string, boolean>
  
  documents         Document[]
  bundleDownloads   BundleDownload[]
}

model Document {
  id           String     @id @default(cuid())
  name         String
  type         String
  url          String
  uploadedAt   DateTime   @default(now())
  status       String     @default("Current")
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model BundleDownload {
  id             String     @id @default(cuid())
  performedBy    String
  timestamp      DateTime   @default(now())
  bundleName     String
  sourceDistrict String
  sourceBranch   String
  submissionId   String
  submission     Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model GlobalSetting {
  id               String   @id @default("global")
  autoEscalation   Boolean  @default(true)
  escalationHours  Int      @default(72)
  strictSla        Boolean  @default(true)
  slaHours         Int      @default(24)
  documentTypes    Json?    // Store ConfigItem[]
  entityTypes      Json?    // Store ConfigItem[]
  guidelines       Json?    // Store Guideline[]
  lastUpdated      DateTime @updatedAt
  updatedBy        String?
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  userEmail String
  action    String
  timestamp DateTime @default(now())
  ipAddress String?
  details   String?
}
