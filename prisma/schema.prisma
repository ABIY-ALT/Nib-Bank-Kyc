// This is your Prisma schema file,
// learn more it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --- IDENTITY & ACCESS MANAGEMENT ---

model User {
  id                  String      @id @default(uuid())
  email               String      @unique
  password            String
  firstName           String
  lastName            String
  phoneNumber         String?
  status              String      @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  needsPasswordChange Boolean     @default(false)
  
  branchId            String?
  branch              Branch?     @relation(fields: [branchId], references: [id])
  branchName          String?     // Denormalized for fast lookup
  
  assignedBranches    String      @default("[]") // JSON string array of branch names for specialists
  
  roles               UserRole[]
  
  createdKYCs         KYC[]       @relation("CreatedBy")
  assignedKYCs        KYC[]       @relation("AssignedTo")
  auditLogs           AuditLog[]
  memos               Memo[]      @relation("UploadedBy")
  
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  active      Boolean          @default(true)
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id    String           @id @default(uuid())
  slug  String           @unique
  name  String
  group String           @default("GENERAL")
  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

// --- KYC WORKFLOW ---

model KYC {
  id                String      @id // Custom ID: BRANCH-KYC-RANDOM
  customerName      String
  status            String      @default("SUBMITTED") // SUBMITTED, IN_REVIEW, ACTION_REQUIRED, APPROVED, REJECTED, ESCALATED
  entityType        String?     // INDIVIDUAL, COMPANY, etc.
  
  branchId          String
  branch            Branch      @relation(fields: [branchId], references: [id])
  branchName        String
  
  createdById       String
  createdBy         User        @relation("CreatedBy", fields: [createdById], references: [id])
  
  assignedToId      String?
  assignedTo        User?       @relation("AssignedTo", fields: [assignedToId], references: [id])
  
  isExceptional     Boolean     @default(false)
  exceptionalStatus String      @default("None") // AWAITING_DISTRICT, AWAITING_DIRECTOR, etc.
  
  isResubmitted     Boolean     @default(false)
  amendCycles       Int         @default(0)
  
  checklistState    String      @default("{}") // JSON string
  commentHistory    String      @default("[]") // JSON string array of CommentHistoryEntry
  
  memos             Memo[]
  auditLogs         AuditLog[]
  
  active            Boolean     @default(true)
  submittedAt       DateTime    @default(now())
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model Memo {
  id           String   @id @default(uuid())
  name         String
  type         String   // DOCUMENT, GOVERNANCE_MEMO
  fileUrl      String
  
  kycId        String
  kyc          KYC      @relation(fields: [kycId], references: [id])
  
  uploadedById String
  uploadedBy   User     @relation("UploadedBy", fields: [uploadedById], references: [id])
  
  createdAt    DateTime @default(now())
}

// --- HIERARCHY ---

model District {
  id       String   @id @default(uuid())
  name     String   @unique
  branches Branch[]
}

model Branch {
  id         String   @id @default(uuid())
  code       String   @unique
  name       String   @unique
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  users      User[]
  kycs       KYC[]
}

// --- GOVERNANCE & AUDIT ---

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  userEmail String?
  userName  String?
  kycId     String?
  kyc       KYC?     @relation(fields: [kycId], references: [id])
  action    String
  details   String
  ipAddress String?
  metadata  String?  // JSON string
  timestamp DateTime @default(now())
}

model GlobalSetting {
  id              String   @id @default("global")
  autoEscalation  Boolean  @default(true)
  escalationHours Int      @default(72)
  strictSla       Boolean  @default(true)
  slaHours        Int      @default(24)
  documentTypes   String   @default("[]") // JSON string array
  entityTypes     String   @default("[]") // JSON string array
  guidelines      String   @default("[]") // JSON string array
  lastUpdated     DateTime @default(now())
}

model Finding {
  id           String   @id @default(uuid())
  code         String   @unique
  title        String
  description  String
  category     String   // IDENTITY, DOCUMENTATION, etc.
  severity     String   // LOW, MEDIUM, HIGH, CRITICAL
  applicableTo String   @default("[]") // JSON string array of account types
  active       Boolean  @default(true)
  source       String   @default("manual") // manual, auto
  createdAt    DateTime @default(now())
}