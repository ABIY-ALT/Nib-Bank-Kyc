// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum FindingCategory {
  IDENTITY
  DOCUMENTATION
  COMPLIANCE
  ACCOUNT_VALIDATION
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id                  String     @id @default(uuid())
  email               String     @unique
  password            String
  firstName           String
  lastName            String
  phoneNumber         String?
  status              UserStatus @default(ACTIVE)
  needsPasswordChange Boolean    @default(true)
  
  // Organization
  branch              Branch?    @relation(fields: [branchId], references: [id])
  branchId            String?
  branchName          String?
  districtName        String?
  assignedBranches    String?    // Comma-separated list for Specialists

  // Workflow
  createdCases        KYC[]      @relation("CreatedBy")
  assignedCases       KYC[]      @relation("AssignedTo")
  memos               Memo[]
  roles               UserRole[]
  
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  active      Boolean          @default(true)
  permissions RolePermission[]
  users       UserRole[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id        String           @id @default(uuid())
  slug      String           @unique
  name      String
  group     String
  roles     RolePermission[]
}

model RolePermission {
  role         Role       @relation(fields: [roleId], references: [id])
  roleId       String
  permission   Permission @relation(fields: [permissionId], references: [id])
  permissionId String

  @@id([roleId, permissionId])
}

model UserRole {
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  role      Role     @relation(fields: [roleId], references: [id])
  roleId    String
  createdAt DateTime @default(now())

  @@id([userId, roleId])
}

model District {
  id        String   @id @default(uuid())
  name      String   @unique
  branches  Branch[]
}

model Branch {
  id         String   @id @default(uuid())
  name       String   @unique
  code       String?  @unique
  district   District @relation(fields: [districtId], references: [id])
  districtId String
  users      User[]
  cases      KYC[]
}

model KYC {
  id                String   @id
  customerName      String
  entityType        String?
  status            String   @default("SUBMITTED")
  active            Boolean  @default(true)
  
  // Relations
  createdBy         User     @relation("CreatedBy", fields: [createdById], references: [id])
  createdById       String
  assignedTo        User?    @relation("AssignedTo", fields: [assignedToId], references: [id])
  assignedToId      String?
  branch            Branch   @relation(fields: [branchId], references: [id])
  branchId          String
  branchName        String
  
  // Data
  remarks           String?  @db.Text
  checklistState    Json?    @default("{}")
  commentHistory    Json?    @default("[]")
  isExceptional     Boolean  @default(false)
  exceptionalStatus String   @default("None")
  isResubmitted     Boolean  @default(false)
  amendCycles       Int      @default(0)
  
  memos             Memo[]
  submittedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([branchId])
  @@index([status])
  @@index([createdById])
}

model Memo {
  id           String   @id @default(uuid())
  name         String
  type         String
  fileUrl      String
  kyc          KYC      @relation(fields: [kycId], references: [id])
  kycId        String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  uploadedById String
  createdAt    DateTime @default(now())
}

model Finding {
  id           String          @id @default(uuid())
  code         String          @unique
  title        String
  description  String          @db.Text
  category     FindingCategory
  severity     FindingSeverity
  applicableTo String[]        // Array of entity types
  active       Boolean         @default(true)
  source       String          @default("manual") // manual or ai
}

model GlobalSetting {
  id               String   @id @default("global")
  entityTypes      Json     @default("[]")
  documentTypes    Json     @default("[]")
  guidelines       Json     @default("[]")
  autoEscalation   Boolean  @default(true)
  escalationHours  Int      @default(72)
  lastUpdated      DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  userEmail String
  userName  String?
  action    String
  details   String   @db.Text
  ipAddress String?
  kycId     String?
  timestamp DateTime @default(now())
}
