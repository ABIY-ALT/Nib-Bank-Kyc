generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  password            String
  firstName           String
  lastName            String
  phoneNumber         String?
  status              UserStatus @default(ACTIVE)
  needsPasswordChange Boolean    @default(true)
  
  branchId            String?
  branch              Branch?    @relation(fields: [branchId], references: [id])
  branchName          String?    
  districtName        String?    
  assignedBranches    String?    // Comma separated list for specialist coverage
  
  roles               UserRole[]
  
  createdKYCs         KYC[]      @relation("CreatedBy")
  assignedKYCs        KYC[]      @relation("AssignedTo")
  uploadedMemos       Memo[]
  
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  active      Boolean          @default(true)
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id    String           @id @default(cuid())
  slug  String           @unique
  name  String
  group String
  roles RolePermission[]
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

model KYC {
  id                String   @id // Institutional formatted ID
  customerName      String
  
  branchId          String
  branch            Branch   @relation(fields: [branchId], references: [id])
  branchName        String
  districtName      String
  
  createdById       String
  createdBy         User     @relation("CreatedBy", fields: [createdById], references: [id])
  
  assignedToId      String?
  assignedTo        User?    @relation("AssignedTo", fields: [assignedToId], references: [id])
  
  status            String   
  entityType        String
  remarks           String?
  
  checklistState    Json     @default("{}")
  commentHistory    Json     @default("[]")
  
  isResubmitted     Boolean  @default(false)
  isExceptional     Boolean  @default(false)
  exceptionalStatus String   @default("None")
  amendCycles       Int      @default(0)
  
  memos             Memo[]
  
  active            Boolean  @default(true)
  submittedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Memo {
  id           String   @id @default(cuid())
  name         String
  type         String   
  fileUrl      String
  
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  
  kycId        String
  kyc          KYC      @relation(fields: [kycId], references: [id])
  
  createdAt    DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String
  userName  String?
  action    String
  details   String
  ipAddress String
  kycId     String?
  severity  String   @default("LOW")
  metadata  Json?
  timestamp DateTime @default(now())
}

model FollowUpVerification {
  id           String   @id @default(cuid())
  submissionId String
  customerName String
  branch       String
  officer      String
  accountType  String
  verifiedBy   String?
  verifiedAt   DateTime @default(now())
  result       String?  
  remarks      String?
  status       String   @default("PENDING") 
}

model GlobalSetting {
  id              String   @id @default("global")
  entityTypes     Json     @default("[]")
  documentTypes   Json     @default("[]")
  guidelines      Json     @default("[]")
  autoEscalation  Boolean  @default(true)
  escalationHours Int      @default(72)
  lastUpdated     DateTime @default(now())
}

model District {
  id       String   @id @default(cuid())
  name     String   @unique
  branches Branch[]
}

model Branch {
  id         String   @id @default(cuid())
  name       String   @unique
  code       String   @unique
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  kycs       KYC[]
  users      User[]
}

model Finding {
  id           String   @id @default(cuid())
  code         String   @unique
  title        String
  description  String
  category     String   
  severity     String   
  applicableTo Json     @default("[]")
  active       Boolean  @default(true)
  source       String   @default("manual")
  createdAt    DateTime @default(now())
}
