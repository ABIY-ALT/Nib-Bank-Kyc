// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum KYCStatus {
  SUBMITTED
  IN_REVIEW
  ACTION_REQUIRED
  APPROVED
  ESCALATED
  REJECTED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  BRANCH_TRANSFER
  ROLE_TRANSITION
  LOGIN
  LOGOUT
}

model District {
  id        String   @id @default(cuid())
  name      String   @unique
  branches  Branch[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id         String   @id @default(cuid())
  name       String   @unique
  code       String?  @unique
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  users      User[]
  kycCases   KYC[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model User {
  id               String     @id @default(cuid())
  firebaseUid      String     @unique
  email            String     @unique
  firstName        String
  lastName         String
  phoneNumber      String?
  status           UserStatus @default(ACTIVE)
  passwordHash     String?    // For mock/dev fallback
  
  branchId         String?
  branch           Branch?    @relation(fields: [branchId], references: [id])
  
  assignedBranches String[]   @default([]) // For KYC Specialists covering multiple nodes
  
  roles            UserRole[]
  
  createdKYCs      KYC[]      @relation("CreatedBy")
  assignedKYCs     KYC[]      @relation("AssignedTo")
  
  auditLogs        AuditLog[]
  memos            Memo[]
  
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  active      Boolean          @default(true)
  permissions RolePermission[]
  users       UserRole[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id        String           @id @default(cuid())
  slug      String           @unique
  name      String
  group     String
  roles     RolePermission[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model KYC {
  id               String    @id
  customerName     String
  customerIdNumber String?
  status           KYCStatus @default(SUBMITTED)
  entityType       String?
  
  branchId         String
  branch           Branch    @relation(fields: [branchId], references: [id])
  branchName       String    // Snapshot for history
  districtName     String    // Snapshot for history
  
  createdById      String
  createdBy        User      @relation("CreatedBy", fields: [createdById], references: [id])
  
  assignedToId     String?
  assignedTo       User?     @relation("AssignedTo", fields: [assignedToId], references: [id])
  
  amendCycles      Int       @default(0)
  isResubmitted    Boolean   @default(false)
  isExceptional    Boolean   @default(false)
  active           Boolean   @default(true)
  
  commentHistory   Json?     @default("[]")
  checklistState   Json?     @default("{}")
  
  memos            Memo[]
  auditLogs        AuditLog[]
  
  submittedAt      DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([branchId])
  @@index([status])
  @@index([createdById])
}

model Memo {
  id           String   @id @default(cuid())
  name         String
  type         String
  fileUrl      String
  kycId        String
  kyc          KYC      @relation(fields: [kycId], references: [id])
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  action    AuditAction
  details   String
  metadata  Json?       @default("{}") // Store transition info (old/new branch/role)
  kycId     String?
  kyc       KYC?        @relation(fields: [kycId], references: [id])
  timestamp DateTime    @default(now())
}

model GlobalSetting {
  id              String   @id @default("global")
  autoEscalation  Boolean  @default(true)
  escalationHours Int      @default(72)
  strictSla       Boolean  @default(true)
  slaHours        Int      @default(24)
  documentTypes   Json?    @default("[]")
  entityTypes     Json?    @default("[]")
  guidelines      Json?    @default("[]")
  lastUpdated     DateTime @default(now())
}

model FollowUpVerification {
  id           String   @id @default(cuid())
  submissionId String
  customerName String
  branch       String
  officer      String
  accountType  String
  verifiedBy   String?
  verifiedAt   DateTime?
  result       String?  // "Correct" | "Discrepancy"
  remarks      String?
  status       String   @default("PENDING") // "PENDING" | "COMPLETED"
}

model Finding {
  id           String          @id @default(cuid())
  code         String          @unique
  title        String
  description  String
  category     FindingCategory
  severity     FindingSeverity
  applicableTo String[]        // String array of account types
  active       Boolean         @default(true)
  source       String          @default("manual") // "manual" | "auto"
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

enum FindingCategory {
  IDENTITY
  DOCUMENTATION
  COMPLIANCE
  ACCOUNT_VALIDATION
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
