generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum RoleType {
  SUPER_ADMIN
  BRANCH_OFFICER
  KYC_SPECIALIST
  SENIOR_ASSESSOR
  DISTRICT_DIRECTOR
  BRANCH_BANKING_DIRECTOR
  CHIEF_OFFICER
  DIVISION_MANAGER
  SUPERVISOR
  COMPLIANCE_OFFICER
  AUDITOR
  SLA_MANAGER
}

enum KYCStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ACTION_REQUIRED
  RESUBMITTED
  ESCALATED
  GOVERNANCE_PENDING
  GOVERNANCE_APPROVED
  COMPLIANCE_REVIEW
  ACTIVE
  INACTIVE
  REJECTED
  FROZEN
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AuditAction {
  LOGIN
  CREATE
  UPDATE
  SUBMIT
  APPROVE
  REJECT
  ESCALATE
  FREEZE
  EXPORT
  STATUS_CHANGE
}

enum FindingCategory {
  IDENTITY
  DOCUMENTATION
  COMPLIANCE
  ACCOUNT_VALIDATION
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

//////////////////////////////////////////////////////
// INSTITUTIONAL STRUCTURE
//////////////////////////////////////////////////////

model District {
  id        String   @id @default(uuid())
  name      String   @unique
  branches  Branch[]
  createdAt DateTime @default(now())
}

model Branch {
  id         String   @id @default(uuid())
  name       String
  code       String   @unique
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  users      User[]
  kycs       KYC[]
  createdAt  DateTime @default(now())
}

//////////////////////////////////////////////////////
// USER & RBAC
//////////////////////////////////////////////////////

model User {
  id            String   @id @default(uuid())
  firebaseUid   String   @unique
  email         String   @unique
  firstName     String
  lastName      String
  role          String   // Dynamic string to support custom roles from RoleDefinition
  phoneNumber   String?
  branchId      String?
  branch        Branch?  @relation(fields: [branchId], references: [id])
  status        UserStatus @default(ACTIVE)
  assignedBranches String[] // For specialist portfolios
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  auditLogs     AuditLog[]
  assignedKycs  KYC[]    @relation("AssignedKYC")
  createdKycs   KYC[]    @relation("CreatedKYC")
  memos         Memo[]
}

model RoleDefinition {
  id                   String  @id @default(uuid())
  name                 String  @unique
  canSubmit            Boolean @default(false)
  canReview            Boolean @default(false)
  canEscalate          Boolean @default(false)
  canViewReports       Boolean @default(false)
  canManageUsers       Boolean @default(false)
  canManageSystem      Boolean @default(false)
  canAccessPerformance Boolean @default(false)
  canAccessFollowUp    Boolean @default(false)
  canAccessArchive     Boolean @default(false)
  canManageFindings    Boolean @default(false)
}

//////////////////////////////////////////////////////
// KYC CORE MODEL
//////////////////////////////////////////////////////

model KYC {
  id               String      @id
  customerName     String
  customerIdNumber String
  branchId         String
  branch           Branch      @relation(fields: [branchId], references: [id])

  status           KYCStatus   @default(DRAFT)
  riskLevel        RiskLevel   @default(LOW)
  entityType       String?

  createdById      String
  createdBy        User        @relation("CreatedKYC", fields: [createdById], references: [id])

  assignedToId     String?
  assignedTo       User?       @relation("AssignedKYC", fields: [assignedToId], references: [id])

  governanceFlow   GovernanceFlow?
  amendments       Amendment[]
  memos            Memo[]
  auditLogs        AuditLog[]
  auditSamplings   AuditSampling[]

  slaDueAt         DateTime?
  approvedAt       DateTime?
  amendCycles      Int         @default(0)
  isResubmitted    Boolean     @default(false)
  commentHistory   Json?       @default("[]")
  checklistState   Json?       @default("{}")

  active           Boolean     @default(true) // Zero deletion policy

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

//////////////////////////////////////////////////////
// AMENDMENT CYCLE
//////////////////////////////////////////////////////

model Amendment {
  id          String   @id @default(uuid())
  kycId       String
  kyc         KYC      @relation(fields: [kycId], references: [id])
  requestedBy String
  resolved    Boolean  @default(false)
  comment     String
  createdAt   DateTime @default(now())
}

//////////////////////////////////////////////////////
// GOVERNANCE FLOW (Exceptional Cases)
//////////////////////////////////////////////////////

model GovernanceFlow {
  id              String   @id @default(uuid())
  kycId           String   @unique
  kyc             KYC      @relation(fields: [kycId], references: [id])

  districtApproved         Boolean @default(false)
  branchBankingApproved    Boolean @default(false)
  chiefOfficerApproved     Boolean @default(false)
  divisionManagerApproved  Boolean @default(false)
  supervisorApproved       Boolean @default(false)

  completed       Boolean   @default(false)
  createdAt       DateTime  @default(now())
}

//////////////////////////////////////////////////////
// AUTHORIZATION MEMOS (PDF UPLOADS)
//////////////////////////////////////////////////////

model Memo {
  id           String   @id @default(uuid())
  kycId        String
  kyc          KYC      @relation(fields: [kycId], references: [id])
  name         String?
  type         String?
  fileUrl      String
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

//////////////////////////////////////////////////////
// AUDIT LOG (SECURITY VAULT)
//////////////////////////////////////////////////////

model AuditLog {
  id        String      @id @default(uuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id])
  kycId     String?
  kyc       KYC?        @relation(fields: [kycId], references: [id])
  action    AuditAction
  details   String?
  ipAddress String?
  metadata  Json?
  createdAt DateTime    @default(now())
}

//////////////////////////////////////////////////////
// RANDOM SAMPLING (HEAD OFFICE QC)
//////////////////////////////////////////////////////

model AuditSampling {
  id          String   @id @default(uuid())
  kycId       String
  kyc         KYC      @relation(fields: [kycId], references: [id])
  reviewedBy  String
  discrepancy Boolean  @default(false)
  remarks     String?
  score       Int?
  createdAt   DateTime @default(now())
}

//////////////////////////////////////////////////////
// KYC KNOWLEDGE BASE
//////////////////////////////////////////////////////

model Finding {
  id           String          @id @default(uuid())
  code         String          @unique
  title        String
  description  String
  category     FindingCategory
  severity     FindingSeverity
  applicableTo String[]
  active       Boolean         @default(true)
  source       String          @default("manual")
  createdAt    DateTime        @default(now())
}

//////////////////////////////////////////////////////
// SYSTEM SETTINGS
//////////////////////////////////////////////////////

model GlobalSetting {
  id               String   @id @default("global")
  autoEscalation   Boolean  @default(true)
  escalationHours  Int      @default(72)
  strictSla        Boolean  @default(true)
  slaHours         Int      @default(24)
  documentTypes    Json?    @default("[]")
  entityTypes      Json?    @default("[]")
  guidelines       Json?    @default("[]")
  updatedBy        String?
  lastUpdated      DateTime @default(now())
}

model SLAConfig {
  id             String   @id @default(uuid())
  reviewHours    Int
  escalationHours Int
  createdAt      DateTime @default(now())
}