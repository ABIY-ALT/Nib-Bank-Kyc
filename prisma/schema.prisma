generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum KYCStatus {
  SUBMITTED
  IN_REVIEW
  ACTION_REQUIRED
  APPROVED
  REJECTED
  ESCALATED
}

enum AuditAction {
  CREATE
  STATUS_CHANGE
  LOGIN_SUCCESS
  AUTH_FAILURE
  AUTH_FAILURE_CREDENTIAL
  AUTH_LOCKOUT
  PASSWORD_CHANGE_SUCCESS
  PASSWORD_RESET_ADMIN
  ROLE_MODIFICATION
  ROLE_STATUS_TOGGLE
  PERMISSION_REGISTRY_SYNC
  FILE_UPLOAD_BLOCKED_SIZE
  SECURITY_ALERT_UPLOAD_TYPE
  SECURITY_ALERT_UPLOAD_OBFUSCATION
  SECURITY_ALERT_IDOR
  BUNDLE_DOWNLOAD
  MEMO_DOWNLOAD_AUTHORIZED
  MEMO_DOWNLOAD_DENIED
}

model User {
  id                  String     @id @default(uuid())
  email               String     @unique
  password            String
  firstName           String
  lastName            String
  phoneNumber         String?
  status              UserStatus @default(ACTIVE)
  needsPasswordChange Boolean    @default(true)
  branchId            String?
  branch              Branch?    @relation(fields: [branchId], references: [id])
  assignedBranches    String[]   @default([])
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  roles               UserRole[]
  kycsCreated         KYC[]      @relation("KYCCreatedBy")
  kycsAssigned        KYC[]      @relation("KYCAssignedTo")
  memos               Memo[]
  auditLogs           AuditLog[]
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  active      Boolean          @default(true)
  users       UserRole[]
  permissions RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model Permission {
  id    String           @id @default(uuid())
  slug  String           @unique
  name  String
  group String
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model District {
  id       String   @id @default(uuid())
  name     String   @unique
  branches Branch[]
}

model Branch {
  id         String   @id @default(uuid())
  name       String   @unique
  code       String?  @unique
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  users      User[]
  kycs       KYC[]
}

model KYC {
  id                String      @id
  customerName      String
  status            KYCStatus   @default(SUBMITTED)
  isExceptional     Boolean     @default(false)
  exceptionalStatus String      @default("None")
  commentHistory    Json        @default("[]")
  checklistState    Json        @default("{}")
  isResubmitted     Boolean     @default(false)
  amendCycles       Int         @default(0)
  active            Boolean     @default(true)
  branchId          String
  branch            Branch      @relation(fields: [branchId], references: [id])
  branchName        String
  createdById       String
  createdBy         User        @relation("KYCCreatedBy", fields: [createdById], references: [id])
  assignedToId      String?
  assignedTo        User?       @relation("KYCAssignedTo", fields: [assignedToId], references: [id])
  entityType        String?
  submittedAt       DateTime    @default(now())
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  memos             Memo[]
  auditLogs         AuditLog[]
}

model Memo {
  id           String   @id @default(uuid())
  name         String
  type         String
  fileUrl      String
  kycId        String
  kyc          KYC      @relation(fields: [kycId], references: [id])
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  userEmail String?
  userName  String?
  kycId     String?
  kyc       KYC?     @relation(fields: [kycId], references: [id])
  action    String
  details   String
  ipAddress String?
  metadata  Json?
  timestamp DateTime @default(now())
}

model GlobalSetting {
  id               String   @id @default("global")
  autoEscalation   Boolean  @default(true)
  escalationHours  Int      @default(72)
  strictSla        Boolean  @default(true)
  slaHours         Int      @default(24)
  documentTypes    Json     @default("[]")
  entityTypes      Json     @default("[]")
  guidelines       Json     @default("[]")
  lastUpdated      DateTime @default(now())
  updatedBy        String?
}

model FollowUpVerification {
  id           String    @id @default(uuid())
  submissionId String
  customerName String
  branch       String
  officer      String
  accountType  String
  verifiedBy   String?
  verifiedAt   DateTime?
  result       String?
  remarks      String?
  status       String    @default("PENDING")
}

model Finding {
  id           String          @id @default(uuid())
  code         String          @unique
  title        String
  description  String
  category     FindingCategory
  severity     FindingSeverity
  applicableTo String[]
  active       Boolean         @default(true)
  source       String          @default("manual")
  createdAt    DateTime        @default(now())
}

enum FindingCategory {
  IDENTITY
  DOCUMENTATION
  COMPLIANCE
  ACCOUNT_VALIDATION
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
