generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String      @id @default(cuid())
  email               String      @unique
  password            String
  firstName           String
  lastName            String
  phoneNumber         String?
  status              UserStatus  @default(ACTIVE)
  branchId            String?
  branchName          String?
  districtName        String?
  assignedBranches    String?     @db.Text
  needsPasswordChange Boolean     @default(false)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  
  branch              Branch?     @relation(fields: [branchId], references: [id])
  roles               UserRole[]
  submissionsCreated  KYC[]       @relation("CreatedBy")
  submissionsAssigned KYC[]       @relation("AssignedTo")
  memosUploaded       Memo[]
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id        String           @id @default(cuid())
  slug      String           @unique
  name      String
  group     String
  createdAt DateTime         @default(now())
  
  roles     RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Branch {
  id         String   @id @default(cuid())
  name       String   @unique
  code       String?  @unique
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  users      User[]
  kycs       KYC[]
}

model District {
  id       String   @id @default(cuid())
  name     String   @unique
  branches Branch[]
}

model KYC {
  id                String   @id
  customerName      String
  status            String
  isExceptional     Boolean  @default(false)
  exceptionalStatus String   @default("None")
  entityType        String?
  remarks           String?  @db.Text
  branchId          String
  branchName        String
  districtName      String
  createdById       String
  assignedToId      String?
  isResubmitted     Boolean  @default(false)
  amendCycles       Int      @default(0)
  checklistState    Json?    @default("{}")
  commentHistory    Json?    @default("[]")
  active            Boolean  @default(true)
  submittedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt

  branch     Branch   @relation(fields: [branchId], references: [id])
  createdBy  User     @relation("CreatedBy", fields: [createdById], references: [id])
  assignedTo User?    @relation("AssignedTo", fields: [assignedToId], references: [id])
  memos      Memo[]
}

model Memo {
  id           String   @id @default(cuid())
  name         String
  type         String
  fileUrl      String
  kycId        String
  uploadedById String
  createdAt    DateTime @default(now())

  kyc        KYC  @relation(fields: [kycId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedById], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String
  userName  String?
  action    String
  details   String   @db.Text
  ipAddress String?
  timestamp DateTime @default(now())
  kycId     String?
  metadata  Json?
}

model GlobalSetting {
  id              String   @id @default("global")
  autoEscalation  Boolean  @default(true)
  escalationHours Int      @default(72)
  entityTypes     Json?    @default("[]")
  documentTypes   Json?    @default("[]")
  guidelines      Json?    @default("[]")
  lastUpdated     DateTime @default(now())
}

model FollowUpVerification {
  id           String   @id @default(cuid())
  submissionId String   @unique
  customerName String
  branch       String
  officer      String
  accountType  String
  verifiedBy   String?
  verifiedAt   DateTime @default(now())
  result       String?
  remarks      String?  @db.Text
  status       String   @default("PENDING")
}

model Finding {
  id           String          @id @default(cuid())
  code         String          @unique
  title        String
  description  String          @db.Text
  category     FindingCategory
  severity     FindingSeverity
  applicableTo String[]        
  active       Boolean         @default(true)
  source       String          @default("manual")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum FindingCategory {
  IDENTITY
  DOCUMENTATION
  COMPLIANCE
  ACCOUNT_VALIDATION
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
