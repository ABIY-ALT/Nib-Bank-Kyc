generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum KYCStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ACTION_REQUIRED
  AMENDED
  RESUBMITTED
  ESCALATED
  GOVERNANCE_PENDING
  GOVERNANCE_APPROVED
  COMPLIANCE_REVIEW
  ACTIVE
  INACTIVE
  APPROVED
  REJECTED
  FROZEN
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AuditAction {
  LOGIN
  CREATE
  UPDATE
  SUBMIT
  APPROVE
  REJECT
  ESCALATE
  FREEZE
  EXPORT
  STATUS_CHANGE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum FindingCategory {
  IDENTITY
  DOCUMENTATION
  COMPLIANCE
  ACCOUNT_VALIDATION
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

//////////////////////////////////////////////////////
// INSTITUTIONAL STRUCTURE
//////////////////////////////////////////////////////

model District {
  id        String   @id @default(uuid())
  name      String   @unique
  branches  Branch[]
  createdAt DateTime @default(now())
}

model Branch {
  id         String   @id @default(uuid())
  name       String
  code       String   @unique
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  users      User[]
  kycs       KYC[]
  createdAt  DateTime @default(now())
}

//////////////////////////////////////////////////////
// USER & RBAC
//////////////////////////////////////////////////////

model User {
  id            String   @id @default(uuid())
  firebaseUid   String   @unique
  email         String   @unique
  firstName     String
  lastName      String
  phoneNumber   String?
  role          String   @default("BRANCH_OFFICER")
  branchId      String?
  branch        Branch?  @relation(fields: [branchId], references: [id])
  status        UserStatus @default(ACTIVE)
  
  assignedBranches String[] // Specialist portfolio mapping (Branch Names)
  needsPasswordChange Boolean @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  auditLogs     AuditLog[]
  createdKycs   KYC[]    @relation("CreatedBy")
  assignedKycs  KYC[]    @relation("AssignedTo")
}

model RoleDefinition {
  id                   String  @id @default(uuid())
  name                 String  @unique
  canSubmit            Boolean @default(false)
  canReview            Boolean @default(false)
  canEscalate          Boolean @default(false)
  canViewReports       Boolean @default(false)
  canManageUsers       Boolean @default(false)
  canManageSystem      Boolean @default(false)
  canAccessPerformance Boolean @default(false)
  canAccessFollowUp    Boolean @default(false)
  canAccessArchive     Boolean @default(false)
  createdAt            DateTime @default(now())
}

//////////////////////////////////////////////////////
// KYC CORE MODEL
//////////////////////////////////////////////////////

model KYC {
  id               String      @id
  customerName     String
  customerIdNumber String
  entityType       String?
  branchId         String
  branch           Branch      @relation(fields: [branchId], references: [id])

  status           KYCStatus   @default(DRAFT)
  riskLevel        RiskLevel   @default(LOW)

  createdById      String
  createdBy        User        @relation("CreatedBy", fields: [createdById], references: [id])

  assignedToId     String?
  assignedTo       User?       @relation("AssignedTo", fields: [assignedToId], references: [id])

  governanceFlow   GovernanceFlow?
  amendments       Amendment[]
  memos            Memo[]
  auditLogs        AuditLog[]
  auditSamplings   AuditSampling[]

  commentHistory   Json?       // Array of CommentHistoryEntry
  exceptionalData  Json?       // Governance context
  
  amendCycles      Int         @default(0)
  isResubmitted    Boolean     @default(false)
  
  slaDueAt         DateTime?
  approvedAt       DateTime?

  active           Boolean     @default(true) // Zero deletion policy

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

//////////////////////////////////////////////////////
// AMENDMENT CYCLE
//////////////////////////////////////////////////////

model Amendment {
  id          String   @id @default(uuid())
  kycId       String
  kyc         KYC      @relation(fields: [kycId], references: [id])
  requestedBy String
  resolved    Boolean  @default(false)
  comment     String
  createdAt   DateTime @default(now())
}

//////////////////////////////////////////////////////
// GOVERNANCE FLOW (Exceptional Cases)
//////////////////////////////////////////////////////

model GovernanceFlow {
  id              String   @id @default(uuid())
  kycId           String   @unique
  kyc             KYC      @relation(fields: [kycId], references: [id])

  districtApproved         Boolean @default(false)
  branchBankingApproved    Boolean @default(false)
  chiefOfficerApproved     Boolean @default(false)
  divisionManagerApproved  Boolean @default(false)
  supervisorApproved       Boolean @default(false)

  completed       Boolean   @default(false)
  createdAt       DateTime  @default(now())
}

//////////////////////////////////////////////////////
// AUTHORIZATION MEMOS (PDF UPLOADS)
//////////////////////////////////////////////////////

model Memo {
  id        String   @id @default(uuid())
  name      String?
  type      String?
  kycId     String
  kyc       KYC      @relation(fields: [kycId], references: [id])
  uploadedById String
  fileUrl   String
  createdAt DateTime @default(now())
}

//////////////////////////////////////////////////////
// AUDIT LOG (SECURITY VAULT)
//////////////////////////////////////////////////////

model AuditLog {
  id        String      @id @default(uuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id])
  kycId     String?
  kyc       KYC?        @relation(fields: [kycId], references: [id])
  action    AuditAction
  details   String?
  ipAddress String?
  metadata  Json?
  createdAt DateTime    @default(now())
}

//////////////////////////////////////////////////////
// RANDOM SAMPLING (HEAD OFFICE QC)
//////////////////////////////////////////////////////

model AuditSampling {
  id          String   @id @default(uuid())
  kycId       String
  kyc         KYC      @relation(fields: [kycId], references: [id])
  reviewedBy  String
  discrepancy Boolean  @default(false)
  remarks     String?
  score       Int?
  createdAt   DateTime @default(now())
}

//////////////////////////////////////////////////////
// SLA CONFIGURATION
//////////////////////////////////////////////////////

model SLAConfig {
  id             String   @id @default(uuid())
  reviewHours    Int
  escalationHours Int
  createdAt      DateTime @default(now())
}

//////////////////////////////////////////////////////
// KNOWLEDGE BASE
//////////////////////////////////////////////////////

model Finding {
  id           String          @id @default(uuid())
  code         String          @unique
  title        String
  description  String
  category     FindingCategory
  severity     FindingSeverity
  applicableTo String[]        // List of entity types
  active       Boolean         @default(true)
  source       String          @default("manual")
  createdAt    DateTime        @default(now())
}

model GlobalSetting {
  id              String   @id @default("global")
  autoEscalation  Boolean  @default(true)
  escalationHours Int      @default(72)
  strictSla       Boolean  @default(true)
  slaHours        Int      @default(24)
  documentTypes   Json?    // Array of {id, label}
  entityTypes     Json?    // Array of {id, label}
  guidelines      Json?    // Array of {id, title, description, type}
  updatedBy       String?
  lastUpdated     DateTime @default(now())
}
