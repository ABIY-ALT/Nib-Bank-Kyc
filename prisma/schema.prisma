generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum KYCStatus {
  SUBMITTED
  IN_REVIEW
  ACTION_REQUIRED
  APPROVED
  REJECTED
  ESCALATED
}

enum FindingCategory {
  IDENTITY
  DOCUMENTATION
  COMPLIANCE
  ACCOUNT_VALIDATION
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model District {
  id       String   @id @default(uuid())
  name     String   @unique
  branches Branch[]
}

model Branch {
  id         String   @id @default(uuid())
  name       String   @unique
  code       String?  @unique
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  users      User[]
  kycs       KYC[]
}

model User {
  id                  String     @id @default(uuid())
  email               String     @unique
  password            String
  firstName           String
  lastName            String
  phoneNumber         String?
  status              UserStatus @default(ACTIVE)
  branchId            String?
  branch              Branch?    @relation(fields: [branchId], references: [id])
  assignedBranches    String?    @db.Text
  needsPasswordChange Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  roles               UserRole[]
  kycCreated          KYC[]      @relation("KYCCreator")
  kycAssigned         KYC[]      @relation("KYCAssigned")
  memos               Memo[]
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  active      Boolean          @default(true)
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id    String           @id @default(uuid())
  slug  String           @unique
  name  String
  group String
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model KYC {
  id                String    @id
  customerName      String
  status            String    @default("SUBMITTED")
  entityType        String?
  branchId          String
  branch            Branch    @relation(fields: [branchId], references: [id])
  branchName        String
  createdById       String
  createdBy         User      @relation("KYCCreator", fields: [createdById], references: [id])
  assignedToId      String?
  assignedTo        User?     @relation("KYCAssigned", fields: [assignedToId], references: [id])
  submittedAt       DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  active            Boolean   @default(true)
  isResubmitted     Boolean   @default(false)
  amendCycles       Int       @default(0)
  checklistState    String?   @db.Text
  commentHistory    String?   @db.Text
  isExceptional     Boolean   @default(false)
  exceptionalStatus String    @default("None")
  memos             Memo[]
  auditLogs         AuditLog[]
}

model Memo {
  id           String   @id @default(uuid())
  name         String
  type         String
  fileUrl      String
  kycId        String
  kyc          KYC      @relation(fields: [kycId], references: [id])
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  userEmail String?
  userName  String?
  action    String
  details   String   @db.Text
  ipAddress String?
  timestamp DateTime @default(now())
  kycId     String?
  kyc       KYC?     @relation(fields: [kycId], references: [id])
  metadata  String?  @db.Text
}

model FollowUpVerification {
  id           String   @id @default(uuid())
  submissionId String
  customerName String
  branch       String
  officer      String
  accountType  String
  verifiedBy   String?
  verifiedAt   DateTime @default(now())
  result       String?
  remarks      String?  @db.Text
  status       String   @default("PENDING")
}

model GlobalSetting {
  id              String   @id @default("global")
  autoEscalation  Boolean  @default(true)
  escalationHours Int      @default(72)
  strictSla       Boolean  @default(true)
  slaHours        Int      @default(24)
  documentTypes   Json?
  entityTypes     Json?
  guidelines      Json?
  lastUpdated     DateTime @default(now())
}

model Finding {
  id           String          @id @default(uuid())
  code         String          @unique
  title        String
  description  String          @db.Text
  category     FindingCategory
  severity     FindingSeverity
  applicableTo String[]
  active       Boolean         @default(true)
  source       String          @default("manual")
}
