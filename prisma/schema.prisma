
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum KYCStatus {
  SUBMITTED
  IN_REVIEW
  ACTION_REQUIRED
  APPROVED
  ESCALATED
  REJECTED
}

enum AuditAction {
  CREATE
  STATUS_CHANGE
  BRANCH_TRANSFER
  ROLE_TRANSITION
  LOGIN
  LOGOUT
}

enum FindingCategory {
  IDENTITY
  DOCUMENTATION
  COMPLIANCE
  ACCOUNT_VALIDATION
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id               String     @id @default(cuid())
  firebaseUid      String     @unique
  email            String     @unique
  firstName        String
  lastName         String
  phoneNumber      String?
  status           UserStatus @default(ACTIVE)
  branchId         String?
  branch           Branch?    @relation(fields: [branchId], references: [id])
  assignedBranches String[]   @default([])
  needsPasswordChange Boolean @default(false)
  passwordHash     String?
  
  roles            UserRole[]
  submissions      KYC[]      @relation("CreatedBy")
  assignments      KYC[]      @relation("AssignedTo")
  memos            Memo[]
  auditLogs        AuditLog[] @relation("PerformedBy")

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  active      Boolean          @default(true)
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id    String           @id @default(cuid())
  slug  String           @unique
  name  String
  group String
  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model District {
  id       String   @id @default(cuid())
  name     String   @unique
  branches Branch[]
}

model Branch {
  id         String   @id @default(cuid())
  name       String   @unique
  code       String?  @unique
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  users      User[]
  kycRecords KYC[]
}

model KYC {
  id             String      @id
  customerName   String
  status         KYCStatus   @default(SUBMITTED)
  entityType     String?
  branchId       String
  branchName     String?
  branch         Branch      @relation(fields: [branchId], references: [id])
  createdById    String
  createdBy      User        @relation("CreatedBy", fields: [createdById], references: [id])
  assignedToId   String?
  assignedTo     User?       @relation("AssignedTo", fields: [assignedToId], references: [id])
  
  isExceptional  Boolean     @default(false)
  isResubmitted  Boolean     @default(false)
  amendCycles    Int         @default(0)
  checklistState Json?       @default("{}")
  commentHistory Json?       @default("[]")
  active         Boolean     @default(true)

  memos          Memo[]
  auditLogs      AuditLog[]

  submittedAt    DateTime    @default(now())
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Memo {
  id           String   @id @default(cuid())
  name         String
  type         String
  fileUrl      String
  kycId        String
  kyc          KYC      @relation(fields: [kycId], references: [id])
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String?
  user      User?       @relation("PerformedBy", fields: [userId], references: [id])
  userEmail String?
  userName  String?
  kycId     String?
  kyc       KYC?        @relation(fields: [kycId], references: [id])
  action    String
  details   String
  ipAddress String?
  metadata  Json?       @default("{}")
  timestamp DateTime    @default(now())
}

model FollowUpVerification {
  id           String   @id @default(cuid())
  submissionId String   @unique
  customerName String
  branch       String
  officer      String
  accountType  String
  verifiedBy   String?
  verifiedAt   DateTime?
  result       String?
  remarks      String?
  status       String   @default("PENDING")
}

model Finding {
  id           String          @id @default(cuid())
  code         String          @unique
  title        String
  description  String
  category     FindingCategory
  severity     FindingSeverity
  applicableTo String[]
  active       Boolean         @default(true)
  source       String          @default("manual")
  createdAt    DateTime        @default(now())
}

model GlobalSetting {
  id               String   @id @default("global")
  autoEscalation   Boolean  @default(true)
  escalationHours  Int      @default(72)
  strictSla        Boolean  @default(true)
  slaHours         Int      @default(24)
  documentTypes    Json?    @default("[]")
  entityTypes      Json?    @default("[]")
  guidelines       Json?    @default("[]")
  updatedBy        String?
  lastUpdated      DateTime @default(now())
}
