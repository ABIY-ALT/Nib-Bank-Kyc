// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum KYCStatus {
  SUBMITTED
  IN_REVIEW
  ACTION_REQUIRED
  APPROVED
  REJECTED
  ESCALATED
}

model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  password            String
  firstName           String
  lastName            String
  phoneNumber         String?
  status              UserStatus @default(ACTIVE)
  needsPasswordChange Boolean    @default(true)
  
  // Organizational Mapping
  branchId            String?
  branch              Branch?    @relation(fields: [branchId], references: [id])
  branchName          String?    
  districtName        String?    
  assignedBranches    String?    // Comma-separated list for specialists
  
  // RBAC & Workflow
  roles               UserRole[]
  createdKYC          KYC[]      @relation("CreatedBy")
  assignedKYC         KYC[]      @relation("AssignedTo")
  memos               Memo[]
  
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  active      Boolean          @default(true)
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id        String           @id @default(cuid())
  slug      String           @unique
  name      String
  group     String
  roles     RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model District {
  id        String   @id @default(cuid())
  name      String   @unique
  branches  Branch[]
}

model Branch {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String?  @unique
  districtId  String
  district    District @relation(fields: [districtId], references: [id])
  submissions KYC[]
  users       User[]
}

model KYC {
  id                String   @id
  customerName      String
  status            String   @default("SUBMITTED")
  entityType        String?
  remarks           String?
  
  // Jurisdiction
  branchId          String
  branch            Branch   @relation(fields: [branchId], references: [id])
  branchName        String
  districtName      String
  
  // Logic States
  isResubmitted     Boolean  @default(false)
  isExceptional     Boolean  @default(false)
  exceptionalStatus String   @default("None")
  amendCycles       Int      @default(0)
  active            Boolean  @default(true)
  
  // Data Persistence (Native JSON)
  checklistState    Json?
  commentHistory    Json?
  
  // Relations
  createdById       String
  createdBy         User     @relation("CreatedBy", fields: [createdById], references: [id])
  assignedToId      String?
  assignedTo        User?    @relation("AssignedTo", fields: [assignedToId], references: [id])
  memos             Memo[]
  
  submittedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([branchId])
  @@index([status])
  @@index([createdById])
}

model Memo {
  id           String   @id @default(cuid())
  name         String
  type         String   @default("OTHER")
  fileUrl      String
  
  kycId        String
  kyc          KYC      @relation(fields: [kycId], references: [id], onDelete: Cascade)
  
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  
  createdAt    DateTime @default(now())
}

model GlobalSetting {
  id               String   @id @default("global")
  entityTypes      Json
  documentTypes    Json
  guidelines       Json
  autoEscalation   Boolean  @default(true)
  escalationHours  Int      @default(72)
  lastUpdated      DateTime @default(now())
}

model Finding {
  id           String   @id @default(cuid())
  code         String   @unique
  title        String
  description  String
  category     String
  severity     String
  applicableTo Json?
  active       Boolean  @default(true)
  source       String   @default("manual")
}

model FollowUpVerification {
  id           String   @id @default(cuid())
  submissionId String
  customerName String
  branch       String
  officer      String
  accountType  String
  verifiedBy   String?
  verifiedAt   DateTime @default(now())
  result       String?  // "Correct" | "Discrepancy"
  remarks      String?
  status       String   @default("PENDING")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String
  userName  String?
  action    String
  details   String
  ipAddress String
  timestamp DateTime @default(now())
  kycId     String?
}
