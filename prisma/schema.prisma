
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum FindingCategory {
  IDENTITY
  DOCUMENTATION
  COMPLIANCE
  ACCOUNT_VALIDATION
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model District {
  id        String   @id @default(uuid())
  name      String   @unique
  branches  Branch[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id         String   @id @default(uuid())
  name       String   @unique
  code       String   @unique
  districtId String
  district   District @relation(fields: [districtId], references: id)
  users      User[]
  kycs       KYC[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model User {
  id                  String     @id @default(uuid())
  email               String     @unique
  password            String
  firstName           String
  lastName            String
  phoneNumber         String?
  status              UserStatus @default(ACTIVE)
  needsPasswordChange Boolean    @default(true)
  branchId            String?
  branch              Branch?    @relation(fields: [branchId], references: id)
  assignedBranches    String?    @db.Text
  roles               UserRole[]
  kycCreated          KYC[]      @relation("KYCCreatedBy")
  kycAssigned         KYC[]      @relation("KYCAssignedTo")
  memos               Memo[]
  auditLogs           AuditLog[]
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  active      Boolean          @default(true)
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: id)
  roleId String
  role   Role   @relation(fields: [roleId], references: id)

  @@unique([userId, roleId])
}

model Permission {
  id        String           @id @default(uuid())
  slug      String           @unique
  name      String
  group     String
  roles     RolePermission[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: id)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: id)

  @@unique([roleId, permissionId])
}

model KYC {
  id                String     @id
  customerName      String
  branchId          String
  branch            Branch     @relation(fields: [branchId], references: id)
  branchName        String
  createdById       String
  createdBy         User       @relation("KYCCreatedBy", fields: [createdById], references: id)
  assignedToId      String?
  assignedTo        User?      @relation("KYCAssignedTo", fields: [assignedToId], references: id)
  status            String
  entityType        String?
  remarks           String?    @db.Text
  isResubmitted     Boolean    @default(false)
  isExceptional     Boolean    @default(false)
  exceptionalStatus String     @default("None")
  amendCycles       Int        @default(0)
  checklistState    String?    @db.Text
  commentHistory    String?    @db.Text
  active            Boolean    @default(true)
  memos             Memo[]
  auditLogs         AuditLog[]
  submittedAt       DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model Memo {
  id           String   @id @default(uuid())
  name         String
  type         String
  fileUrl      String
  kycId        String
  kyc          KYC      @relation(fields: [kycId], references: id)
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: id)
  createdAt    DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: id)
  kycId     String?
  kyc       KYC?     @relation(fields: [kycId], references: id)
  action    String
  details   String   @db.Text
  ipAddress String?
  timestamp DateTime @default(now())
  userName  String?
  userEmail String?
  metadata  Json?
}

model FollowUpVerification {
  id           String    @id @default(uuid())
  submissionId String    @unique
  customerName String
  branch       String
  officer      String
  accountType  String
  verifiedBy   String?
  verifiedAt   DateTime?
  result       String?
  remarks      String?   @db.Text
  status       String    @default("PENDING")
}

model Finding {
  id           String          @id @default(uuid())
  code         String          @unique
  title        String
  description  String          @db.Text
  category     FindingCategory
  severity     FindingSeverity
  applicableTo String[]
  active       Boolean         @default(true)
  source       String          @default("manual")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model GlobalSetting {
  id            String   @id @default("global")
  entityTypes   Json?
  documentTypes Json?
  guidelines    Json?
  autoEscalation Boolean @default(true)
  escalationHours Int    @default(72)
  lastUpdated   DateTime @default(now())
}
