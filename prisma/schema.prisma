generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum FindingCategory {
  IDENTITY
  DOCUMENTATION
  COMPLIANCE
  ACCOUNT_VALIDATION
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  password            String
  firstName           String
  lastName            String
  phoneNumber         String?
  status              UserStatus @default(ACTIVE)
  branchId            String?
  branchName          String?
  districtName        String?
  assignedBranches    String?    // Comma separated list for multi-branch specialists
  needsPasswordChange Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  branch              Branch?    @relation(fields: [branchId], references: [id])
  roles               UserRole[]
  createdSubmissions  KYC[]      @relation("CreatedBy")
  assignedSubmissions KYC[]      @relation("AssignedTo")
  memos               Memo[]
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  
  users       UserRole[]
  permissions RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model Permission {
  id    String @id @default(cuid())
  name  String
  slug  String @unique
  group String // Grouping for UI organization
  
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model District {
  id        String   @id @default(cuid())
  name      String   @unique
  branches  Branch[]
}

model Branch {
  id         String   @id @default(cuid())
  name       String   @unique
  code       String?  @unique
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  users      User[]
  kycs       KYC[]
}

model KYC {
  id                String   @id // Format: BRANCH-KYC-RANDOM
  customerName      String
  status            String   // Enum-like string from KYC_STATUS constants
  entityType        String?
  branchId          String?
  branchName        String?
  districtName      String?
  createdById       String
  assignedToId      String?
  submittedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt
  isResubmitted     Boolean  @default(false)
  isExceptional     Boolean  @default(false)
  exceptionalStatus String   @default("None")
  remarks           String?
  checklistState    Json?    // Native JSON for flexibility
  commentHistory    Json?    // Native JSON for history
  amendCycles       Int      @default(0)
  active            Boolean  @default(true)

  createdBy         User?    @relation("CreatedBy", fields: [createdById], references: [id])
  assignedTo        User?    @relation("AssignedTo", fields: [assignedToId], references: [id])
  branch            Branch?  @relation(fields: [branchId], references: [id])
  memos             Memo[]
}

model Memo {
  id           String   @id @default(cuid())
  name         String
  type         String
  fileUrl      String   // Path relative to root, e.g., "uploads/filename"
  createdAt    DateTime @default(now())
  uploadedById String
  kycId        String

  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  kyc          KYC      @relation(fields: [kycId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String
  userName  String?
  action    String
  details   String
  ipAddress String
  timestamp DateTime @default(now())
  kycId     String?
  metadata  Json?
}

model GlobalSetting {
  id              String   @id @default("global")
  entityTypes     Json
  documentTypes   Json
  guidelines      Json
  autoEscalation  Boolean  @default(true)
  escalationHours Int      @default(72)
  lastUpdated     DateTime @default(now())
}

model Finding {
  id           String          @id @default(cuid())
  code         String          @unique
  title        String
  description  String
  category     FindingCategory
  severity     FindingSeverity
  applicableTo String[]        // Array of account types
  active       Boolean         @default(true)
  source       String          @default("manual") // manual or ai
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}
