
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BRANCH_OFFICER
  KYC_OFFICER
  SUPERVISOR
  BRANCH_BANKING_DIRECTOR
  ADMIN
  BRANCH_MANAGER
  DISTRICT_DIRECTOR
  DIVISION_MANAGER
  CHIEF_RETAIL_SME_OFFICER
  FOLLOW_UP_TEAM
  CHIEF
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SubmissionStatus {
  PENDING
  IN_REVIEW
  AMENDED
  APPROVED
  ESCALATED
  REJECTED
}

enum ExceptionalStatus {
  NONE
  AWAITING_DISTRICT
  AWAITING_DIRECTOR
  AWAITING_CHIEF
  AWAITING_DIVISION
  AWAITING_SUPERVISOR
  COMPLETED
  REJECTED
  CLARIFICATION_REQUIRED
}

enum FindingCategory {
  IDENTITY
  DOCUMENTATION
  COMPLIANCE
  ACCOUNT_VALIDATION
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model District {
  id        String   @id @default(cuid())
  name      String   @unique
  branches  Branch[]
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id          String       @id @default(cuid())
  name        String       @unique
  code        String?      @unique
  district    District     @relation(fields: [districtId], references: [id])
  districtId  String
  users       User[]
  submissions Submission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model User {
  id                  String      @id @default(cuid())
  email               String      @unique
  name                String
  phoneNumber         String?
  role                UserRole    @default(BRANCH_OFFICER)
  status              UserStatus  @default(ACTIVE)
  branch              Branch?     @relation(fields: [branchId], references: [id])
  branchId            String?
  district            District?   @relation(fields: [districtId], references: [id])
  districtId          String?
  assignedBranches    String[]    // List of branch names for KYC Officers
  needsPasswordChange Boolean     @default(true)
  submissions         Submission[] @relation("SubmittedBy")
  reviews             Submission[] @relation("ReviewedBy")
  auditLogs           AuditLog[]
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}

model Submission {
  id                String            @id @default(cuid())
  customerName      String
  customerId        String?
  entityType        String
  status            SubmissionStatus  @default(PENDING)
  branch            Branch            @relation(fields: [branchId], references: [id])
  branchId          String
  district          String            // Denormalized for fast regional querying
  submittedBy       User              @relation("SubmittedBy", fields: [submittedById], references: [id])
  submittedById     String
  submittedAt       DateTime          @default(now())
  reviewedBy        User?             @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedById      String?
  reviewedAt        DateTime?
  isResubmitted     Boolean           @default(false)
  resubmittedAt     DateTime?
  amendmentCycles   Int               @default(0)
  remarks           String?           @db.Text
  checklistState    Json?             // Stores { itemId: boolean }
  
  // Exceptional Approval Flow
  isExceptional     Boolean           @default(false)
  exceptionalStatus ExceptionalStatus @default(NONE)
  exceptionalData   Json?             // Stores justification, reason, memo links
  
  documents         Document[]
  comments          Comment[]
  bundleDownloads   BundleDownload[]
  followUpAudits    FollowUpVerification[]
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model Document {
  id           String     @id @default(cuid())
  name         String
  type         String
  url          String
  status       String     @default("Current")
  submission   Submission @relation(fields: [submissionId], references: [id])
  submissionId String
  uploadedAt   DateTime   @default(now())
}

model Comment {
  id           String     @id @default(cuid())
  role         String
  performedBy  String
  comment      String     @db.Text
  action       String
  submission   Submission @relation(fields: [submissionId], references: [id])
  submissionId String
  timestamp    DateTime   @default(now())
}

model RoleDefinition {
  id              String  @id
  name            String  @unique
  canSubmit       Boolean @default(false)
  canReview       Boolean @default(false)
  canEscalate     Boolean @default(false)
  canViewReports  Boolean @default(false)
  canManageUsers  Boolean @default(false)
  canManageSystem Boolean @default(false)
}

model AuditLog {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  userEmail String
  action    String
  details   String?  @db.Text
  ipAddress String?
  timestamp DateTime @default(now())
}

model FollowUpVerification {
  id           String     @id @default(cuid())
  submission   Submission @relation(fields: [submissionId], references: [id])
  submissionId String
  customerName String
  branch       String
  officer      String
  accountType  String
  verifiedBy   String?
  verifiedAt   DateTime?
  result       String?    // "Correct" or "Discrepancy"
  remarks      String?    @db.Text
  status       String     @default("Pending")
  createdAt    DateTime   @default(now())
}

model BundleDownload {
  id             String     @id @default(cuid())
  submission     Submission @relation(fields: [submissionId], references: [id])
  submissionId   String
  performedBy    String
  bundleName     String
  sourceDistrict String
  sourceBranch   String
  timestamp      DateTime   @default(now())
}

model KYCFinding {
  id           String          @id @default(cuid())
  code         String          @unique
  title        String
  description  String          @db.Text
  category     FindingCategory
  severity     Severity
  applicableTo String[]        // Array of entity types
  active       Boolean         @default(true)
  source       String          @default("manual")
  createdAt    DateTime        @default(now())
}
