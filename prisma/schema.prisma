generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum KYCStatus {
  SUBMITTED
  IN_REVIEW
  ACTION_REQUIRED
  APPROVED
  REJECTED
  ESCALATED
}

enum AuditAction {
  CREATE
  STATUS_CHANGE
  AMENDMENT_RESPONSE
  GOVERNANCE_DECISION
  USER_PROVISION
  ROLE_MODIFY
  EXPORT
  LOGIN
}

model District {
  id       String   @id @default(cuid())
  name     String   @unique
  branches Branch[]
}

model Branch {
  id         String   @id @default(cuid())
  name       String   @unique
  code       String?  @unique
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  users      User[]
  submissions KYC[]
}

model User {
  id               String     @id @default(cuid())
  firebaseUid      String     @unique
  email            String     @unique
  passwordHash     String?
  firstName        String
  lastName         String
  phoneNumber      String?
  status           UserStatus @default(ACTIVE)
  needsPasswordChange Boolean @default(false)
  
  branchId         String?
  branch           Branch?    @relation(fields: [branchId], references: [id])
  
  assignedBranches String[]   @default([]) // For KYC Specialists mapping
  
  roles            UserRole[]
  submissions      KYC[]      @relation("CreatedBy")
  assignedCases    KYC[]      @relation("AssignedTo")
  auditLogs        AuditLog[]
  memos            Memo[]
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  active      Boolean          @default(true)
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id    String           @id @default(cuid())
  slug  String           @unique
  name  String
  group String
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model KYC {
  id               String    @id
  customerIdNumber String?
  customerName     String
  status           KYCStatus @default(SUBMITTED)
  entityType       String?
  active           Boolean   @default(true)
  
  isExceptional    Boolean   @default(false)
  exceptionalStatus String?  @default("NONE")
  
  isResubmitted    Boolean   @default(false)
  amendCycles      Int       @default(0)
  
  commentHistory   Json?     @default("[]")
  
  branchId         String
  branch           Branch    @relation(fields: [branchId], references: [id])
  branchName       String?
  
  createdById      String
  createdBy        User      @relation("CreatedBy", fields: [createdById], references: [id])
  
  assignedToId     String?
  assignedTo       User?     @relation("AssignedTo", fields: [assignedToId], references: [id])
  
  submittedAt      DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  
  memos            Memo[]
  auditLogs        AuditLog[]
}

model Memo {
  id           String   @id @default(cuid())
  name         String
  type         String
  fileUrl      String
  kycId        String
  kyc          KYC      @relation(fields: [kycId], references: [id])
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  userEmail String?
  action    AuditAction
  details   String
  ipAddress String?
  metadata  Json?
  kycId     String?
  kyc       KYC?        @relation(fields: [kycId], references: [id])
  timestamp DateTime    @default(now())
}

model GlobalSetting {
  id              String   @id @default("global")
  autoEscalation  Boolean  @default(true)
  escalationHours Int      @default(72)
  strictSla       Boolean  @default(true)
  slaHours        Int      @default(24)
  documentTypes   Json?    @default("[]")
  entityTypes     Json?    @default("[]")
  guidelines      Json?    @default("[]")
  lastUpdated     DateTime @updatedAt
}

model FollowUpVerification {
  id           String   @id @default(cuid())
  submissionId String   @unique
  customerName String
  branch       String
  officer      String
  accountType  String
  verifiedBy   String?
  verifiedAt   DateTime?
  result       String?
  remarks      String?
  status       String   @default("PENDING")
}
