generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  password            String
  firstName           String
  lastName            String
  phoneNumber         String?
  status              UserStatus @default(ACTIVE)
  branchId            String?
  branchName          String?
  districtName        String?
  assignedBranches    String?    // CSV of branch names
  needsPasswordChange Boolean    @default(false)
  roles               UserRole[]
  kycsCreated         KYC[]      @relation("KYCCreator")
  kycsAssigned        KYC[]      @relation("KYCAssignee")
  memos               Memo[]
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([email])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  active      Boolean          @default(true)
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id        String           @id @default(cuid())
  slug      String           @unique
  name      String
  group     String
  roles     RolePermission[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model KYC {
  id                String   @id
  customerName      String
  branchId          String?
  branchName        String
  districtName      String
  createdById       String
  createdBy         User     @relation("KYCCreator", fields: [createdById], references: [id])
  assignedToId      String?
  assignedTo        User?    @relation("KYCAssignee", fields: [assignedToId], references: [id])
  submittedAt       DateTime @default(now())
  status            String   @default("SUBMITTED")
  isExceptional     Boolean  @default(false)
  exceptionalStatus String   @default("None")
  entityType        String
  remarks           String?
  amendCycles       Int      @default(0)
  isResubmitted     Boolean  @default(false)
  checklistState    Json     @default("{}")
  commentHistory    Json     @default("[]")
  memos             Memo[]
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([branchId])
  @@index([status])
  @@index([createdById])
}

model Memo {
  id           String   @id @default(cuid())
  name         String
  type         String
  fileUrl      String
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  kycId        String
  kyc          KYC      @relation(fields: [kycId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model District {
  id        String   @id @default(cuid())
  name      String   @unique
  branches  Branch[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id         String   @id @default(cuid())
  name       String   @unique
  code       String   @unique
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  users      User[]
  kycs       KYC[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model GlobalSetting {
  id              String   @id @default("global")
  entityTypes     Json     @default("[]")
  documentTypes   Json     @default("[]")
  guidelines      Json     @default("[]")
  autoEscalation  Boolean  @default(true)
  escalationHours Int      @default(72)
  lastUpdated     DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String
  userName  String?
  action    String
  timestamp DateTime @default(now())
  ipAddress String?
  details   String
  kycId     String?
  metadata  Json?
  createdAt DateTime @default(now())
}

model FollowUpVerification {
  id           String   @id @default(cuid())
  submissionId String   @unique
  customerName String
  branch       String
  officer      String
  accountType  String
  verifiedBy   String?
  verifiedAt   DateTime @default(now())
  result       String?  // Correct, Discrepancy
  remarks      String?
  status       String   @default("PENDING") // PENDING, COMPLETED
}

model Finding {
  id           String          @id @default(cuid())
  code         String          @unique
  title        String
  description  String
  category     FindingCategory
  severity     FindingSeverity
  applicableTo String[]        @default([])
  active       Boolean         @default(true)
  source       String          @default("manual") // manual, ai
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

enum FindingCategory {
  IDENTITY
  DOCUMENTATION
  COMPLIANCE
  ACCOUNT_VALIDATION
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
