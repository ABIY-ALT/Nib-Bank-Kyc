generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id                  String      @id @default(cuid())
  email               String      @unique
  password            String
  firstName           String
  lastName            String
  phoneNumber         String?
  status              UserStatus  @default(ACTIVE)
  branchId            String?
  branchName          String?
  districtName        String?
  assignedBranches    String?     // Comma-separated list for specialists
  needsPasswordChange Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  branch              Branch?     @relation(fields: [branchId], references: [id])
  roles               UserRole[]
  submissions         KYC[]       @relation("CreatedBy")
  assignments         KYC[]       @relation("AssignedTo")
  memos               Memo[]
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id        String           @id @default(cuid())
  slug      String           @unique
  name      String
  group     String
  roles     RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model District {
  id        String   @id @default(cuid())
  name      String   @unique
  branches  Branch[]
}

model Branch {
  id         String   @id @default(cuid())
  name       String   @unique
  code       String   @unique
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  users      User[]
  kycRecords KYC[]
}

model KYC {
  id                String   @id
  customerName      String
  status            String
  branchId          String
  branchName        String
  districtName      String
  createdById       String
  assignedToId      String?
  entityType        String?
  isExceptional     Boolean  @default(false)
  exceptionalStatus String   @default("None")
  isResubmitted     Boolean  @default(false)
  amendCycles       Int      @default(0)
  remarks           String?
  checklistState    Json?    @default("{}")
  commentHistory    Json?    @default("[]")
  active            Boolean  @default(true)
  submittedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt

  branch            Branch   @relation(fields: [branchId], references: [id])
  createdBy         User     @relation("CreatedBy", fields: [createdById], references: [id])
  assignedTo        User?    @relation("AssignedTo", fields: [assignedToId], references: [id])
  memos             Memo[]

  @@index([branchId])
  @@index([status])
  @@index([createdById])
}

model Memo {
  id           String   @id @default(cuid())
  name         String
  type         String
  fileUrl      String
  kycId        String
  uploadedById String
  createdAt    DateTime @default(now())

  kyc          KYC      @relation(fields: [kycId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String
  userName  String?
  action    String
  details   String
  ipAddress String
  kycId     String?
  timestamp DateTime @default(now())
}

model FollowUpVerification {
  id           String   @id @default(cuid())
  submissionId String   @unique
  customerName String
  branch       String
  officer      String
  accountType  String
  verifiedBy   String?
  verifiedAt   DateTime @default(now())
  result       String?
  remarks      String?
  status       String   @default("PENDING")
}

model Finding {
  id           String   @id @default(cuid())
  code         String   @unique
  title        String
  description  String
  category     String
  severity     String
  applicableTo String[]
  active       Boolean  @default(true)
  source       String   @default("manual")
}

model GlobalSetting {
  id              String   @id @default("global")
  entityTypes     Json
  documentTypes   Json
  guidelines      Json
  autoEscalation  Boolean  @default(true)
  escalationHours Int      @default(72)
  lastUpdated     DateTime @default(now())
}
