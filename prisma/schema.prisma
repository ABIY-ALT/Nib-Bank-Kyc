// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- ENUMS ---

enum UserRole {
  BRANCH_OFFICER
  KYC_OFFICER
  SUPERVISOR
  BRANCH_BANKING_DIRECTOR
  ADMIN
  BRANCH_MANAGER
  DISTRICT_DIRECTOR
  DIVISION_MANAGER
  CHIEF_RETAIL_SME_OFFICER
  FOLLOW_UP_TEAM
  CHIEF
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SubmissionStatus {
  PENDING
  IN_REVIEW
  AMENDED
  APPROVED
  ESCALATED
  REJECTED
}

enum ExceptionalStatus {
  NONE
  AWAITING_DISTRICT
  AWAITING_DIRECTOR
  AWAITING_CHIEF
  AWAITING_DIVISION
  AWAITING_SUPERVISOR
  COMPLETED
  REJECTED
  CLARIFICATION_REQUIRED
}

enum FindingCategory {
  IDENTITY
  DOCUMENTATION
  COMPLIANCE
  ACCOUNT_VALIDATION
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// --- MODELS ---

model District {
  id          String       @id @default(cuid())
  name        String       @unique
  branches    Branch[]
  users       User[]       @relation("UserDistrict")
  submissions Submission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Branch {
  id               String       @id @default(cuid())
  name             String
  code             String       @unique
  district         District     @relation(fields: [districtId], references: [id])
  districtId       String
  users            User[]       @relation("UserBranch")
  assignedOfficers User[]       @relation("KYCAssignments")
  submissions      Submission[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model User {
  id                  String       @id @default(cuid())
  name                String
  email               String       @unique
  phoneNumber         String?
  role                UserRole     @default(BRANCH_OFFICER)
  status              UserStatus   @default(ACTIVE)
  
  // Jurisdictional Mapping
  branch              Branch?      @relation("UserBranch", fields: [branchId], references: [id])
  branchId            String?
  district            District?    @relation("UserDistrict", fields: [districtId], references: [id])
  districtId          String?
  
  // KYC Officer multi-branch portfolio
  assignedBranches    Branch[]     @relation("KYCAssignments")
  
  // Activity Relations
  submissions         Submission[] @relation("SubmittedBy")
  reviewedSubmissions Submission[] @relation("ReviewedBy")
  comments            Comment[]
  auditLogs           AuditLog[]
  verifications       FollowUpVerification[] @relation("VerifiedBy")
  bundleDownloads     BundleDownload[]
  
  needsPasswordChange Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

model Submission {
  id                  String            @id // e.g. BR-KYC-1234
  customerId          String?
  customerName        String
  status              SubmissionStatus  @default(PENDING)
  
  // Institutional Hierarchy
  branch              Branch            @relation(fields: [branchId], references: [id])
  branchId            String
  district            District          @relation(fields: [districtId], references: [id])
  districtId          String
  
  // Ownership & Audit
  submittedBy         User              @relation("SubmittedBy", fields: [submittedByUserId], references: [id])
  submittedByUserId   String
  submittedAt         DateTime          @default(now())
  
  reviewedBy          User?             @relation("ReviewedBy", fields: [reviewedByUserId], references: [id])
  reviewedByUserId    String?
  reviewedAt          DateTime?
  
  // Exceptional Flow
  isExceptional       Boolean           @default(false)
  exceptionalStatus   ExceptionalStatus @default(NONE)
  exceptionalReason   String?
  exceptionalJustification String?
  exceptionalMemoUrl  String?
  exceptionalInitiatedAt DateTime?
  
  // State Tracking
  remarks             String?
  entityType          String            @default("individual")
  amendmentCycles     Int               @default(0)
  isResubmitted       Boolean           @default(false)
  resubmittedAt       DateTime?
  checklistState      Json?             // Stores verification flags
  
  // Sub-collections
  documents           Document[]
  comments            Comment[]
  bundleDownloads     BundleDownload[]
  followUpAudits      FollowUpVerification[]
  
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

model Document {
  id           String     @id @default(cuid())
  name         String
  type         String
  url          String
  status       String     @default("Current")
  submission   Submission @relation(fields: [submissionId], references: [id])
  submissionId String
  uploadedAt   DateTime   @default(now())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Comment {
  id           String     @id @default(cuid())
  role         String
  comment      String
  action       String
  timestamp    DateTime   @default(now())
  
  performedBy  User       @relation(fields: [performedByUserId], references: [id])
  performedByUserId String
  
  submission   Submission @relation(fields: [submissionId], references: [id])
  submissionId String
  
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model RoleDefinition {
  id               String   @id @default(cuid())
  name             String   @unique
  canSubmit        Boolean  @default(false)
  canReview        Boolean  @default(false)
  canEscalate      Boolean  @default(false)
  canViewReports   Boolean  @default(false)
  canManageUsers   Boolean  @default(false)
  canManageSystem  Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model AuditLog {
  id           String   @id @default(cuid())
  userEmail    String
  action       String
  ipAddress    String?
  details      String?
  timestamp    DateTime @default(now())
  
  user         User     @relation(fields: [userId], references: [id])
  userId       String
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model FollowUpVerification {
  id           String     @id @default(cuid())
  result       String?    // "Correct" or "Discrepancy"
  remarks      String?
  status       String     @default("Pending")
  verifiedAt   DateTime?
  
  submission   Submission @relation(fields: [submissionId], references: [id])
  submissionId String
  
  verifiedBy   User?      @relation("VerifiedBy", fields: [verifiedByUserId], references: [id])
  verifiedByUserId String?
  
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model BundleDownload {
  id           String     @id @default(cuid())
  bundleName   String
  sourceDistrict String
  sourceBranch String
  timestamp    DateTime   @default(now())
  
  performedBy  User       @relation(fields: [performedByUserId], references: [id])
  performedByUserId String
  
  submission   Submission @relation(fields: [submissionId], references: [id])
  submissionId String
  
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model KYCFinding {
  id           String          @id @default(cuid())
  code         String          @unique
  title        String
  description  String
  category     FindingCategory
  severity     Severity
  applicableTo String[]        // List of entity types
  active       Boolean         @default(true)
  source       String          @default("manual")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}
