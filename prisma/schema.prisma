
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BRANCH_OFFICER
  KYC_OFFICER
  SUPERVISOR
  BRANCH_BANKING_DIRECTOR
  ADMIN
  BRANCH_MANAGER
  DISTRICT_DIRECTOR
  DIVISION_MANAGER
  CHIEF_RETAIL_SME_OFFICER
  FOLLOW_UP_TEAM
  CHIEF
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SubmissionStatus {
  PENDING
  IN_REVIEW
  AMENDED
  APPROVED
  ESCALATED
  REJECTED
}

enum ExceptionalStatus {
  NONE
  AWAITING_DISTRICT
  AWAITING_DIRECTOR
  AWAITING_CHIEF
  AWAITING_DIVISION
  AWAITING_SUPERVISOR
  COMPLETED
  REJECTED
  CLARIFICATION_REQUIRED
}

enum FindingCategory {
  IDENTITY
  DOCUMENTATION
  COMPLIANCE
  ACCOUNT_VALIDATION
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model District {
  id        String   @id @default(cuid())
  name      String   @unique
  branches  Branch[]
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id          String       @id @default(cuid())
  name        String       @unique
  code        String?      @unique
  district    District     @relation(fields: [districtId], references: [id])
  districtId  String
  users       User[]
  submissions Submission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model User {
  id                  String       @id
  email               String       @unique
  name                String
  phoneNumber         String?
  role                UserRole     @default(BRANCH_OFF_TEAM)
  status              UserStatus   @default(ACTIVE)
  branch              Branch?      @relation(fields: [branchId], references: [id])
  branchId            String?
  district            District?    @relation(fields: [districtId], references: [id])
  districtId          String?
  needsPasswordChange Boolean      @default(true)
  submissions         Submission[] @relation("SubmittedBy")
  reviews             Submission[] @relation("ReviewedBy")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

model Submission {
  id                String            @id
  customerName      String
  customerId        String?
  entityType        String
  status            SubmissionStatus  @default(PENDING)
  branch            Branch            @relation(fields: [branchId], references: [id])
  branchId          String
  submittedBy       User              @relation("SubmittedBy", fields: [submittedById], references: [id])
  submittedById     String
  submittedAt       DateTime          @default(now())
  reviewedBy        User?             @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedById      String?
  reviewedAt        DateTime?
  isResubmitted     Boolean           @default(false)
  resubmittedAt     DateTime?
  amendmentCycles   Int               @default(0)
  isExceptional     Boolean           @default(false)
  exceptionalStatus ExceptionalStatus @default(NONE)
  checklistState    Json?
  remarks           String?
  documents         Document[]
  comments          Comment[]
  updatedAt         DateTime          @updatedAt
}

model Document {
  id           String     @id @default(cuid())
  name         String
  type         String
  url          String
  status       String     @default("Current")
  uploadedAt   DateTime   @default(now())
  submission   Submission @relation(fields: [submissionId], references: [id])
  submissionId String
}

model Comment {
  id           String     @id @default(cuid())
  comment      String
  action       String
  role         String
  performedBy  String
  timestamp    DateTime   @default(now())
  submission   Submission @relation(fields: [submissionId], references: [id])
  submissionId String
}

model RoleDefinition {
  id               String  @id
  name             String  @unique
  canSubmit        Boolean @default(false)
  canReview        Boolean @default(false)
  canEscalate      Boolean @default(false)
  canViewReports   Boolean @default(false)
  canManageUsers   Boolean @default(false)
  canManageSystem  Boolean @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  userEmail   String
  action      String
  timestamp   DateTime @default(now())
  ipAddress   String?
  details     String?
}

model FollowUpVerification {
  id           String   @id @default(cuid())
  submissionId String
  customerName String
  branch       String
  officer      String
  accountType  String
  verifiedBy   String?
  verifiedAt   DateTime?
  result       String?
  remarks      String?
  status       String   @default("PENDING")
}

model BundleDownload {
  id             String   @id @default(cuid())
  performedBy    String
  timestamp      DateTime @default(now())
  bundleName     String
  sourceDistrict String
  sourceBranch   String
}

model KYCFinding {
  id          String          @id @default(cuid())
  code        String          @unique
  title       String
  description String
  category    FindingCategory
  severity    Severity
  applicableTo String[]
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
}
