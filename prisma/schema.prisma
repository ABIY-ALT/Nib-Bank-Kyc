generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BRANCH_OFFICER
  KYC_OFFICER
  SUPERVISOR
  BRANCH_BANKING_DIRECTOR
  ADMIN
  BRANCH_MANAGER
  DISTRICT_DIRECTOR
  DIVISION_MANAGER
  CHIEF_RETAIL_SME_OFFICER
  FOLLOW_UP_TEAM
  CHIEF
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SubmissionStatus {
  PENDING
  IN_REVIEW
  AMENDED
  APPROVED
  ESCALATED
  REJECTED
}

enum ExceptionalStatus {
  NONE
  AWAITING_DISTRICT
  AWAITING_DIRECTOR
  AWAITING_CHIEF
  AWAITING_DIVISION
  AWAITING_SUPERVISOR
  COMPLETED
  REJECTED
  CLARIFICATION_REQUIRED
}

enum FindingCategory {
  IDENTITY
  DOCUMENTATION
  COMPLIANCE
  ACCOUNT_VALIDATION
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model District {
  id        String   @id @default(cuid())
  name      String   @unique
  branches  Branch[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id          String       @id @default(cuid())
  name        String       @unique
  code        String?      @unique
  district    District     @relation(fields: [districtId], references: [id])
  districtId  String
  users       User[]
  submissions Submission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model User {
  id               String     @id @default(cuid())
  email            String     @unique
  name             String
  phoneNumber      String?
  role             UserRole   @default(BRANCH_OFFICER)
  status           UserStatus @default(ACTIVE)
  branch           Branch?    @relation(fields: [branchId], references: [id])
  branchId         String?
  assignedBranches String[]
  districtName     String?
  needsPasswordChange Boolean @default(true)
  
  submissions      Submission[] @relation("SubmittedBy")
  reviews          Submission[] @relation("ReviewedBy")
  comments         Comment[]
  auditLogs        AuditLog[]
  
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model Submission {
  id                String            @id
  customerName      String
  customerId        String?
  entityType        String
  status            SubmissionStatus  @default(PENDING)
  branch            Branch            @relation(fields: [branchId], references: [id])
  branchId          String
  district          String
  
  submittedBy       User              @relation("SubmittedBy", fields: [submittedByUserId], references: [id])
  submittedByUserId String
  submittedAt       DateTime          @default(now())
  
  reviewedBy        User?             @relation("ReviewedBy", fields: [reviewedByUserId], references: [id])
  reviewedByUserId  String?
  reviewedAt        DateTime?
  
  isExceptional     Boolean           @default(false)
  exceptionalStatus ExceptionalStatus @default(NONE)
  exceptionalData   Json?
  
  isResubmitted     Boolean           @default(false)
  resubmittedAt     DateTime?
  amendmentCycles   Int               @default(0)
  checklistState    Json?
  remarks           String?
  
  documents         Document[]
  comments          Comment[]
  downloads         BundleDownload[]
  
  updatedAt         DateTime          @updatedAt
}

model Document {
  id           String     @id @default(cuid())
  name         String
  type         String
  url          String
  status       String     @default("Current")
  submission   Submission @relation(fields: [submissionId], references: [id])
  submissionId String
  uploadedAt   DateTime   @default(now())
}

model Comment {
  id           String     @id @default(cuid())
  comment      String
  action       String
  role         String
  user         User       @relation(fields: [userId], references: [id])
  userId       String
  submission   Submission @relation(fields: [submissionId], references: [id])
  submissionId String
  timestamp    DateTime   @default(now())
}

model RoleDefinition {
  id          String   @id
  name        String   @unique
  permissions Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  userEmail String
  action    String
  details   String?
  ipAddress String?
  timestamp DateTime @default(now())
}

model FollowUpVerification {
  id           String   @id @default(cuid())
  submissionId String
  customerName String
  branch       String
  officer      String
  accountType  String
  verifiedBy   String?
  verifiedAt   DateTime?
  result       String?
  remarks      String?
  status       String   @default("PENDING")
}

model BundleDownload {
  id             String     @id @default(cuid())
  performedBy    String
  bundleName     String
  sourceDistrict String
  sourceBranch   String
  submission     Submission @relation(fields: [submissionId], references: [id])
  submissionId   String
  timestamp      DateTime   @default(now())
}

model KYCFinding {
  id           String          @id @default(cuid())
  code         String          @unique
  title        String
  description  String
  category     FindingCategory
  severity     Severity
  applicableTo String[]
  active       Boolean         @default(true)
  source       String          @default("manual")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}