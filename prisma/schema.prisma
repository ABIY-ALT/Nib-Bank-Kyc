generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model District {
  id        String   @id @default(uuid())
  name      String   @unique
  branches  Branch[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id         String   @id @default(uuid())
  name       String   @unique
  code       String   @unique
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  users      User[]
  kycs       KYC[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model User {
  id                  String     @id @default(uuid())
  email               String     @unique
  password            String
  firstName           String
  lastName            String
  phoneNumber         String?
  status              UserStatus @default(ACTIVE)
  branchId            String?
  branch              Branch?    @relation(fields: [branchId], references: [id])
  assignedBranches    String?    // Comma-separated branch names for specialists
  needsPasswordChange Boolean    @default(true)
  roles               UserRole[]
  createdKycs         KYC[]      @relation("CreatedBy")
  assignedKycs        KYC[]      @relation("AssignedTo")
  uploadedMemos       Memo[]
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  active      Boolean          @default(true)
  permissions RolePermission[]
  users       UserRole[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id        String           @id @default(uuid())
  slug      String           @unique
  name      String
  group     String
  roles     RolePermission[]
  createdAt DateTime         @default(now())
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model KYC {
  id                String   @id // Formatted: BRANCH-KYC-RANDOM
  customerName      String
  entityType        String
  status            String   // From KYC_STATUS constant
  branchId          String
  branch            Branch   @relation(fields: [branchId], references: [id])
  branchName        String
  createdById       String
  createdBy         User     @relation("CreatedBy", fields: [createdById], references: [id])
  assignedToId      String?
  assignedTo        User?    @relation("AssignedTo", fields: [assignedToId], references: [id])
  isExceptional     Boolean  @default(false)
  exceptionalStatus String   @default("None")
  remarks           String?  @db.Text
  checklistState    String?  @db.Text // JSON string
  commentHistory    String?  @db.Text // JSON string
  isResubmitted     Boolean  @default(false)
  amendCycles       Int      @default(0)
  active            Boolean  @default(true)
  submittedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt
  memos             Memo[]
}

model Memo {
  id           String   @id @default(uuid())
  name         String
  type         String
  fileUrl      String
  kycId        String
  kyc          KYC      @relation(fields: [kycId], references: [id])
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

model GlobalSetting {
  id               String   @id @default("global")
  entityTypes      Json     // Array of {id, label}
  documentTypes    Json     // Array of {id, label}
  guidelines       Json     // Array of guidelines
  autoEscalation   Boolean  @default(true)
  escalationHours  Int      @default(72)
  lastUpdated      DateTime @updatedAt
  lastUpdatedBy    String?
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  userEmail String
  userName  String?
  action    String
  details   String   @db.Text
  kycId     String?
  ipAddress String?
  timestamp DateTime @default(now())
  metadata  Json?
}

model FollowUpVerification {
  id           String   @id @default(uuid())
  submissionId String
  customerName String
  branch       String
  officer      String
  accountType  String
  verifiedBy   String?
  verifiedAt   DateTime @default(now())
  result       String?  // 'Correct' | 'Discrepancy'
  remarks      String?  @db.Text
  status       String   @default("PENDING") // 'PENDING' | 'COMPLETED'
}
